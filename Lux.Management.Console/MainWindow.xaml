<Window x:Class="Lux.Management.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:Lux.Management.Console"
        xmlns:coreViews="clr-namespace:Lux.Management.Console.Core.Views"
        xmlns:connections="clr-namespace:Lux.Management.Console.Modules.MikroTik.Connections.Dialog"
        mc:Ignorable="d"
        Title="Alpha Manager" MinHeight="650" MinWidth="1024"
        Height="768" Width="1200" SizeToContent="Manual"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}"
        FlowDirection="RightToLeft"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Custom converter for automatic selection mapping -->
        <local:TypeToBooleanConverter x:Key="TypeToBooleanConverter"/>

        <!-- SVG Path Geometries (Fluent / Azure portal style, verified safe and spaced) -->
        <Geometry x:Key="HomeIcon">M 12 5.69 L 17 10.19 V 18 H 15 V 12 H 9 V 18 H 7 V 10.19 L 12 5.69 M 12 3 L 2 12 H 5 V 20 H 11 V 14 H 13 V 20 H 19 V 12 H 22 L 12 3 Z</Geometry>
        <Geometry x:Key="MikroTikIcon">M 19 15 C 19 16.1 18.1 17 17 17 H 7 C 5.9 17 5 16.1 5 15 V 9 C 5 7.9 5.9 7 7 7 H 17 C 18.1 7 19 7.9 19 9 V 15 Z M 7 9 V 15 H 17 V 9 H 7 Z M 9.5 13.5 C 8.67 13.5 8 12.83 8 12 C 8 11.17 8.67 10.5 9.5 10.5 C 10.33 10.5 11 11.17 11 12 C 11 12.83 10.33 13.5 9.5 13.5 Z M 14.5 13.5 C 13.67 13.5 13 12.83 13 12 C 13 11.17 13.67 10.5 14.5 10.5 C 15.33 10.5 16 11.17 16 12 C 16 12.83 15.33 13.5 14.5 13.5 Z</Geometry>
        <Geometry x:Key="ModemIcon">M 19 3 H 5 C 3.9 3 3 3.9 3 5 V 19 C 3 20.1 3.9 21 5 21 H 19 C 20.1 21 21 20.1 21 19 V 5 C 21 3.9 20.1 3 19 3 Z M 18 9 H 6 V 5 H 18 V 9 Z M 18 15 H 6 V 11 H 18 V 15 Z M 18 19 H 6 V 17 H 18 V 19 Z</Geometry>
        <Geometry x:Key="WirelessIcon">M 19 3 H 21 V 21 H 19 V 3 Z M 14 7 H 16 V 21 H 14 V 7 Z M 9 11 H 11 V 21 H 9 V 11 Z M 4 15 H 6 V 21 H 4 V 15 Z</Geometry>
        <Geometry x:Key="MonitoringIcon">M 19 3 H 5 C 3.9 3 3 3.9 3 5 V 19 C 3 20.1 3.9 21 5 21 H 19 C 20.1 21 21 20.1 21 19 V 5 C 21 3.9 20.1 3 19 3 Z M 9 17 H 7 V 10 H 9 V 17 Z M 13 17 H 11 V 7 H 13 V 17 Z M 17 17 H 15 V 13 H 17 V 17 Z</Geometry>
        <Geometry x:Key="OperationsIcon">M 22.7 19 L 13.6 9.9 C 14.5 7.6 14 4.9 12.1 3 C 10.1 1 7.1 0.6 4.7 1.7 L 9 6 L 6 9 L 1.7 4.7 C 0.6 7.1 1 10.1 3 12.1 C 4.9 14 7.6 14.5 9.9 13.6 L 19 22.7 C 19.4 23.1 20 23.1 20.4 22.7 L 22.7 20.4 C 23.1 20 23.1 19.4 22.7 19 Z</Geometry>
        <Geometry x:Key="SettingsIcon">M 19.14 12.94 C 19.18 12.64 19.2 12.33 19.2 12 C 19.2 11.68 19.18 11.36 19.13 11.06 L 21.16 9.48 C 21.34 9.34 21.39 9.07 21.28 8.87 L 19.36 5.55 C 19.24 5.33 18.99 5.26 18.77 5.33 L 16.38 6.29 C 15.88 5.91 15.35 5.59 14.76 5.35 L 14.4 2.81 C 14.36 2.57 14.16 2.4 13.92 2.4 H 10.08 C 9.84 2.4 9.64 2.57 9.6 2.81 L 9.24 5.35 C 8.65 5.59 8.12 5.91 7.62 6.29 L 5.23 5.33 C 5.01 5.25 4.76 5.33 4.64 5.55 L 2.72 8.87 C 2.61 9.08 2.66 9.34 2.84 9.48 L 4.87 11.06 C 4.82 11.36 4.78 11.69 4.78 12 C 4.78 12.31 4.8 12.64 4.85 12.94 L 2.82 14.52 C 2.64 14.66 2.59 14.93 2.7 15.13 L 4.62 18.45 C 4.74 18.67 4.99 18.74 5.21 18.67 L 7.6 17.71 C 8.1 18.09 8.63 18.41 9.22 18.65 L 9.58 21.19 C 9.63 21.43 9.83 21.6 10.07 21.6 H 13.91 C 14.15 21.6 14.35 21.43 14.39 21.19 L 14.75 18.65 C 15.34 18.41 15.87 18.09 16.37 17.71 L 18.76 18.67 C 18.98 18.75 19.23 18.67 19.35 18.45 L 21.27 15.13 C 21.38 14.92 21.33 14.66 21.15 14.52 L 19.14 12.94 Z M 12 15.6 C 10.02 15.6 8.4 13.98 8.4 12 C 8.4 10.02 10.02 8.4 12 8.4 C 13.98 8.4 15.6 10.02 15.6 12 C 15.6 13.98 13.98 15.6 12 15.6 Z</Geometry>
        <Geometry x:Key="LicenseIcon">M18,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V4A2,2 0 0,0 18,2M6,4H11V12L8.5,10.5L6,12V4M18,20H6V18H18V20M18,16H6V14H18V16M18,12H13V10H18V12M18,8H13V6H18V8Z</Geometry>
        <Geometry x:Key="UpdatesIcon">M21,10.12H14.22L16.96,7.38C15.8,6.22 14.18,5.5 12,5.5A7.5,7.5 0 0,0 4.5,13A7.5,7.5 0 0,0 12,20.5C14.73,20.5 17.2,19 18.46,16.7L20.67,17.78C19,20.8 15.75,22.5 12,22.5A9.5,9.5 0 0,1 2.5,13A9.5,9.5 0 0,1 12,3.5C14.88,3.5 17.2,4.62 19.08,6.5L21,4.62V10.12M11,7V13L16.2,16.1L17,14.8L12.5,12.1V7H11Z</Geometry>
        <Geometry x:Key="BackupIcon">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6V11H7V13H12V18L17,13L12,6Z</Geometry>
        <Geometry x:Key="AboutIcon">M11,9H13V7H11V9M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z</Geometry>
        <Geometry x:Key="MenuIcon">M 3 18 H 21 V 16 H 3 V 18 Z M 3 13 H 21 V 11 H 3 V 13 Z M 3 6 V 8 H 21 V 6 H 3 Z</Geometry>

        <Style x:Key="NavigationRailButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="ToolTipService.Placement" Value="Left"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" ClipToBounds="False">
                            <!-- Active Indicator: Independent 3px bar on the physical right (RTL Left) edge -->
                            <Border x:Name="ActiveIndicator" 
                                    Width="3" 
                                    Height="24"
                                    HorizontalAlignment="Left" 
                                    Background="{DynamicResource PrimaryBrush}" 
                                    Visibility="Collapsed" 
                                    CornerRadius="3,0,0,3"/>
                            
                            <!-- Main Item Border (Margin=8,0 to leave spacing for indicator on edges) -->
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="8,0" ClipToBounds="False">
                                <Grid ClipToBounds="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- SVG Path Icon -->
                                    <Path x:Name="icon" 
                                          Grid.Column="0"
                                          Data="{Binding (local:NavigationItemProperties.IconData), RelativeSource={RelativeSource TemplatedParent}}"
                                          Fill="{TemplateBinding Foreground}"
                                          Stretch="Uniform"
                                          Width="20" Height="20"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          ClipToBounds="False"/>
                                               
                                    <!-- Text Label -->
                                    <TextBlock x:Name="txt" 
                                               Grid.Column="1"
                                               Text="{TemplateBinding Content}" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Left"
                                               Margin="8,0"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource PrimaryColor}" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="local:NavigationItemProperties.IsActive" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource PrimaryColor}" Opacity="0.12"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                <!-- Drop Shadow Effect on the active item border container -->
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.12" Color="{DynamicResource PrimaryColor}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- Handle Collapsed Mode -->
                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                <Setter TargetName="txt" Property="Visibility" Value="Collapsed"/>
                                <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                <Setter Property="ToolTip" Value="{x:Null}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="16,24,16,8"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar column (Auto sized based on Border width) -->
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" ClipToBounds="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="64"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="250" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="64" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid ClipToBounds="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Separator -->
                    <RowDefinition Height="*"/> <!-- Nav Hubs -->
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <!-- Right (RTL Left equivalent) Toggle Button -->
                        <ColumnDefinition Width="64"/>
                        <!-- Expanded Branding -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Command="{Binding ToggleSidebarCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource PrimaryTextBrush}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="8" Margin="8,4">
                                                <Path Data="{StaticResource MenuIcon}" Fill="{TemplateBinding Foreground}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <Image Source="pack://application:,,,/Resources/img/logo2.png" 
                               Width="28" Height="28" 
                               Stretch="Uniform" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0" 
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Alpha Manager" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="16,0"/>

                <!-- Navigation Hubs (ClipToBounds=False prevents active indicator & shadow cutting) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="False">
                    <StackPanel Margin="0,12" ClipToBounds="False">
                        <Button Content="الرئيسية" 
                                Style="{StaticResource NavigationRailButtonStyle}" 
                                Command="{Binding NavigateHomeCommand}" 
                                local:NavigationItemProperties.IconData="{StaticResource HomeIcon}"
                                local:NavigationItemProperties.IsActive="{Binding ShellState.CurrentViewModel, Converter={StaticResource TypeToBooleanConverter}, ConverterParameter=DashboardViewModel}"/>
                        
                        <TextBlock Text="مراكز العمليات" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                        <Button Content="المايكروتيك" 
                                Style="{StaticResource NavigationRailButtonStyle}" 
                                Command="{Binding NavigateMikroTikCenterCommand}" 
                                local:NavigationItemProperties.IconData="{StaticResource MikroTikIcon}"
                                local:NavigationItemProperties.IsActive="{Binding ShellState.CurrentViewModel, Converter={StaticResource TypeToBooleanConverter}, ConverterParameter=MikroTikCenterViewModel}"/>
                        
                        <Button Content="أجهزة البث" 
                                Style="{StaticResource NavigationRailButtonStyle}" 
                                Command="{Binding NavigateBroadcastingCenterCommand}" 
                                local:NavigationItemProperties.IconData="{StaticResource WirelessIcon}"
                                local:NavigationItemProperties.IsActive="{Binding ShellState.CurrentViewModel, Converter={StaticResource TypeToBooleanConverter}, ConverterParameter=BroadcastingCenterViewModel}"/>
                        

                        <TextBlock Text="الإدارة" Style="{StaticResource SidebarSectionHeaderStyle}"/>
                        <Button Content="الإعدادات" 
                                Style="{StaticResource NavigationRailButtonStyle}" 
                                Command="{Binding NavigateSettingsCommand}" 
                                local:NavigationItemProperties.IconData="{StaticResource SettingsIcon}"
                                local:NavigationItemProperties.IsActive="{Binding ShellState.CurrentViewModel, Converter={StaticResource TypeToBooleanConverter}, ConverterParameter=SettingsViewModel}"/>
                        
                        <Button Content="الترخيص" 
                                Style="{StaticResource NavigationRailButtonStyle}" 
                                Command="{Binding NavigateLicenseCommand}" 
                                local:NavigationItemProperties.IconData="{StaticResource LicenseIcon}"
                                local:NavigationItemProperties.IsActive="{Binding ShellState.CurrentViewModel, Converter={StaticResource TypeToBooleanConverter}, ConverterParameter=LicenseViewModel}"/>

                        <Button Content="التحديثات" 
                                Style="{StaticResource NavigationRailButtonStyle}" 
                                Command="{Binding NavigateUpdatesCommand}" 
                                local:NavigationItemProperties.IconData="{StaticResource UpdatesIcon}"
                                local:NavigationItemProperties.IsActive="{Binding ShellState.CurrentViewModel, Converter={StaticResource TypeToBooleanConverter}, ConverterParameter=UpdatesViewModel}"/>

                        <Button Content="النسخ الاحتياطي" 
                                Style="{StaticResource NavigationRailButtonStyle}" 
                                Command="{Binding NavigateBackupCommand}" 
                                local:NavigationItemProperties.IconData="{StaticResource BackupIcon}"
                                local:NavigationItemProperties.IsActive="{Binding ShellState.CurrentViewModel, Converter={StaticResource TypeToBooleanConverter}, ConverterParameter=BackupsViewModel}"/>

                        <Button Content="حول البرنامج" 
                                Style="{StaticResource NavigationRailButtonStyle}" 
                                Command="{Binding NavigateAboutCommand}" 
                                local:NavigationItemProperties.IconData="{StaticResource AboutIcon}"
                                local:NavigationItemProperties.IsActive="{Binding ShellState.CurrentViewModel, Converter={StaticResource TypeToBooleanConverter}, ConverterParameter=AboutViewModel}"/>

                        <!-- License Status Indicator -->
                        <Border x:Name="SidebarLicenseStatus" CornerRadius="8" Padding="8,6" Margin="8,16,8,8" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="● Free Edition"/>
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShellState.IsRegistered}" Value="True">
                                                <Setter Property="Text" Value="✓ مرخص"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <!-- Right Section (Actions & User info - Align Right in physical space / layout start in RTL, so HorizontalAlignment="Left") -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- 1. Quick Actions Button (Dropdown) -->
                        <Button x:Name="QuickActionsBtn"
                                Content="الإجراءات السريعة ⚡" 
                                Style="{StaticResource OutlineButtonStyle}" 
                                Padding="12,6" 
                                Margin="0,0,16,0"
                                Cursor="Hand"
                                Click="QuickActionsBtn_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                     <MenuItem Header="🎫 طباعة كروت المايكروتيك (دفعة كروت)" Command="{Binding NavigateMikroTikCenterCommand}" />
                                     <MenuItem Header="📡 إدارة أجهزة البث" Command="{Binding NavigateBroadcastingCenterCommand}" />
                                    <MenuItem Header="🔑 الترخيص والتفعيل" Command="{Binding NavigateLicenseCommand}" />
                                    <MenuItem Header="💾 النسخ الاحتياطي" Command="{Binding NavigateBackupCommand}" />
                                    <MenuItem Header="⚙️ إعدادات البرنامج" Command="{Binding NavigateSettingsCommand}" />
                                    <Separator/>
                                    <MenuItem Header="🔄 تحديث البيانات" Command="{Binding ActiveRouterStatus.RefreshCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Border Width="1" Height="24" Background="{DynamicResource BorderBrush}" Margin="0,0,16,0" Opacity="0.5"/>

                        <!-- 2. User Account (admin) -->
                        <Button x:Name="UserAccountBtn" Style="{x:Null}" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="UserAccountBtn_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                    <TextBlock Text="A" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="admin" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text=" ▾" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="الملف الشخصي" IsEnabled="False"/>
                                    <MenuItem Header="الإعدادات" Command="{Binding NavigateSettingsCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="تسجيل الخروج" IsEnabled="False" Foreground="{DynamicResource DangerBrush}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <!-- Left Section (Router Info, License, Notifications - Align Left in physical space / layout end in RTL, so HorizontalAlignment="Right") -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                        <!-- 2. Connected Router Info Card -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,4" Margin="0,0,16,0" VerticalAlignment="Center" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ShowConnectionDialogCommand}"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <!-- Router Name -->
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Emlak1100"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveRouterStatus.State}" Value="Connected">
                                                        <Setter Property="Text" Value="{Binding ActiveRouterStatus.ActiveRouterName, FallbackValue='Emlak1100'}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                    <!-- IP & Status -->
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <TextBlock FontSize="9.5" Foreground="{DynamicResource MutedTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="10.0.0.1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveRouterStatus.State}" Value="Connected">
                                                            <Setter Property="Text" Value="{Binding ActiveRouterStatus.Host, FallbackValue='10.0.0.1'}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text=" • " FontSize="9.5" Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBlock FontSize="9.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="غير متصل"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveRouterStatus.State}" Value="Connected">
                                                            <Setter Property="Text" Value="متصل"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Status indicator dot -->
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveRouterStatus.State}" Value="Connected">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>
                        </Border>

                        <Border Width="1" Height="24" Background="{DynamicResource BorderBrush}" Margin="0,0,16,0" Opacity="0.5"/>

                        <!-- 3. License Status (Blinking Free Text or Static Licensed) -->
                        <Grid Margin="0,0,16,0" VerticalAlignment="Center">
                            <!-- Free State -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShellState.IsRegistered}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="#F1C40F">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1.0" To="0.2" Duration="0:0:0.8"
                                                                     AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="free" Foreground="#F1C40F" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Licensed State -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShellState.IsRegistered}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="مرخص" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Width="1" Height="24" Background="{DynamicResource BorderBrush}" Margin="0,0,16,0" Opacity="0.5"/>

                        <!-- 4. Notifications Center (Bell Icon) -->
                        <ToggleButton x:Name="NotificationBellBtn"
                                      Style="{x:Null}"
                                      Width="40" Height="40"
                                      Margin="0,0,4,0"
                                      Cursor="Hand"
                                      Background="Transparent"
                                      BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Path Data="M12,22A2,2 0 0,0 14,20H10A2,2 0 0,0 12,22M18,16V11C18,7.93 16.36,5.36 13.5,4.68V4A1.5,1.5 0 0,0 12,2.5A1.5,1.5 0 0,0 10.5,4V4.68C7.63,5.36 6,7.92 6,11V16L4,18V19H20V18L18,16Z"
                                              Fill="{DynamicResource PrimaryTextBrush}"
                                              Width="20" Height="20"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        
                                        <Border Background="{DynamicResource ErrorBrush}"
                                                CornerRadius="7.5"
                                                Width="15" Height="15"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,4,4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UnreadAlertsCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding UnreadAlertsCount}"
                                                       Foreground="White"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.ToolTip>
                                <ToolTip Content="مركز الإشعارات والتنبيهات"/>
                            </ToggleButton.ToolTip>
                        </ToggleButton>

                        <!-- Notification Dropdown Popup -->
                        <Popup IsOpen="{Binding IsChecked, ElementName=NotificationBellBtn}"
                               PlacementTarget="{Binding ElementName=NotificationBellBtn}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Width="300"
                                    MaxHeight="400"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="2" Color="Black"/>
                                </Border.Effect>
                                <Grid FlowDirection="RightToLeft">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="الإشعارات والتنبيهات" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" Opacity="0.5" Margin="0,0,0,8"/>
                                    
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Alerts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Message}" FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm - yyyy/MM/dd'}" FontSize="9.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            
                                                            <Button Grid.Column="1" 
                                                                    Content="✕" 
                                                                    Command="{Binding DataContext.AcknowledgeAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{x:Null}"
                                                                    Background="Transparent"
                                                                    Foreground="{DynamicResource MutedTextBrush}"
                                                                    Cursor="Hand"
                                                                    VerticalAlignment="Center"
                                                                    Padding="4"
                                                                    BorderThickness="0">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Module Content -->
            <ContentControl x:Name="MainRegionControl" Grid.Row="1" Content="{Binding ShellState.CurrentViewModel}" Margin="24"/>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0,16,0">
                <Grid>
                    <ContentControl x:Name="StatusBarRegionControl" VerticalAlignment="Center"/>
                    <TextBlock Text="جاهز" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
        </Grid>

        <!-- MikroTik Connection Dialog Overlay - spans ALL columns to cover full window -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Background="{DynamicResource OverlayBrush}"
              Visibility="{Binding IsConnectionDialogVisible, Converter={StaticResource Boolean2VisibilityConverter}}"
              Panel.ZIndex="999">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <connections:MikroTikConnectionDialog DataContext="{Binding ConnectionDialogViewModel}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="40,40"/>
            </ScrollViewer>
        </Grid>

        <!-- Global Busy Overlay -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}" Visibility="{Binding BusyIndicator.IsBusy, Converter={StaticResource Boolean2VisibilityConverter}}" Panel.ZIndex="1000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBrush}" Padding="32" x:Name="BusyPanel" CornerRadius="8">
                <StackPanel>
                    <hc:LoadingCircle Width="60" Height="60" Margin="0,0,0,16" Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBlock Text="{Binding BusyIndicator.BusyMessage}" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                </StackPanel>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" />
                </Border.Effect>
            </Border>
        </Grid>
    </Grid>
</Window>
