<UserControl x:Class="Lux.Management.Console.Modules.Broadcasting.Views.BroadcastingCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Lux.Management.Console.Modules.Broadcasting.ViewModels"
             xmlns:broadcastViews="clr-namespace:Lux.Management.Console.Modules.Broadcasting.Views"
             xmlns:quickConfigViews="clr-namespace:Lux.Management.Console.Modules.Broadcasting.QuickConfig.Views"
             xmlns:quickConfigViewModels="clr-namespace:Lux.Management.Console.Modules.Broadcasting.QuickConfig.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- DataTemplates: ViewModel → View mapping -->
        <DataTemplate DataType="{x:Type viewmodels:BroadcastingNeighborsViewModel}">
            <broadcastViews:BroadcastingNeighborsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BroadcastingMaintenanceViewModel}">
            <broadcastViews:BroadcastingMaintenancePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:BroadcastingFlashingViewModel}">
            <broadcastViews:BroadcastingFlashingPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type quickConfigViewModels:MainViewModel}">
            <quickConfigViews:QuickConfigPage/>
        </DataTemplate>

        <!-- Pill Navigation Style -->
        <Style x:Key="PillListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type viewmodels:BroadcastingNavigationNode}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,6,0"/>
                        <Setter Property="Padding" Value="14,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="20"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel Nav Style -->
        <Style x:Key="PanelNavListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type viewmodels:BroadcastingNavigationNode}">
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding Description}" FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Opacity="0.75" Margin="0,1,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="4,2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                                Background="{DynamicResource PrimaryBrush}" CornerRadius="2"
                                                Margin="2,3,0,3" Visibility="Collapsed"/>
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}" Margin="6,0,0,0">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{DynamicResource PrimaryColor}" Opacity="0.08"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Toggle Button Style -->
        <Style x:Key="NavToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- Root Grid -->
    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Breadcrumb bar -->
            <RowDefinition Height="Auto"/>   <!-- Pill strip -->
            <RowDefinition Height="*"/>      <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Row 0: Breadcrumb bar + toggle -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Command="{Binding ToggleNavPanelCommand}"
                        Content="☰  الأقسام"
                        Style="{StaticResource NavToggleButtonStyle}"
                        Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding BreadcrumbText}"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Row 1: Pill strip -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                Visibility="{Binding IsPillStripVisible, Converter={StaticResource BoolToVis}}">
            <ListBox ItemsSource="{Binding ActiveSectionPills}"
                     SelectedItem="{Binding SelectedSubNode, Mode=TwoWay}"
                     Style="{StaticResource PillListBoxStyle}"/>
        </Border>

        <!-- Row 2: Content / Landing page -->
        <Grid Grid.Row="2">
            <!-- Landing page when no sub-page is selected -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="16,8,16,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSubPageViewModel}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="1" Text="📡 مركز أجهزة البث والشبكة اللاسلكية" 
                               FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" 
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                               
                    <TextBlock Grid.Row="2" Text="يرجى فتح قائمة الأقسام الجانبية واختيار القسم المطلوب للبدء: الكشف التلقائي (النيبورز)، الإعداد والصيانة، أو تفليش الأنظمة." 
                               FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" 
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="500"/>
                </Grid>
            </Border>

            <!-- Dynamic Sub Page Content -->
            <ContentControl Content="{Binding CurrentSubPageViewModel}"/>
        </Grid>

        <!-- Nav Panel Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Panel.ZIndex="100"
              Visibility="{Binding IsNavPanelOpen, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" Background="#28000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseNavPanelCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,1,0"
                    FlowDirection="LeftToRight"
                    Padding="0,16">
                <ListBox ItemsSource="{Binding NavigationTree}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Style="{StaticResource PanelNavListBoxStyle}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
