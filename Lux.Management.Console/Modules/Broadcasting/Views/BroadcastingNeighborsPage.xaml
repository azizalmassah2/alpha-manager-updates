<UserControl x:Class="Lux.Management.Console.Modules.Broadcasting.Views.BroadcastingNeighborsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ScanBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
            <RowDefinition Height="Auto"/>  <!-- Search/Filter bar -->
            <RowDefinition Height="*"/>     <!-- Table -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📡" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="النيبورز — كشف أجهزة الشبكة"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="استماع تلقائي ومستمر للشبكة — بدون مايكروتيك"
                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Counter badge -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource PrimaryBrush}" CornerRadius="12"
                        Padding="12,4"
                        Visibility="{Binding DevicesCount, Converter={StaticResource BoolToVis}}">
                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="12">
                        <Run Text="{Binding DevicesCount}"/>
                        <Run Text=" جهاز مكتشف"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- Status bar / Info Bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                            Text="{Binding ScanStatus}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="ℹ️ يتم الاستماع تلقائياً للشبكة لكشف الأجهزة المجاورة التي تعلن عن نفسها عبر بروتوكولات الطبقة الثانية."
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Unified Filter Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <hc:SearchBar Grid.Column="0"
                              Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                              Height="32"
                              hc:InfoElement.Placeholder="بحث عن الأجهزة (الاسم، الماك، الـ IP، المنصة، المنفذ...)"
                              Style="{StaticResource SearchBarPlus}"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="تحديث فوري  ↻"
                        Command="{Binding RefreshDiscoveryCommand}"
                        Style="{DynamicResource ButtonDefault}"
                        Height="32"
                        Padding="16,0"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Data Grid wrapped in border like VoucherManagementPage -->
        <Border Grid.Row="3" 
                VerticalAlignment="Stretch" 
                HorizontalAlignment="Stretch" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="12" 
                ClipToBounds="True" 
                Margin="16,8,16,16" 
                Background="{DynamicResource SurfaceBrush}">
            
            <DataGrid x:Name="NeighborsDataGrid"
                      Style="{StaticResource HighDensityDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource HighDensityColumnHeaderStyle}"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding DiscoveredDevices}"
                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                      SelectionMode="Extended"
                      hc:DataGridAttach.ShowRowNumber="True"
                      Margin="0">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="فحص الاتصال (Ping)" 
                                              Command="{Binding Path=PlacementTarget.Tag.PingDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"/>
                                    <Separator/>
                                    <MenuItem Header="نسخ عنوان IP" 
                                              Command="{Binding Path=PlacementTarget.Tag.CopyIpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="نسخ عنوان MAC" 
                                              Command="{Binding Path=PlacementTarget.Tag.CopyMacCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"/>
                                    <Separator/>
                                    <MenuItem Header="حفظ الجهاز" 
                                              Command="{Binding Path=PlacementTarget.Tag.RegisterDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- 1. Interface -->
                    <DataGridTextColumn Header="المنفذ" Binding="{Binding Interface}" Width="1.2*" SortMemberPath="Interface" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                    <!-- 2. IP Address -->
                    <DataGridTextColumn Header="عنوان IP" Binding="{Binding IpAddress}" Width="1.5*" SortMemberPath="IpAddress" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                    <!-- 3. MAC Address -->
                    <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="1.8*" SortMemberPath="MacAddress" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                    <!-- 4. Identity -->
                    <DataGridTextColumn Header="الاسم المعرف" Binding="{Binding Hostname}" Width="1.8*" SortMemberPath="Hostname" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                    <!-- 5. Platform -->
                    <DataGridTextColumn Header="المنصة" Binding="{Binding Platform}" Width="1.3*" SortMemberPath="Platform" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                    <!-- 6. Version -->
                    <DataGridTextColumn Header="الإصدار" Binding="{Binding Version}" Width="1.6*" SortMemberPath="Version" ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
