<UserControl x:Class="Lux.Management.Console.Modules.Broadcasting.Views.BroadcastingMaintenancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource RegionBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>  <!-- Sidebar: device list -->
            <ColumnDefinition Width="1"/>    <!-- Divider -->
            <ColumnDefinition Width="*"/>    <!-- Detail panel -->
        </Grid.ColumnDefinitions>

        <!-- ════════ SIDEBAR: Device List ════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header + filter -->
                    <RowDefinition Height="*"/>     <!-- Device list -->
                    <RowDefinition Height="Auto"/>  <!-- New button -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="16,14,16,10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="🔧  الأجهزة المسجلة" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                        <!-- Vendor filter -->
                        <StackPanel>
                            <TextBlock Text="فلترة حسب الشركة:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding VendorFilters}"
                                      SelectedItem="{Binding SelectedVendorFilter, Mode=TwoWay}"
                                      Height="30" FontSize="12"
                                      Background="{DynamicResource SurfaceBrush}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- List of devices -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredDevices}"
                         SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" CornerRadius="6" Margin="6,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding IpAddress}" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource PrimaryBrush}"
                                            CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Vendor}" FontSize="9" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="4,2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="{DynamicResource PrimaryColor}" Opacity="0.12"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- New device button -->
                <Border Grid.Row="2" Padding="12,10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Button Command="{Binding NewDeviceCommand}"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            Content="➕  إضافة جهاز جديد"
                            Style="{StaticResource ActionBtnStyle}"
                            HorizontalAlignment="Stretch"/>
                </Border>
            </Grid>
        </Border>

        <!-- Divider -->
        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

        <!-- ════════ DETAIL PANEL ════════ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header -->
                    <RowDefinition Height="Auto"/>  <!-- Form -->
                    <RowDefinition Height="Auto"/>  <!-- Tools -->
                    <RowDefinition Height="Auto"/>  <!-- Status -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Margin="0,0,0,20"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="تفاصيل الجهاز" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="أضف أو عدّل بيانات جهاز البث المحدد"
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="💾  حفظ" Command="{Binding SaveDeviceCommand}"
                                    Background="#10b981" Foreground="White"
                                    Style="{StaticResource ActionBtnStyle}" Margin="0,0,8,0"/>
                            <Button Content="🗑️  حذف" Command="{Binding DeleteDeviceCommand}"
                                    Background="#ef4444" Foreground="White"
                                    Style="{StaticResource ActionBtnStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Form -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Col 0 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الاسم التعريفي *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock Text="عنوان IP *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock Text="MAC Address" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditMacAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock Text="نوع الجهاز" Style="{StaticResource FieldLabel}"/>
                            <ComboBox SelectedItem="{Binding EditDeviceType, Mode=TwoWay}"
                                      Height="32" FontSize="13"
                                      Background="{DynamicResource SurfaceBrush}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}">
                                <ComboBoxItem>Antenna</ComboBoxItem>
                                <ComboBoxItem>Modem</ComboBoxItem>
                                <ComboBoxItem>Router</ComboBoxItem>
                                <ComboBoxItem>Switch</ComboBoxItem>
                                <ComboBoxItem>AccessPoint</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <!-- Col 2 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الشركة المصنعة (Vendor)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox SelectedItem="{Binding EditVendor, Mode=TwoWay}"
                                      IsEditable="True"
                                      Text="{Binding EditVendor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Height="32" FontSize="13"
                                      Background="{DynamicResource SurfaceBrush}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}">
                                <ComboBoxItem>Ubiquiti</ComboBoxItem>
                                <ComboBoxItem>TP-Link</ComboBoxItem>
                                <ComboBoxItem>MikroTik</ComboBoxItem>
                                <ComboBoxItem>Huawei</ComboBoxItem>
                                <ComboBoxItem>Cambium</ComboBoxItem>
                                <ComboBoxItem>D-Link</ComboBoxItem>
                                <ComboBoxItem>NETGEAR</ComboBoxItem>
                                <ComboBoxItem>غير معروف</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Text="اسم المستخدم (SSH/Web)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"/>

                            <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox Height="32" Padding="10,6" FontSize="13"
                                         Background="{DynamicResource SurfaceBrush}"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1"/>

                            <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                     Padding="10,6" FontSize="13" VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource SurfaceBrush}"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tools: Ping / Web UI -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20,14"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🛠️  أدوات الفحص:" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Grid.Column="1"
                                Command="{Binding PingDeviceCommand}"
                                Content="🔔  Ping"
                                Background="{DynamicResource PrimaryBrush}" Foreground="White"
                                Style="{StaticResource ActionBtnStyle}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2"
                                Command="{Binding OpenWebUiCommand}"
                                Content="🌐  Web UI"
                                Background="#0ea5e9" Foreground="White"
                                Style="{StaticResource ActionBtnStyle}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding PingResult}"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>
                </Border>

                <!-- Status message -->
                <Border Grid.Row="3"
                        Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,10">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
