<Window x:Class="Lux.Management.Console.Modules.Broadcasting.QuickConfig.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Lux.Management.Console.Modules.Broadcasting.QuickConfig.Helpers"
        xmlns:resources="clr-namespace:Lux.Management.Console.Modules.Broadcasting.QuickConfig.Resources"
        Title="{x:Static resources:Strings.AppTitle}" 
        Height="720" Width="1024"
        MinHeight="600" MinWidth="800"
        WindowState="Maximized"
        Background="#f6f8fa" Foreground="#24292f"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <!-- Converters -->
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
        <helpers:InverseBoolConverter x:Key="InverseBool"/>
        <helpers:LogLevelToColorConverter x:Key="LogLevelToColor"/>
        
        <!-- Modern Scrollbar styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#f6f8fa"/>
            <Setter Property="BorderBrush" Value="#d0d7de"/>
        </Style>

        <!-- Base Label Style -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#24292f"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Card border styling -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#d0d7de"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0077b6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="15,10" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="لوكس كارد ( مودمات )" FontSize="22" FontWeight="Bold" Foreground="#e94560"/>
                    <TextBlock Text="بواسطة م/عزيز المساح" FontSize="12" Foreground="#8b949e" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- License Status button -->
                    <Button Content="{Binding LicenseBadgeText}" Command="{Binding OpenLicenseInfoCommand}" 
                            Background="#ffffff" Foreground="#1a7f37" BorderBrush="#d0d7de" BorderThickness="1"
                            Height="32" Margin="0,0,15,0" Padding="12,2" FontWeight="Bold"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Network Settings button -->
                    <Button Content="⚙️ إعدادات الشبكة" Command="{Binding OpenSettingsCommand}" 
                            Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" BorderThickness="1"
                            Height="32" Margin="0,0,15,0" Padding="12,2" FontWeight="Bold"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Border CornerRadius="12" Padding="8,4" Background="#f6f8fa" BorderThickness="1" BorderBrush="#d0d7de">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#ef476f"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="#06d6a0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectedDevice.SessionStatus}" FontSize="12" Foreground="#24292f" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*"/> <!-- Left Column: Action & Logs -->
                <ColumnDefinition Width="5.5*"/> <!-- Right Column: Daily Operations & Previews -->
            </Grid.ColumnDefinitions>

            <!-- ================= RIGHT COLUMN: DAILY OPERATIONS & PREVIEWS ================= -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
                <StackPanel>
                    
                    <!-- 1. Connection & Daily Settings Section -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="بيانات التشغيل اليومية" Style="{StaticResource SectionHeader}"/>
                            
                            <StackPanel Margin="0,0,0,15">
                                <Label Content="عنوان IP الحالي للجهاز:"/>
                                <TextBox Text="{Binding ConnectIp, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="35" Padding="8,5" VerticalContentAlignment="Center" FontSize="14"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <Label Content="رقم المودم (Modem Number):"/>
                                    <TextBox Text="{Binding ModemNumber, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="35" Padding="8,5" VerticalContentAlignment="Center" FontSize="14"/>
                                    <TextBlock Text="{Binding ModemValidationError}" Visibility="{Binding IsModemNumberValid, Converter={StaticResource BoolToVisInverted}}" Foreground="#ef476f" FontSize="12" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding LastProgrammedText, StringFormat='آخر رقم مبرمج: {0}'}" Foreground="#57606a" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                    <Button Content="الرقم التالي ➡️" Command="{Binding NextNumberCommand}"
                                            Background="#00b4d8" Foreground="White" Width="120" Height="35" FontWeight="Bold"
                                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Label Content="وضع التشغيل (Operation Mode):" Margin="0,5,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <RadioButton Content="نقطة وصول (Access Point)" IsChecked="{Binding IsApModeSelected}" Foreground="#24292f" Margin="0,0,20,0" FontSize="13" FontWeight="SemiBold"/>
                                <RadioButton Content="عميل WDS (Client WDS)" IsChecked="{Binding IsClientWdsModeSelected}" Foreground="#24292f" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Client WDS Mode Fields -->
                            <StackPanel Visibility="{Binding IsClientWdsMode, Converter={StaticResource BoolToVis}}">
                                <Border BorderBrush="#d0d7de" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                    <StackPanel>
                                        <Label Content="الملف التعريفي للشبكة البعيدة (Upstream Profile):"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding SavedNetworks}" SelectedItem="{Binding SelectedSavedNetwork}" DisplayMemberPath="ProfileName"
                                                      Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="35" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                            
                                            <Button Grid.Column="1" Content="تحميل الملف التعريفي" Command="{Binding LoadSavedNetworkCommand}"
                                                    Background="#06d6a0" Foreground="White" Width="140" Height="35" FontWeight="Bold"
                                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <Label Content="اسم الشبكة البعيدة SSID (يدوي/متقدم):"/>
                                                <TextBox Text="{Binding RemoteSsid, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <Button Grid.Column="1" Content="🔍 فحص الشبكات" Command="{Binding ScanNetworksCommand}"
                                                    Background="#f6f8fa" Foreground="#24292f" BorderBrush="#d0d7de" Width="140" Height="30" VerticalAlignment="Bottom"
                                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>

                                        <Label Content="كلمة مرور الشبكة البعيدة:"/>
                                        <TextBox Text="{Binding RemotePassword, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Real-Time Previews Panel -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="معاينة فورية للقيم المولدة تلقائياً" Style="{StaticResource SectionHeader}" Foreground="#06d6a0"/>
                            
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="#d0d7de" Padding="0,5">
                                        <Grid>
                                            <TextBlock Text="العنوان المولد IP:" Foreground="#57606a" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding GeneratedIp}" Foreground="#0969da" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </Border>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="#d0d7de" Padding="0,5">
                                        <Grid>
                                            <TextBlock Text="معرف VLAN المولد:" Foreground="#57606a" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding GeneratedVlan}" Foreground="#0969da" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </Border>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="#d0d7de" Padding="0,5">
                                        <Grid>
                                            <TextBlock Text="اسم المضيف المولد:" Foreground="#57606a" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding GeneratedHostname}" Foreground="#0969da" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="#d0d7de" Padding="0,5">
                                        <Grid>
                                            <TextBlock Text="SSID 2.4GHz المولد:" Foreground="#57606a" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding GeneratedSsid24}" Foreground="#0969da" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </Border>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="#d0d7de" Padding="0,5">
                                        <Grid>
                                            <TextBlock Text="SSID 5GHz المولد:" Foreground="#57606a" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding GeneratedSsid5}" Foreground="#0969da" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ================= LEFT COLUMN: PROGRESS & LOGS ================= -->
            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Action button -->
                    <RowDefinition Height="*"/>     <!-- Logs -->
                </Grid.RowDefinitions>

                <!-- 1. Action Button & Progress -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <!-- Big Program Button -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="⚡ بدء البرمجة التلقائية للجهاز" Command="{Binding ProgramDeviceCommand}" 
                                    Background="#e94560" Foreground="White" FontWeight="Bold" FontSize="16" Height="50"
                                    Visibility="{Binding IsProgramming, Converter={StaticResource BoolToVisInverted}}"
                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            
                            <!-- Cancel Button (when active) -->
                            <Button Grid.Column="0" Content="⏹️ إلغاء العملية الجارية" Command="{Binding CancelProgrammingCommand}" 
                                    Background="#ef476f" Foreground="White" FontWeight="Bold" FontSize="16" Height="50"
                                    Visibility="{Binding IsProgramming, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- Progress Section -->
                        <StackPanel Visibility="{Binding IsProgramming, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="{Binding ProgressMessage}" Foreground="#24292f" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}" Foreground="#0077b6" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Value="{Binding ProgressPercent}" Height="10" Background="#f6f8fa" Foreground="#e94560" BorderThickness="0">
                                <ProgressBar.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </ProgressBar.Resources>
                            </ProgressBar>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Logs Section -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="سجلات التواصل مع الجهاز (Logs)" Style="{StaticResource SectionHeader}"/>

                        <!-- Scrollable Log Box -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" Background="#ffffff" BorderBrush="#d0d7de" BorderThickness="1" Margin="0,0,0,10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Log actions -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="🧹 مسح السجلات" Command="{Binding ClearLogsCommand}" 
                                    Background="#f6f8fa" Foreground="#24292f" BorderBrush="#d0d7de" BorderThickness="1" Height="30" Margin="0,0,10,0"
                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="📄 تصدير TXT" Command="{Binding ExportLogsTxtCommand}" 
                                        Background="#f6f8fa" Foreground="#24292f" BorderBrush="#d0d7de" BorderThickness="1" Width="100" Height="30" Margin="0,0,10,0"
                                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                
                                <Button Content="📊 تصدير JSON" Command="{Binding ExportLogsJsonCommand}" 
                                        Background="#f6f8fa" Foreground="#24292f" BorderBrush="#d0d7de" BorderThickness="1" Width="100" Height="30"
                                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
