<UserControl x:Class="Lux.Management.Console.Modules.Home.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Welcome Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="الرئيسية" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="نظرة عامة على حالة النظام وجلسة الاتصال الحالية" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Dashboard Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Active Router Connection Status Card -->
            <Border Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="24" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="جسر الاتصال النشط" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"/>
                    
                    <hc:Divider Margin="0,0,0,16"/>

                    <!-- Router Name -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="جهاز المايكروتيك الحالي:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding ActiveRouterName}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Host Address -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="عنوان المضيف (IP/Host):" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding ActiveRouterHost}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Connection Status -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="حالة الاتصال بالراوتر:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Border HorizontalAlignment="Left" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ConnectionStatus}" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Info Alert -->
                    <Border Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1,1,1,1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                        <TextBlock Text="تنبيه: تدعم المنصة جلسة اتصال مايكروتيك نشطة واحدة فقط في نفس الوقت لحماية سلامة البيانات ومنع التداخل." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InfoBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Platform Welcome & Module Guide -->
            <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="مرحباً بك في لوحة تحكم Lux Platform" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="النظام الشامل لإدارة وتشغيل شبكات الإنترنت الميكروتك والمودمات والملحقات اللاسلكية." FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,24"/>

                        <TextBlock Text="أقسام النظام المتاحة:" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"/>

                        <!-- Module Grid -->
                        <UniformGrid Columns="2" Rows="3">
                            <!-- MikroTik Module Info -->
                            <Border Margin="0,0,8,8" Padding="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="📡 المايكروتيك" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="إدارة الكروت، طباعة القوالب، التعديل على الباقات والوكلاء، ومراقبة لوحة القيادة النشطة للمايكروتيك." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Modems Info -->
                            <Border Margin="8,0,0,8" Padding="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="🌐 المودمات" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="مراقبة وإدارة أجهزة المودم المتصلة بالشبكة المحلية واستطلاع حالاتها وقوة الإشارة." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Antennas Info -->
                            <Border Margin="0,8,8,8" Padding="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="📶 الأنتينات" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="إدارة هوائيات البث اللاسلكي وتوجيه الإشارة وتحليل مستويات التشويش." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Monitoring Info -->
                            <Border Margin="8,8,0,8" Padding="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="📈 المراقبة" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="محرك القياس والتحليلات وقراءة البث المباشر لحركة المرور وعرض الإنذارات والتحذيرات الفورية." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Operations Info -->
                            <Border Margin="0,8,8,0" Padding="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="⚙ العمليات" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="مركز الجدولة والعمليات التلقائية بالخلفية والأوامر المجمعة للراوترات والمودمات." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Settings Info -->
                            <Border Margin="8,8,0,0" Padding="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="🔧 الإعدادات" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="تخصيص خيارات النظام، ضبط مسارات قواعد البيانات الموحدة، ومستكشف DB المتقدم للبيانات." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
