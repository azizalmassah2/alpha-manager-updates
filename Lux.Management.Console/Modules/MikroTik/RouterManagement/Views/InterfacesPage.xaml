<UserControl x:Class="Lux.Management.Console.Modules.MikroTik.RouterManagement.Views.InterfacesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:viewmodels="clr-namespace:Lux.Management.Console.Modules.MikroTik.RouterManagement.ViewModels"
      d:DataContext="{d:DesignInstance Type=viewmodels:InterfacesViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="واجهات الشبكة (Interfaces)" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            
            <Button Grid.Column="1" Command="{Binding LoadDataCommand}" Style="{StaticResource ButtonPrimary}" Content="تحديث"/>
        </Grid>

        <hc:LoadingCircle Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" Visibility="{Binding ErrorMessage, Converter={StaticResource String2VisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Interfaces}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" Background="Transparent" BorderThickness="0"
                  Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityReConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="*"/>
                <DataGridCheckBoxColumn Header="تعمل (Running)" Binding="{Binding IsRunning}"/>
                <DataGridCheckBoxColumn Header="معطلة (Disabled)" Binding="{Binding IsDisabled}"/>
                <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="*"/>
                <DataGridTextColumn Header="MTU" Binding="{Binding Mtu}" Width="100"/>
                <DataGridTextColumn Header="Rx Bytes" Binding="{Binding RxBytes}" Width="150"/>
                <DataGridTextColumn Header="Tx Bytes" Binding="{Binding TxBytes}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>



