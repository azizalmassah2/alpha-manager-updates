<UserControl x:Class="Lux.Management.Console.Modules.MikroTik.RouterManagement.Views.NocPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewmodels="clr-namespace:Lux.Management.Console.Modules.MikroTik.RouterManagement.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:NocViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <!-- Custom local colors -->
        <SolidColorBrush x:Key="OrangeBrush" Color="#FF8C00"/>

        <!-- Center-aligned TextBlock style for DataGrid columns (matches Vouchers design) -->
        <Style x:Key="CenterTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Health Status to Icon/Text converter via DataTriggers -->
        <Style x:Key="HealthStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthStatus}" Value="{x:Static viewmodels:VlanHealthStatus.Healthy}">
                    <Setter Property="Text" Value="🟢 Healthy"/>
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthStatus}" Value="{x:Static viewmodels:VlanHealthStatus.Busy}">
                    <Setter Property="Text" Value="🟡 Busy"/>
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthStatus}" Value="{x:Static viewmodels:VlanHealthStatus.Warning}">
                    <Setter Property="Text" Value="🟠 Warning"/>
                    <Setter Property="Foreground" Value="{StaticResource OrangeBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthStatus}" Value="{x:Static viewmodels:VlanHealthStatus.Congested}">
                    <Setter Property="Text" Value="🔴 Congested"/>
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthStatus}" Value="{x:Static viewmodels:VlanHealthStatus.Offline}">
                    <Setter Property="Text" Value="⚫ Offline"/>
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Alert Severity to Icon/Color converter via DataTriggers -->
        <Style x:Key="AlertSeverityStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static viewmodels:AlertSeverity.Critical}">
                    <Setter Property="Text" Value="🔴 Critical"/>
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static viewmodels:AlertSeverity.Warning}">
                    <Setter Property="Text" Value="🟡 Warning"/>
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static viewmodels:AlertSeverity.Info}">
                    <Setter Property="Text" Value="⚫ Info"/>
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <!-- Row 0: Control Toolbar (Auto height) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Summary Cards (Auto height) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: VLAN DataGrid (Main space taker - '*') -->
            <RowDefinition Height="*"/>
            <!-- Row 3: Collapsible details/alerts (Auto height) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ────────────────────────────────────────────────── -->
        <!-- Row 0: Control Toolbar (Interval Settings)         -->
        <!-- ────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title/Info -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📡 الفيلانات" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="• فحص تلقائي للأجهزة المضافة عبر Ping" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Interval Configuration & Add Button -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="📊 إنشاء تقرير"
                        Style="{StaticResource ButtonInfo}"
                        Command="{Binding OpenVlanReportCommand}"
                        Margin="0,0,8,0"
                        Height="30" Padding="12,0"/>
                <Button Content="➕ إضافة فيلان"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding AddVlanCommand}"
                        Margin="0,0,16,0"
                        Height="30" Padding="12,0"/>
                <TextBlock Text="فترة فحص البينج (بالثواني):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Text="{Binding NocMonitoringInterval, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxExtend}"
                         Width="80" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ────────────────────────────────────────────────── -->
        <!-- Row 1: KPI Summary Cards (Optimized 6 columns)     -->
        <!-- ────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/> <!-- Wider column to prevent text cutting -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Clients -->
            <hc:Card Grid.Column="0" Margin="0,0,4,0">
                <StackPanel Margin="6" HorizontalAlignment="Center">
                    <TextBlock Text="العملاء المتصلون" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalClients}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>
            </hc:Card>

            <!-- Card 2: Active VLANs -->
            <hc:Card Grid.Column="1" Margin="4,0,4,0">
                <StackPanel Margin="6" HorizontalAlignment="Center">
                    <TextBlock Text="الفيلانات النشطة" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveVlansCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>
            </hc:Card>

            <!-- Card 3: Total Download Throughput (FlowDirection LTR to render suffix correctly) -->
            <hc:Card Grid.Column="2" Margin="4,0,4,0">
                <StackPanel Margin="6" HorizontalAlignment="Center">
                    <TextBlock Text="إجمالي التحميل الحالي" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalDownloadMbps, StringFormat={}{0} Mbps}" FlowDirection="LeftToRight" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>
            </hc:Card>

            <!-- Card 4: Total Upload Throughput (FlowDirection LTR) -->
            <hc:Card Grid.Column="3" Margin="4,0,4,0">
                <StackPanel Margin="6" HorizontalAlignment="Center">
                    <TextBlock Text="إجمالي الرفع الحالي" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalUploadMbps, StringFormat={}{0} Mbps}" FlowDirection="LeftToRight" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>
            </hc:Card>

            <!-- Card 5: Highest Usage VLAN (Peak-based, fully wrapped & aligned) -->
            <hc:Card Grid.Column="4" Margin="4,0,4,0">
                <StackPanel Margin="6" HorizontalAlignment="Center">
                    <TextBlock Text="أعلى VLAN استهلاكاً للإنترنت" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding HighestUsageVlanName}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </hc:Card>

            <!-- Card 6: Offline VLANs -->
            <hc:Card Grid.Column="5" Margin="4,0,0,0">
                <StackPanel Margin="6" HorizontalAlignment="Center">
                    <TextBlock Text="فيلانات متوقفة" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding OfflineVlansCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                </StackPanel>
            </hc:Card>
        </Grid>

        <!-- ────────────────────────────────────────────────── -->
        <!-- Row 2: Dominated DataGrid (Same as Vouchers Screen)-->
        <!-- ────────────────────────────────────────────────── -->
        <Border Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Background="{StaticResource SurfaceBrush}" Margin="0,0,0,8">
            <DataGrid x:Name="VlanMonitorDataGrid" 
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Vlans}" 
                      SelectedItem="{Binding SelectedVlan, Mode=TwoWay}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      hc:DataGridAttach.ShowRowNumber="True"
                      SelectionMode="Single"
                      CanUserAddRows="False" 
                      CanUserDeleteRows="False"
                      AlternationCount="2"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      RowHeight="30"
                      Style="{DynamicResource DataGrid.Style}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="FontSize" Value="11"/>
                        <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Col 1: VLAN Name -->
                    <DataGridTextColumn Header="اسم الفيلان" Binding="{Binding DisplayName}" Width="1.5*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                    
                    <!-- Col 2: VLAN ID -->
                    <DataGridTextColumn Header="ID VLAN" Binding="{Binding VlanId}" Width="1.0*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                    <!-- Col 3: Connected Clients -->
                    <DataGridTextColumn Header="المتصلين" Binding="{Binding ConnectedClientsText}" Width="1.0*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                    <!-- Col 4: Total Download -->
                    <DataGridTextColumn Header="إجمالي التحميل" Binding="{Binding TotalDownloadText}" Width="1.2*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                    <!-- Col 5: Total Upload -->
                    <DataGridTextColumn Header="إجمالي الرفع" Binding="{Binding TotalUploadText}" Width="1.2*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                    <!-- Col 6: Device IP -->
                    <DataGridTextColumn Header="IP الجهاز" Binding="{Binding DeviceIp}" Width="1.2*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                    <!-- Col 7: Device Status -->
                    <DataGridTemplateColumn Header="حالة الجهاز" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceStatus}" Value="Healthy">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceStatus}" Value="Warning">
                                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceStatus}" Value="Offline">
                                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceStatus}" Value="NotMonitored">
                                                        <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceStatus}" Value="Healthy">
                                                        <Setter Property="Text" Value="متصل"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceStatus}" Value="Warning">
                                                        <Setter Property="Text" Value="تحذير"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceStatus}" Value="Offline">
                                                        <Setter Property="Text" Value="أوفلاين"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceStatus}" Value="NotMonitored">
                                                        <Setter Property="Text" Value="غير مراقب"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Col 8: Latency -->
                    <DataGridTextColumn Header="زمن الاستجابة" Binding="{Binding LatencyText}" Width="1.0*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                    <!-- Col 9: Last Seen -->
                    <DataGridTextColumn Header="آخر ظهور" Binding="{Binding LastSeenText}" Width="1.5*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                    <!-- Col 10: Hotspot Status -->
                    <DataGridTemplateColumn Header="هوت سبوت" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Margin="0,0,5,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HotspotRunning}" Value="True">
                                                        <Setter Property="Fill" Value="#22c55e"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HotspotExists}" Value="True"/>
                                                            <Condition Binding="{Binding HotspotRunning}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Fill" Value="#ef4444"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding HotspotStatusText}" FontSize="10.5" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HotspotRunning}" Value="True">
                                                        <Setter Property="Foreground" Value="#22c55e"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HotspotExists}" Value="True"/>
                                                            <Condition Binding="{Binding HotspotRunning}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="#ef4444"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Col 11: Actions -->
                    <DataGridTemplateColumn Header="الإجراءات" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Edit Button -->
                                    <Button Command="{Binding DataContext.EditVlanNameCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ButtonInfo}"
                                            Height="20" Width="20" Padding="0" Margin="2,0"
                                            ToolTip="تعديل الاسم محلياً"
                                            hc:BorderElement.CornerRadius="4">
                                        <Viewbox Width="9" Height="9">
                                            <Path Fill="White" Stretch="Uniform" Data="M19.3,5.1l-1.4-1.4c-0.8-0.8-2-0.8-2.8,0L3,15.9V20h4.1l12.2-12.2C20.1,7.1,20.1,5.9,19.3,5.1z M6.3,18H5v-1.3l9.2-9.2l1.3,1.3L6.3,18z"/>
                                        </Viewbox>
                                    </Button>

                                    <!-- Configure Monitoring Button -->
                                    <Button Command="{Binding DataContext.ConfigureMonitoringCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ButtonPrimary}"
                                            Height="20" Width="20" Padding="0" Margin="2,0"
                                            ToolTip="إعداد المراقبة"
                                            hc:BorderElement.CornerRadius="4">
                                        <Viewbox Width="9" Height="9">
                                            <Path Fill="White" Stretch="Uniform" Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12c0,0.31,0.04,0.64,0.09,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 C19.86,16.5,19.9,16.17,19.9,15.86c0-0.31-0.04-0.64-0.09-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32 c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96C16.56,9.8,16.02,9.47,15.53,9.1L15.17,6.56z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                                        </Viewbox>
                                    </Button>

                                    <!-- Enable Button (Visible when IsDisabled is True) -->
                                    <Button Command="{Binding DataContext.ToggleVlanStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Height="20" Width="20" Padding="0" Margin="2,0"
                                            ToolTip="تفعيل الفيلان"
                                            hc:BorderElement.CornerRadius="4">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonSuccess}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Viewbox Width="8" Height="8">
                                            <Path Fill="White" Stretch="Uniform" Data="M6,4l12,8L6,20V4z"/>
                                        </Viewbox>
                                    </Button>

                                    <!-- Disable Button (Visible when IsDisabled is False) -->
                                    <Button Command="{Binding DataContext.ToggleVlanStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Height="20" Width="20" Padding="0" Margin="2,0"
                                            ToolTip="تعطيل الفيلان"
                                            hc:BorderElement.CornerRadius="4">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Viewbox Width="8" Height="8">
                                            <Path Fill="White" Stretch="Uniform" Data="M6,19h4V5H6V19z M14,5v14h4V5H14z"/>
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ────────────────────────────────────────────────── -->
        <!-- Row 3: Minimized Collapsible Details & Alerts Log -->
        <!-- ────────────────────────────────────────────────── -->
        <!-- ────────────────────────────────────────────────── -->
        <!-- Row 3: Selected VLAN Details Panel                 -->
        <!-- ────────────────────────────────────────────────── -->
        <Grid Grid.Row="3" Margin="0,0,0,4" Visibility="{Binding SelectedVlan, Converter={StaticResource BoolToVisConverter}}">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource SurfaceBrush}">
                <hc:Card Header="تفاصيل الفيلان المختار (Selected VLAN)">
                    <Grid Margin="6" DataContext="{Binding SelectedVlan}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Identification -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="2">
                            <TextBlock Text="اسم الواجهة / الفيلان:" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="2">
                            <TextBlock Text="الحالة العامة:" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Style="{StaticResource HealthStatusTextStyle}" FontSize="11.5"/>
                        </StackPanel>

                        <!-- Byte stats -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="2">
                            <TextBlock Text="إجمالي التحميل التراكمي:" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding TotalDownloadText}" FontSize="11.5" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="2">
                            <TextBlock Text="إجمالي الرفع التراكمي:" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding TotalUploadText}" FontSize="11.5" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Peaks -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="2">
                            <TextBlock Text="أعلى تحميل (Peak):" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding PeakDownloadSpeedText}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="2">
                            <TextBlock Text="أعلى رفع (Peak):" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding PeakUploadSpeedText}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </Grid>
                </hc:Card>
            </Border>
        </Grid>
    </Grid>
</UserControl>
