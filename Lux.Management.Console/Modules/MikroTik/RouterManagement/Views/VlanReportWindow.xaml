<hc:Window x:Class="Lux.Management.Console.Modules.MikroTik.RouterManagement.Views.VlanReportWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:viewmodels="clr-namespace:Lux.Management.Console.Modules.MikroTik.RouterManagement.ViewModels"
           d:DataContext="{d:DesignInstance Type=viewmodels:VlanReportViewModel}"
           mc:Ignorable="d"
           Title="📊 تقرير الفيلانات الشامل والتحليلات"
           Height="680" Width="980"
           WindowStartupLocation="CenterOwner"
           FlowDirection="RightToLeft">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Toolbar / Filters -->
            <RowDefinition Height="Auto"/>
            <!-- KPI Summary Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Main DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0: Toolbar & Time Period Selector ── -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊 تقرير تحليلات الفيلانات" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="الفترة الزمنية:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="20,0,8,0" VerticalAlignment="Center"/>
                    
                    <ComboBox SelectedIndex="{Binding SelectedPeriodIndex, Mode=TwoWay}" Width="130" Height="30" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="📅 اليوم"/>
                        <ComboBoxItem Content="📅 هذا الأسبوع"/>
                        <ComboBoxItem Content="📅 هذا الشهر"/>
                        <ComboBoxItem Content="⚙️ مخصص"/>
                    </ComboBox>

                    <Button Content="🔄 تحديث" Style="{StaticResource ButtonDefault}" Command="{Binding LoadReportCommand}" Margin="12,0,0,0" Height="30" Padding="12,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📥 تصدير CSV" Style="{StaticResource ButtonSuccess}" Command="{Binding ExportCsvCommand}" Height="30" Padding="12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Row 1: KPI Summary Cards ── -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Top VLAN Consumer -->
            <hc:Card Grid.Column="0" Margin="0,0,6,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="🏆 أعلى VLAN استهلاكاً" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding Report.TopUsageVlan.VlanName, FallbackValue='—'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Report.TopUsageVlan.FormattedTotal, StringFormat={}إجمالي الاستهلاك: {0}, FallbackValue='0 MB'}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </hc:Card>

            <!-- Card 2: Least Active VLAN -->
            <hc:Card Grid.Column="1" Margin="6,0,6,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="💤 أقل VLAN نشاطاً" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding Report.LeastUsageVlan.VlanName, FallbackValue='—'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Report.LeastUsageVlan.FormattedTotal, StringFormat={}إجمالي الاستهلاك: {0}, FallbackValue='0 MB'}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </hc:Card>

            <!-- Card 3: Grand Total Volume -->
            <hc:Card Grid.Column="2" Margin="6,0,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="🌐 إجمالي حركة المرور للشبكة" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding Report.FormattedGrandTotal, FallbackValue='0 MB'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Report.PeriodTitle, StringFormat={}الفترة: {0}}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </hc:Card>
        </Grid>

        <!-- ── Row 2: VLAN Ranking DataGrid ── -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
            <DataGrid ItemsSource="{Binding VlanItems}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      RowHeight="32"
                      AlternationCount="2">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Height" Value="34"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="اسم الفيلان" Binding="{Binding VlanName}" Width="1.5*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="إجمالي التحميل" Binding="{Binding FormattedDownload}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="إجمالي الرفع" Binding="{Binding FormattedUpload}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="الإجمالي الكلي" Binding="{Binding FormattedTotal}" Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="حصة الشبكة %" Binding="{Binding FormattedSharePercent}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── Row 3: Footer Actions ── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="إغلاق النافذة" Style="{StaticResource ButtonDefault}" Click="BtnClose_Click" Width="100" Height="32"/>
        </StackPanel>
    </Grid>
</hc:Window>
