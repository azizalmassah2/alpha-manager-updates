<UserControl x:Class="Lux.Management.Console.Modules.MikroTik.RouterManagement.Views.NtpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:viewmodels="clr-namespace:Lux.Management.Console.Modules.MikroTik.RouterManagement.ViewModels"
      d:DataContext="{d:DesignInstance Type=viewmodels:NtpViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="إعدادات الوقت (NTP Client)" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            
            <Button Grid.Column="1" Command="{Binding LoadDataCommand}" Style="{StaticResource ButtonDefault}" Content="تحديث"/>
        </Grid>

        <hc:LoadingCircle Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" Visibility="{Binding ErrorMessage, Converter={StaticResource String2VisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <ScrollViewer Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityReConverter}}">
            <hc:Card Margin="0,0,0,10">
                <StackPanel Margin="20">
                    <CheckBox IsChecked="{Binding IsEnabled}" Content="تفعيل مزامنة الوقت (NTP Enabled)" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="الخادم الأساسي (Primary NTP):" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding PrimaryServer, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="الخادم الثانوي (Secondary NTP):" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding SecondaryServer, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="حالة المزامنة:" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Status}" Width="150" HorizontalAlignment="Left" Foreground="{DynamicResource InfoBrush}" Margin="0,0,0,20"/>

                    <Button Command="{Binding SaveChangesCommand}" Style="{StaticResource ButtonPrimary}" Content="حفظ الإعدادات" Width="120" HorizontalAlignment="Left"/>
                </StackPanel>
            </hc:Card>
        </ScrollViewer>
    </Grid>
</UserControl>



