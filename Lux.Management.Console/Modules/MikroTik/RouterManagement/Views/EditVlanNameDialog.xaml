<Window x:Class="Lux.Management.Console.Modules.MikroTik.RouterManagement.Views.EditVlanNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="تعديل اسم الفيلان محلياً"
        Height="220" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="تعديل اسم الفيلان محلياً" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock Text="سيتم ربط هذا الاسم بمعرّف الفيلان (VLAN ID) وحفظه محلياً في الإعدادات." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBox x:Name="TxtVlanName" Grid.Row="1"
                 hc:InfoElement.Placeholder="أدخل الاسم المحلي الجديد للفيلان"
                 Style="{StaticResource TextBoxExtend}"
                 Height="35" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,0">
            <Button Content="حفظ" Click="BtnSave_Click" Style="{StaticResource ButtonPrimary}" Width="80" Margin="0,0,10,0"/>
            <Button Content="إلغاء" Click="BtnCancel_Click" Style="{StaticResource ButtonDefault}" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
