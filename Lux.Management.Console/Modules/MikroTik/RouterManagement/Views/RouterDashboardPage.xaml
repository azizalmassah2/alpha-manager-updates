<UserControl x:Class="Lux.Management.Console.Modules.MikroTik.RouterManagement.Views.RouterDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:viewmodels="clr-namespace:Lux.Management.Console.Modules.MikroTik.RouterManagement.ViewModels"
      d:DataContext="{d:DesignInstance Type=viewmodels:RouterDashboardViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="لوحة معلومات الروتر" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource PrimaryTextBrush}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <hc:Card Margin="0,0,0,20">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="الروتر النشط:" FontWeight="Bold" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10"/>
                        <TextBlock Text="{Binding RouterName}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

                        <TextBlock Text="العنوان (Host):" FontWeight="Bold" Grid.Row="0" Grid.Column="2" Margin="0,0,10,10"/>
                        <TextBlock Text="{Binding HostAddress}" Grid.Row="0" Grid.Column="3" Margin="0,0,0,10"/>

                        <TextBlock Text="النسخة (Version):" FontWeight="Bold" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10"/>
                        <TextBlock Text="{Binding HealthStatus.Version}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

                        <TextBlock Text="الموديل (Board):" FontWeight="Bold" Grid.Row="1" Grid.Column="2" Margin="0,0,10,10"/>
                        <TextBlock Text="{Binding HealthStatus.BoardName}" Grid.Row="1" Grid.Column="3" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="مدة التشغيل (Uptime):" FontWeight="Bold" Grid.Row="2" Grid.Column="0"/>
                        <TextBlock Text="{Binding HealthStatus.Uptime}" Grid.Row="2" Grid.Column="1"/>
                        
                        <TextBlock Text="حالة الاتصال:" FontWeight="Bold" Grid.Row="2" Grid.Column="2"/>
                        <TextBlock Text="{Binding HealthStatus.OverallHealth}" Grid.Row="2" Grid.Column="3"/>
                    </Grid>
                </hc:Card>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <hc:Card Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Margin="15" HorizontalAlignment="Center">
                            <TextBlock Text="المعالج (CPU)" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding HealthStatus.CpuLoadPercent, StringFormat={}{0}%}" FontSize="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                    </hc:Card>

                    <hc:Card Grid.Column="1" Margin="10,0,10,0">
                        <StackPanel Margin="15" HorizontalAlignment="Center">
                            <TextBlock Text="الذاكرة (RAM)" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding HealthStatus.MemoryUsagePercent, StringFormat={}{0}%}" FontSize="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                    </hc:Card>

                    <hc:Card Grid.Column="2" Margin="10,0,0,0">
                        <StackPanel Margin="15" HorizontalAlignment="Center">
                            <TextBlock Text="التخزين (Disk)" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding HealthStatus.DiskUsagePercent, StringFormat={}{0}%}" FontSize="24" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                    </hc:Card>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>


