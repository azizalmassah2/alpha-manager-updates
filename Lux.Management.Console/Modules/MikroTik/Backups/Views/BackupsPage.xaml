<UserControl x:Class="Lux.Management.Console.Modules.MikroTik.Backups.Views.BackupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:viewmodels="clr-namespace:Lux.Management.Console.Modules.MikroTik.Backups.ViewModels"
      d:DataContext="{d:DesignInstance Type=viewmodels:BackupsViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="النسخ الاحتياطي (Backups)" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding CreateBackupCommand}" Style="{StaticResource ButtonPrimary}" Content="إنشاء نسخة احتياطية 📥" Margin="0,0,10,0"/>
                <Button Command="{Binding LoadDataCommand}" Style="{StaticResource ButtonDefault}" Content="تحديث 🔄"/>
            </StackPanel>
        </Grid>

        <hc:LoadingCircle Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" Visibility="{Binding ErrorMessage, Converter={StaticResource String2VisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Border Grid.Row="1" 
                VerticalAlignment="Stretch" 
                HorizontalAlignment="Stretch" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="12" 
                ClipToBounds="True" 
                Background="{DynamicResource CardBrush}" 
                Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityReConverter}}">
            <DataGrid ItemsSource="{Binding Files}" 
                      Style="{StaticResource HighDensityDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource HighDensityColumnHeaderStyle}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      HeadersVisibility="All" 
                      Background="Transparent" 
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم النسخة" Binding="{Binding Name}" Width="1.5*"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="0.8*"/>
                    <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreationTime}" Width="1.2*"/>
                    <DataGridTextColumn Header="الحجم" Binding="{Binding Size}" Width="0.6*"/>
                    <DataGridTextColumn Header="مسار الملف" Binding="{Binding FilePath}" Width="2*"/>
                    
                    <DataGridTemplateColumn Header="إجراءات" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding DataContext.RestoreFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" 
                                            Style="{StaticResource ButtonSuccess}" 
                                            Content="استعادة ↩️"
                                            ToolTip="استعادة هذه النسخة على الراوتر" Padding="10,4" Margin="5,0"/>
                                    <Button Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" 
                                            Style="{StaticResource ButtonDanger}" 
                                            Content="حذف 🗑️"
                                            ToolTip="حذف نهائياً من الكمبيوتر" Padding="10,4" Margin="5,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>



