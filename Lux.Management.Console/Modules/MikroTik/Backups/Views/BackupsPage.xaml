<UserControl x:Class="Lux.Management.Console.Modules.MikroTik.Backups.Views.BackupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:viewmodels="clr-namespace:Lux.Management.Console.Modules.MikroTik.Backups.ViewModels"
      d:DataContext="{d:DesignInstance Type=viewmodels:BackupsViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="النسخ الاحتياطي (Backups)" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            
            <Button Grid.Column="1" Command="{Binding CreateBackupCommand}" Style="{StaticResource ButtonPrimary}" Content="إنشاء Backup" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Command="{Binding CreateExportCommand}" Style="{StaticResource ButtonSuccess}" Content="تصدير Export (.rsc)" Margin="0,0,10,0"/>
            <Button Grid.Column="3" Command="{Binding LoadDataCommand}" Style="{StaticResource ButtonDefault}" Content="تحديث"/>
        </Grid>

        <hc:LoadingCircle Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" Visibility="{Binding ErrorMessage, Converter={StaticResource String2VisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="All" Background="Transparent" BorderThickness="0"
                  Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityReConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="اسم الملف" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="*"/>
                <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreationTime}" Width="*"/>
                <DataGridTextColumn Header="الحجم" Binding="{Binding Size}" Width="*"/>
                
                <DataGridTemplateColumn Header="إجراءات" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource ButtonDanger}" 
                                        ToolTip="حذف" Padding="5" Margin="5,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>



