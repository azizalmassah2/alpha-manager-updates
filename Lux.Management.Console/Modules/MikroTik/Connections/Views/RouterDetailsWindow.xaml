<Window x:Class="Lux.Management.Console.Modules.MikroTik.Connections.Views.RouterDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:viewmodels="clr-namespace:Lux.Management.Console.Modules.MikroTik.Connections.ViewModels"
        Title="تفاصيل الروتر" Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{DynamicResource RegionBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="إعدادات الاتصال بالروتر" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Grid.Row="0"/>

        <hc:TextBox hc:InfoElement.Title="اسم الروتر (للعرض)" hc:InfoElement.Necessary="True" 
                    Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" 
                    Margin="0,0,0,15" Grid.Row="1"/>

        <hc:TextBox hc:InfoElement.Title="عنوان IP أو النطاق (Host)" hc:InfoElement.Necessary="True" 
                    Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" 
                    Margin="0,0,0,15" Grid.Row="2"/>

        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <hc:TextBox hc:InfoElement.Title="اسم المستخدم (Username)" hc:InfoElement.Necessary="True" 
                        Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                        Grid.Column="0"/>
            
            <hc:TextBox hc:InfoElement.Title="المنفذ (API Port)" hc:InfoElement.Necessary="True" 
                        Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" 
                        Grid.Column="2"/>
        </Grid>

        <PasswordBox hc:InfoElement.Title="كلمة المرور (Password)" 
                        Style="{StaticResource PasswordBoxExtend}"
                        x:Name="PasswordBoxControl"
                        PasswordChanged="PasswordBoxControl_PasswordChanged"
                        Margin="0,0,0,20" Grid.Row="4"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource ButtonDefault}" Margin="0,0,10,0" Width="100"/>
            <Button Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource ButtonPrimary}" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
