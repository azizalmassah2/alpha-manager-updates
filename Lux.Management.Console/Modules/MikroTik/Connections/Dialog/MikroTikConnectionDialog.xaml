<UserControl x:Class="Lux.Management.Console.Modules.MikroTik.Connections.Dialog.MikroTikConnectionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:Lux.Management.Console.Modules.MikroTik.Connections.Dialog"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:MikroTikConnectionDialogViewModel}"
             FlowDirection="RightToLeft"
             Width="1000"
             Height="580"
             Background="{DynamicResource RegionBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Basic TextBlock Styles -->
        <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="HeaderDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ThirdTextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <!-- Card Styles -->
        <Style x:Key="CardListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" SnapsToDevicePixels="true">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0F1890FF"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DiscoveredDeviceCardTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="📡" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Identity}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{Binding IpAddress, StringFormat='IP: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding MacAddress, StringFormat='MAC: {0}'}" FontSize="11" Foreground="{DynamicResource ThirdTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Version, StringFormat='Version: {0}'}" FontSize="10" Foreground="{DynamicResource ThirdTextBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Uptime, StringFormat='Uptime: {0}'}" FontSize="10" Foreground="{DynamicResource ThirdTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SavedRouterCardTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="💾" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Router.DisplayName}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,6,0"/>
                        <Border Background="{DynamicResource SuccessBrush}" CornerRadius="4" Padding="4,1.5" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="متصل حالياً" FontSize="9" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Router.Host, StringFormat='Host: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                    <TextBlock Text="{Binding Router.Username, StringFormat='User: {0}'}" FontSize="11" Foreground="{DynamicResource ThirdTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="تعديل" Command="{Binding DataContext.EditSavedRouterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ButtonDashed}" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                    <Button Content="حذف" Command="{Binding DataContext.DeleteSavedRouterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="{DynamicResource DangerBrush}" Background="Transparent" BorderThickness="0" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                    <Button Content="اتصال" Command="{Binding DataContext.ConnectSavedRouterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ButtonPrimary}" Padding="12,3" FontSize="11"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <!-- Row 0 = Header (Auto) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1 = Connection Section (Auto) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2 = Cards Layout (*) -->
            <RowDefinition Height="*"/>
            <!-- Row 3 = Footer Buttons (Auto) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Row 0: Header ================= -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="24,16" CornerRadius="8,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🌐" FontSize="32" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="White"/>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="إدارة الاتصال بخوادم المايكروتيك" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="اختر جهازاً للاتصال السريع أو أدخل بيانات روتر جديد" FontSize="13" Foreground="#E0E0E0" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" 
                        Command="{Binding CancelCommand}"
                        Foreground="White"
                        Content="✕"
                        FontSize="16"
                        VerticalAlignment="Top" 
                        Margin="0,-4,-8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- ================= Row 1: Connection Section ================= -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
            <StackPanel>
                <!-- Error Banner -->
                <Border Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1" CornerRadius="4" Padding="12,8"
                        Margin="0,0,0,12"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource String2VisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#856404" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Input Fields -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Host -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="عنوان IP أو Host" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" 
                                 hc:InfoElement.Placeholder="مثال: 192.168.1.1" 
                                 Height="36"/>
                    </StackPanel>

                    <!-- Port -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="المنفذ" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" 
                                 hc:InfoElement.Placeholder="8728" 
                                 Height="36"/>
                    </StackPanel>

                    <!-- Username -->
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="اسم المستخدم" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                 hc:InfoElement.Placeholder="admin" 
                                 Height="36"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="كلمة المرور" Style="{StaticResource LabelStyle}"/>
                        <PasswordBox x:Name="PasswordBoxControl" 
                                     PasswordChanged="PasswordBoxControl_PasswordChanged"
                                     hc:InfoElement.Placeholder="اتركه فارغاً إن لم يوجد" 
                                     Height="36"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= Row 2: Cards Layout ================= -->
        <Grid Grid.Row="2" Margin="24,12,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Right Column: Saved Routers (RTL UI) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="الأجهزة المحفوظة" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding HasSavedRouters, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SavedRouters.Count}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Saved Routers List -->
                <ListBox Grid.Row="1" 
                         Style="{StaticResource CardListBoxStyle}"
                         ItemsSource="{Binding SavedRouters}"
                         ItemTemplate="{StaticResource SavedRouterCardTemplate}">
                </ListBox>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasSavedRouters, Converter={StaticResource Boolean2VisibilityReConverter}}">
                    <TextBlock Text="📭" FontSize="36" Foreground="{DynamicResource BorderBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="لا توجد أجهزة محفوظة" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="عند الاتصال بنجاح سيتم حفظ الروتر هنا" FontSize="11" Foreground="{DynamicResource ThirdTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Left Column: Discovered Devices -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="الأجهزة المكتشفة" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasDiscoveredDevices, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding DiscoveredDevices.Count}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <hc:LoadingCircle Width="14" Height="14" Margin="0,0,8,0"
                                          Visibility="{Binding IsDiscovering, Converter={StaticResource BoolToVis}}"/>
                        <Button Command="{Binding RefreshDiscoveryCommand}"
                                Style="{StaticResource ButtonDefault}"
                                Content="تحديث ⟳"
                                IsEnabled="{Binding IsDiscovering, Converter={StaticResource Boolean2BooleanReConverter}}"
                                Padding="10,2" Height="26" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <!-- Discovered Devices List -->
                <ListBox Grid.Row="1" 
                         x:Name="DiscoveryListBox"
                         Style="{StaticResource CardListBoxStyle}"
                         ItemsSource="{Binding DiscoveredDevices}"
                         SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                         ItemTemplate="{StaticResource DiscoveredDeviceCardTemplate}">
                </ListBox>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasDiscoveredDevices, Converter={StaticResource Boolean2VisibilityReConverter}}">
                    <TextBlock Text="📡" FontSize="36" Foreground="{DynamicResource BorderBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="لم يتم اكتشاف أي أجهزة" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="يتم البحث عن الأجهزة في الشبكة المحلية..." FontSize="11" Foreground="{DynamicResource ThirdTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= Row 4: Footer Buttons ================= -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12" CornerRadius="0,0,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <hc:LoadingCircle Width="18" Height="18" Margin="0,0,12,0"
                                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="إلغاء" 
                        Command="{Binding CancelCommand}" 
                        Style="{StaticResource ButtonDefault}" 
                        Width="110" Height="34" FontSize="13" Margin="0,0,16,0"/>

                <Button Grid.Column="2" 
                        Content="اتصال" 
                        Command="{Binding ConnectCommand}" 
                        Style="{StaticResource ButtonPrimary}" 
                        Width="110" Height="34" FontSize="13" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
