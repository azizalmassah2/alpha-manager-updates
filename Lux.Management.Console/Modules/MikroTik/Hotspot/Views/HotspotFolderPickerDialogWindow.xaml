<Window x:Class="Lux.Management.Console.Modules.MikroTik.Hotspot.Views.HotspotFolderPickerDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d" 
        Title="تحديد مجلد الهوتسبوت على الراوتر" 
        Height="450" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="22" Margin="0,0,8,0"/>
                    <TextBlock Text="اختيار وتحديد مجلد الهوتسبوت" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
                <TextBlock Text="لم يتم العثور على ملف التكوين (config.js) في المسار المحفوظ. يرجى اختيار المجلد الذي توجد به صفحة الـ Hotspot بالروتر:" 
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="30,4,0,0"/>
            </StackPanel>

            <Separator Grid.Row="1" Margin="0,0,0,12" Background="{DynamicResource BorderBrush}"/>

            <!-- Folder Options List (RadioButtons) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ItemsControl x:Name="FoldersItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding}" 
                                             GroupName="HotspotFolderGroup"
                                             FontSize="14" FontWeight="SemiBold" 
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             Margin="0,0,0,12"
                                             Checked="FolderRadioButton_Checked"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </ScrollViewer>

            <!-- Custom Path Fallback -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="أو أدخل اسم مجلد مخصص:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                <hc:TextBox x:Name="CustomFolderTextBox" hc:InfoElement.Placeholder="hotspot" Height="34" TextChanged="CustomFolderTextBox_TextChanged"/>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="حفظ وتطبيق المسار 💾" 
                        Style="{StaticResource ButtonPrimary}" 
                        Height="38" Click="Save_Click"/>

                <Button Grid.Column="2" Content="إلغاء ✖" 
                        Style="{StaticResource ButtonDefault}" 
                        Height="38" Click="Cancel_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
