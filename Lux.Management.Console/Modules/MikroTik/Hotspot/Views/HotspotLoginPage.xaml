<UserControl x:Class="Lux.Management.Console.Modules.MikroTik.Hotspot.Views.HotspotLoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converters="clr-namespace:Lux.Management.Console.Converters"
             xmlns:local="clr-namespace:Lux.Management.Console.Modules.MikroTik.Hotspot.Views"
             xmlns:vms="clr-namespace:Lux.Management.Console.Modules.MikroTik.Hotspot.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="BoolToVisRevert"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ PAGE HEADER ══ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="إعداد صفحة تسجيل الدخول (Hotspot)" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="تعديل محتويات وتصميم صفحة الـ Hotspot لشبكتك ورفعها للراوتر" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ══ CONTENT AREA ══ -->
        <Grid Grid.Row="1">
            <TabControl Style="{DynamicResource TabControlPlus}" IsEnabled="{Binding IsUploading, Converter={StaticResource InverseBool}}">
                
                <!-- 0. Buy & Activate Page Tab -->
                <TabItem Header="🛒 شراء صفحة تسجيل الدخول">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24" MaxWidth="800" HorizontalAlignment="Center">
                            <hc:Card Margin="0,0,0,20" Padding="24" Background="{DynamicResource SurfaceAltBrush}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🛒 حزمة صفحة تسجيل الدخول (Hotspot Login Template)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="لتعديل وتفعيل خصائص صفحة الهوتسبوت الخاصة بشبكتك، يجب قراءة ومزامنة قالب مرخص يحتوي على ملف التكوين (config.js) من إحدى مجلدات الروتر." 
                                               TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center" Margin="0,0,0,20"/>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                                        <Button Content="🛒 شراء الصفحة الكاملة" 
                                                Style="{DynamicResource PrimaryButtonStyle}" 
                                                IsEnabled="False"
                                                Height="42" FontSize="14" Padding="24,0" Margin="0,0,12,0"/>
                                        <Button Content="استعراض ومزامنة مجلدات الروتر 📁" 
                                                Style="{DynamicResource OutlineButtonStyle}" 
                                                Command="{Binding PickRouterFolderCommand}" 
                                                Height="42" FontSize="14" Padding="20,0"/>
                                    </StackPanel>

                                    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="📌 حالة القالب والترخيص بالراوتر الحالي:" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding UploadStatus}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </hc:Card>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 1. General Settings -->
                <TabItem Header="⚙️ الإعدادات العامة" IsEnabled="{Binding HasValidRouterConfig}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16" MaxWidth="700" HorizontalAlignment="Left" Width="700">
                            <hc:Card Margin="0,0,0,16" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="البيانات الأساسية للموقع" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    
                                    <hc:TextBox hc:InfoElement.Title="اسم الشبكة (الموقع)" 
                                                Text="{Binding SiteName, UpdateSourceTrigger=PropertyChanged}" 
                                                Margin="0,0,0,12"/>
                                    
                                    <hc:TextBox hc:InfoElement.Title="رسالة الترحيب" 
                                                Text="{Binding WelcomeMessage, UpdateSourceTrigger=PropertyChanged}" 
                                                Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding WelcomeMessageV}" 
                                                  Content="عرض رسالة الترحيب في الصفحة" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding ErbV}" 
                                                  Content="عرض رسائل أخطاء الشبكة التفصيلية" VerticalAlignment="Center"/>
                                    </Grid>

                                    <hc:TextBox hc:InfoElement.Title="شريط الإعلانات المتحرك" 
                                                Text="{Binding TextSlider1, UpdateSourceTrigger=PropertyChanged}" 
                                                AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                                                Margin="0,0,0,12"/>
                                </StackPanel>
                            </hc:Card>

                            <!-- الروابط الإضافية -->
                            <hc:Card Margin="0,0,0,16" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="الروابط الإضافية" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    
                                    <hc:TextBox hc:InfoElement.Title="رابط الاستراحة" 
                                                Text="{Binding Estr, UpdateSourceTrigger=PropertyChanged}" 
                                                hc:InfoElement.Placeholder="https://..." 
                                                Margin="0,0,0,12"/>
                                    
                                    <hc:TextBox hc:InfoElement.Title="رابط البث المباشر" 
                                                Text="{Binding Moba, UpdateSourceTrigger=PropertyChanged}" 
                                                hc:InfoElement.Placeholder="https://..." 
                                                Margin="0,0,0,12"/>
                                </StackPanel>
                            </hc:Card>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 2. Display Settings -->
                <TabItem Header="🖼️ إعدادات العرض" IsEnabled="{Binding HasValidRouterConfig}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16" MaxWidth="700" HorizontalAlignment="Left" Width="700">
                            <hc:Card Padding="16">
                                <StackPanel>
                                    <TextBlock Text="خيارات عرض عناصر الصفحة" FontSize="14" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <CheckBox IsChecked="{Binding WelcomeMessageV}" Content="تفعيل وعرض الرسالة الترحيبية في الصفحة" Margin="0,0,0,14" FontSize="13"/>
                                    <CheckBox IsChecked="{Binding ErbV}" Content="عرض رسائل أخطاء الشبكة التفصيلية للمشتركين" Margin="0,0,0,14" FontSize="13"/>
                                    <CheckBox IsChecked="{Binding ImageV}" Content="تفعيل وعرض المساحة الإعلانية (الصور)" Margin="0,0,0,14" FontSize="13"/>

                                    <StackPanel Visibility="{Binding ImageV, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                        <Label Content="عدد الصور الإعلانية النشطة:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12.5"/>
                                        <hc:NumericUpDown Value="{Binding ImageCountValue, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="5" Width="150" HorizontalAlignment="Left" Margin="0,4,0,12"/>
                                        <TextBlock Text="ملاحظة: الصور يجب وضعها في مجلد img بالأسماء التالية (1.jpg, 2.jpg... إلخ)." FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,16"/>

                                        <!-- قائمة اختيار واستعراض الصور الإعلانية -->
                                        <ItemsControl ItemsSource="{Binding AdImageItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <hc:Card Margin="0,0,0,12" Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- معاينة الصورة المصغرة -->
                                                            <Border Grid.Column="0" Width="65" Height="65" CornerRadius="8" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                                                                <Grid>
                                                                    <TextBlock Text="🖼️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"
                                                                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVisRevert}}"/>
                                                                    <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"
                                                                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>
                                                                </Grid>
                                                            </Border>

                                                            <!-- بيانات ومعلومات الصورة والتسمية التلقائية -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                <TextBlock Text="{Binding LocalFilePath, FallbackValue='لم يتم اختيار صورة بعد'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding TargetFileName, StringFormat='تسمية تلقائية معتمدة: {0}'}" FontSize="10.5" Foreground="{DynamicResource PrimaryBrush}" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <!-- أزرار الاستعراض والحذف -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                <Button Content="استعراض الصورة 📁" 
                                                                        Command="{Binding DataContext.SelectAdImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                        CommandParameter="{Binding}" 
                                                                        Style="{StaticResource ButtonPrimary}" 
                                                                        Padding="10,6" Margin="0,0,6,0"/>
                                                                <Button Content="حذف 🗑️" 
                                                                        Command="{Binding DataContext.RemoveAdImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                                        CommandParameter="{Binding}" 
                                                                        Style="{StaticResource ButtonDanger}" 
                                                                        Padding="8,6" 
                                                                        Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </hc:Card>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </hc:Card>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 3. Themes Gallery -->
                <TabItem Header="🎨 ثيمات وألوان الصفحة" IsEnabled="{Binding HasValidRouterConfig}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <hc:Card Grid.Row="0" Margin="0,0,0,16" Padding="12">
                            <StackPanel>
                                <TextBlock Text="معرض الألوان والثيمات (Theme Gallery)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="اختر الثيم المناسب لشبكتك، وسيتم تطبيق الألوان تلقائياً على جميع صفحات تسجيل الدخول ولوحة التحكم." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </hc:Card>

                        <ListBox Grid.Row="1" 
                                 ItemsSource="{Binding AvailableThemes}" 
                                 SelectedValue="{Binding ActiveTheme, Mode=TwoWay}"
                                 SelectedValuePath="Id"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Margin="0" IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Border" 
                                                        Background="{Binding CardBgColor}" 
                                                        BorderBrush="#d0d7de" 
                                                        BorderThickness="1" 
                                                        CornerRadius="12" 
                                                        Width="180" 
                                                        Padding="12"
                                                        Cursor="Hand">
                                                    <StackPanel>
                                                        <!-- Preview Strip -->
                                                        <Border Height="40" Background="{Binding AppBgColor}" CornerRadius="6" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#e1e4e8">
                                                            <Border Width="100" Height="16" Background="{Binding PrimaryColor}" CornerRadius="4" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <!-- Title -->
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#24292f" HorizontalAlignment="Center" Margin="0,2"/>
                                                        <!-- Description -->
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#586069" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="#0366d6"/>
                                                        <Setter TargetName="Border" Property="Background" Value="#f6f8fa"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="#0366d6"/>
                                                        <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                                        <Setter TargetName="Border" Property="Background" Value="#f1f8ff"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- 4. Packages -->
                <TabItem Header="📦 باقات الاشتراك" IsEnabled="{Binding HasValidRouterConfig}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Packages DataGrid -->
                        <DataGrid Grid.Row="0" 
                                  ItemsSource="{Binding Packages}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  RowHeaderWidth="0"
                                  Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الصلاحية (اسم الباقة)" Binding="{Binding Vl}" Width="2*"/>
                                <DataGridTextColumn Header="زمن الاستخدام (ساعات/أيام)" Binding="{Binding Time}" Width="2*"/>
                                <DataGridTextColumn Header="حجم البيانات (ميجا/جيجا)" Binding="{Binding Size}" Width="2*"/>
                                <DataGridTextColumn Header="السعر" Binding="{Binding Price}" Width="2*"/>
                                <DataGridTemplateColumn Header="إجراءات" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="حذف 🗑️" 
                                                    Style="{DynamicResource SecondaryButtonStyle}" 
                                                    Command="{Binding DataContext.RemovePackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Padding="8,2" FontSize="11" Margin="2" Height="24"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Add Package Input Form -->
                        <hc:Card Grid.Row="1" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <hc:TextBox Grid.Column="0" hc:InfoElement.Title="اسم الباقة" 
                                            Text="{Binding NewPackageValidity, UpdateSourceTrigger=PropertyChanged}" 
                                            Margin="0,0,8,0"/>
                                
                                <hc:TextBox Grid.Column="1" hc:InfoElement.Title="زمن الاستخدام" 
                                            Text="{Binding NewPackageTime, UpdateSourceTrigger=PropertyChanged}" 
                                            Margin="0,0,8,0"/>
                                
                                <hc:TextBox Grid.Column="2" hc:InfoElement.Title="حجم البيانات" 
                                            Text="{Binding NewPackageSize, UpdateSourceTrigger=PropertyChanged}" 
                                            Margin="0,0,8,0"/>
                                
                                <hc:TextBox Grid.Column="3" hc:InfoElement.Title="السعر" 
                                            Text="{Binding NewPackagePrice, UpdateSourceTrigger=PropertyChanged}" 
                                            Margin="0,0,8,0"/>

                                <Button Grid.Column="4" Content="إضافة باقة ➕" 
                                        Style="{DynamicResource PrimaryButtonStyle}" 
                                        Command="{Binding AddPackageCommand}" 
                                        VerticalAlignment="Bottom" Height="32" Padding="16,0"/>
                            </Grid>
                        </hc:Card>
                    </Grid>
                </TabItem>

                <!-- 5. Speed Options -->
                <TabItem Header="⚡ خيارات السرعة" IsEnabled="{Binding HasValidRouterConfig}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Speed Options DataGrid -->
                        <DataGrid Grid.Row="0" 
                                  ItemsSource="{Binding SpeedOptions}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  RowHeaderWidth="0"
                                  Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم المعروض (Label)" Binding="{Binding Label}" Width="3*"/>
                                <DataGridTextColumn Header="قيمة السرعة (Value)" Binding="{Binding Value}" Width="3*"/>
                                <DataGridTemplateColumn Header="افتراضي" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <RadioButton IsChecked="{Binding Selected}" 
                                                         HorizontalAlignment="Center" 
                                                         VerticalAlignment="Center"
                                                         Command="{Binding DataContext.SetSpeedDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="إجراءات" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="حذف 🗑️" 
                                                    Style="{DynamicResource SecondaryButtonStyle}" 
                                                    Command="{Binding DataContext.RemoveSpeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Padding="8,2" FontSize="11" Margin="2" Height="24"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Add Speed Form -->
                        <hc:Card Grid.Row="1" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <hc:TextBox Grid.Column="0" hc:InfoElement.Title="الاسم المعروض (مثال: سرعة فائقة)" 
                                            Text="{Binding NewSpeedLabel, UpdateSourceTrigger=PropertyChanged}" 
                                            Margin="0,0,8,0"/>

                                <hc:TextBox Grid.Column="1" hc:InfoElement.Title="القيمة بالروتر (مثال: 4M/8M)" 
                                            Text="{Binding NewSpeedValue, UpdateSourceTrigger=PropertyChanged}" 
                                            Margin="0,0,8,0"/>

                                <Button Grid.Column="2" Content="إضافة سرعة ➕" 
                                        Style="{DynamicResource PrimaryButtonStyle}" 
                                        Command="{Binding AddSpeedCommand}" 
                                        VerticalAlignment="Bottom" Height="32" Padding="16,0"/>
                            </Grid>
                        </hc:Card>
                    </Grid>
                </TabItem>

                <!-- 6. Sales Points & Offers -->
                <TabItem Header="🛒 العروض ونقاط البيع" IsEnabled="{Binding HasValidRouterConfig}">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Offers Section -->
                        <hc:Card Grid.Column="0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="العروض النشطة الحالية" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <hc:TextBox Text="{Binding Offers, UpdateSourceTrigger=PropertyChanged}" 
                                            AcceptsReturn="True" Height="150" TextWrapping="Wrap" 
                                            hc:InfoElement.Placeholder="أدخل العروض التي تريد عرضها للمشتركين هنا..."/>
                            </StackPanel>
                        </hc:Card>

                        <!-- Right: Sales Points Section -->
                        <hc:Card Grid.Column="2" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="نقاط ومراكز البيع" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryTextBrush}"/>

                                <ListBox Grid.Row="1" ItemsSource="{Binding SalesPoints}" Margin="0,0,0,12">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontSize="12.5"/>
                                                <Button Grid.Column="1" Content="حذف ✖" 
                                                        Style="{DynamicResource SecondaryButtonStyle}" 
                                                        Command="{Binding DataContext.RemoveSalesPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}"
                                                        Padding="8,2" FontSize="11" Height="24"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <hc:TextBox Grid.Column="0" 
                                                Text="{Binding NewSalesPoint, UpdateSourceTrigger=PropertyChanged}" 
                                                hc:InfoElement.Placeholder="أدخل اسم البقالة أو نقطة البيع..." 
                                                Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="إضافة ➕" 
                                            Style="{DynamicResource PrimaryButtonStyle}" 
                                            Command="{Binding AddSalesPointCommand}" 
                                            Height="32"/>
                                </Grid>
                            </Grid>
                        </hc:Card>
                    </Grid>
                </TabItem>

                <!-- 7. Support & Developer info -->
                <TabItem Header="📞 معلومات الدعم والمطور" IsEnabled="{Binding HasValidRouterConfig}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16" MaxWidth="700" HorizontalAlignment="Left" Width="700">
                            <hc:Card Padding="16">
                                <StackPanel>
                                    <TextBlock Text="تعديل معلومات التواصل للموقع" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    
                                    <hc:TextBox hc:InfoElement.Title="رقم الدعم الفني للشبكة" 
                                                Text="{Binding SupportPhone, UpdateSourceTrigger=PropertyChanged}" 
                                                Margin="0,0,0,12"/>
                                </StackPanel>
                            </hc:Card>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 8. Preview & Upload -->
                <TabItem Header="🌐 المعاينة والتحديث" IsEnabled="{Binding HasValidRouterConfig}">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Right: Actions and Status -->
                        <hc:Card Grid.Column="2" Padding="20">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="إجراءات المعاينة والتحديث" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>

                                <Button Content="🌐 معاينة صفحة تسجيل الدخول" 
                                        Style="{DynamicResource OutlineButtonStyle}" 
                                        Command="{Binding PreviewCommand}" 
                                        Height="45" FontSize="14" Margin="0,0,0,12"/>

                                <Button Content="⚡ تحديث البيانات فقط (config.js)" 
                                        Style="{DynamicResource PrimaryButtonStyle}" 
                                        Command="{Binding UploadConfigOnlyCommand}" 
                                        Height="45" FontSize="14" Margin="0,0,0,12"/>

                                <Button Content="🛒 شراء الصفحة الكاملة" 
                                        Style="{DynamicResource SecondaryButtonStyle}" 
                                        IsEnabled="False"
                                        Height="38" FontSize="13" Margin="0,0,0,20" Opacity="0.65"/>

                                <TextBlock Text="{Binding UploadStatus}" 
                                           HorizontalAlignment="Center" 
                                           FontSize="13" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource PrimaryBrush}" 
                                           Margin="0,0,0,12"/>

                                <!-- Progress bar -->
                                <StackPanel Visibility="{Binding IsUploading, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Value="{Binding UploadProgress}" Minimum="0" Maximum="100" Height="15" Margin="0,0,0,12"/>
                                    <Button Content="✖ إلغاء العملية" 
                                            Style="{DynamicResource DangerButtonStyle}" 
                                            Command="{Binding CancelUploadCommand}" 
                                            Height="32" Width="120" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </hc:Card>

                        <!-- Left: Connection Status Card -->
                        <hc:Card Grid.Column="0" Padding="20" Background="{DynamicResource SurfaceAltBrush}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="حالة اتصال الراوتر" FontSize="14" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="اسم الراوتر: " FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RouterName}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="عنوان IP: " FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RouterHost}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,12,0,0" Width="260">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <hc:TextBox Grid.Column="0" hc:InfoElement.Title="مجلد الروتر المستهدف" 
                                                Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" 
                                                hc:InfoElement.Placeholder="hotspot"
                                                Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="تغيير المجلد 📁" 
                                            Command="{Binding PickRouterFolderCommand}" 
                                            Style="{DynamicResource OutlineButtonStyle}"
                                            VerticalAlignment="Bottom" Height="32" Padding="8,0"/>
                                </Grid>

                                <TextBlock Text="ملاحظة: يتم حفظ المسار بشكل دائم ويُقرأ منه ملف التكوين (config.js) تلقائياً عند فتح البرنامج." 
                                           FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Width="260" Margin="0,8,0,0" Opacity="0.85"/>
                            </StackPanel>
                        </hc:Card>

                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</UserControl>
