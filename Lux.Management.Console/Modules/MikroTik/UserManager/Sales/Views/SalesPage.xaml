<UserControl x:Class="Lux.Management.Console.Modules.MikroTik.UserManager.Sales.Views.SalesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ══ Master Container ══ -->
    <Grid Background="{DynamicResource RegionBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: KPI Cards Section -->
                <RowDefinition Height="Auto"/> <!-- 1: Command Toolbar -->
                <RowDefinition Height="Auto"/> <!-- 2: Search and Date Filter Bar -->
                <RowDefinition Height="Auto"/> <!-- 3: Global Status and Sync Progress Banner -->
                <RowDefinition Height="*"/>    <!-- 4: DataGrid / Virtualized Grid Area -->
            </Grid.RowDefinitions>

            <!-- Row 0: KPI Cards Section (2 Rows of 4 Columns to prevent crowding) -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="16,8,16,4">
                <!-- Card 1: Today Sales -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,12,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="مبيعات اليوم" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding TodayRevenue, StringFormat={}{0:N0} ريال}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding TodayCount, StringFormat={}{0:N0} كرت}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="#1F10B981" VerticalAlignment="Center">
                            <TextBlock Text="📈" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2: Yesterday Sales -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,12,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="مبيعات أمس" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding YesterdayRevenue, StringFormat={}{0:N0} ريال}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding YesterdayCount, StringFormat={}{0:N0} كرت}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="#1F6366F1" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 3: Weekly Sales -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,12,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="مبيعات الأسبوع" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding WeeklyRevenue, StringFormat={}{0:N0} ريال}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding WeeklyCount, StringFormat={}{0:N0} كرت}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="#1FF59E0B" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 4: Monthly Sales -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="مبيعات الشهر" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding MonthlyRevenue, StringFormat={}{0:N0} ريال}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding MonthlyCount, StringFormat={}{0:N0} كرت}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="#1F8B5CF6" VerticalAlignment="Center">
                            <TextBlock Text="🗓️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 5: Total Sales -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="إجمالي المبيعات" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0} ريال}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding TotalCount, StringFormat={}{0:N0} كرت}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="#1FEC4899" VerticalAlignment="Center">
                            <TextBlock Text="💳" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 6: Best Profile Today -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="الأكثر مبيعاً اليوم" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding TodayBestProfile}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="#1F3B82F6" VerticalAlignment="Center">
                            <TextBlock Text="🏆" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 7: Best Profile Yesterday -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="الأكثر مبيعاً أمس" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding YesterdayBestProfile}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="#1F10B981" VerticalAlignment="Center">
                            <TextBlock Text="🏅" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 8: Unused Inventory -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="مخزون كروت غير مفعل" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding UnusedInventory, StringFormat={}{0:N0} كرت}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="#1F6B7280" VerticalAlignment="Center">
                            <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Row 1: Command Toolbar -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,4" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Button Content="تحديث البيانات  ↻" Command="{Binding RefreshCommand}" Style="{DynamicResource ButtonPrimary}" Height="28" Padding="12,0" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <Button Content="إعادة تعيين الفلاتر ↻" Command="{Binding ClearFilterCommand}" Style="{DynamicResource ButtonDefault}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="تفاصيل الكرت  📄" Command="{Binding ShowVoucherDetailsCommand}" Style="{DynamicResource ButtonDefault}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="🔄 مزامنة الراوتر: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RelativeLastSyncText}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text=" - " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding LastSyncTimeText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        
                        <TextBlock Text="📊 إجمالي النتائج: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding GlobalCount}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Date Picker, Navigation & Search Bar -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/> <!-- Search Box -->
                        <ColumnDefinition Width="Auto"/> <!-- Date Navigation Buttons -->
                        <ColumnDefinition Width="Auto"/> <!-- Date Picker -->
                        <ColumnDefinition Width="Auto"/> <!-- Status Filter -->
                        <ColumnDefinition Width="Auto"/> <!-- Profile Filter -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- Search Box -->
                    <hc:SearchBar Grid.Column="0" 
                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                  Height="32"
                                  hc:InfoElement.Placeholder="بحث برقم الكرت أو اسم الباقة..."
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>
                    
                    <!-- Date Navigation -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Button Content="السابق ◀" Command="{Binding SelectPreviousDayCommand}" Style="{DynamicResource ButtonDefault}" Height="32" Padding="10,0" Margin="0,0,4,0"/>
                        <Button Content="اليوم 📅" Command="{Binding SelectTodayCommand}" Style="{DynamicResource ButtonDefault}" Height="32" Padding="12,0" Margin="0,0,4,0"/>
                        <Button Content="التالي ▶" Command="{Binding SelectNextDayCommand}" Style="{DynamicResource ButtonDefault}" Height="32" Padding="10,0"/>
                    </StackPanel>

                    <!-- Date Picker -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="التاريخ:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker Language="ar" SelectedDate="{Binding SelectedDate}" Width="140" Height="32" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Status Filter -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="حالة الكرت:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="110" Height="32" SelectedValue="{Binding FilterStatus}" SelectedValuePath="Tag" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="الكل" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="نشط" Tag="active"/>
                            <ComboBoxItem Content="منتهي" Tag="expired"/>
                            <ComboBoxItem Content="موقوف مؤقتاً" Tag="paused"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Profile Filter -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="الباقة:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="130" Height="32" ItemsSource="{Binding ProfileFilters}" SelectedItem="{Binding FilterProfile}" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 3: Loading Banner -->
            <Border Grid.Row="3" Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Panel.ZIndex="10" Padding="16,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusBannerVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusBannerMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <hc:LoadingCircle Grid.Column="1" Width="12" Height="12" Foreground="White" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Row 4: DataGrid / Main Workspace Area -->
            <Grid Grid.Row="4" Background="{DynamicResource WindowBackgroundBrush}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <!-- DataGrid Container -->
                <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Margin="16,8,16,16" Background="{StaticResource SurfaceBrush}">
                    <DataGrid x:Name="SalesDataGrid" 
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch"
                              RowHeight="30"
                              ItemsSource="{Binding SalesRecords}" 
                              SelectedItem="{Binding SelectedRecord}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              hc:DataGridAttach.ShowRowNumber="True"
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False"
                              AlternationCount="2"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.ScrollChanged="SalesDataGrid_ScrollChanged">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                                
                        <DataGrid.Resources>
                            <Style x:Key="CenterTextBlockStyle" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                              
                        <DataGrid.Columns>
                            <!-- 1. تاريخ التفعيل (المبيعات) -->
                            <DataGridTextColumn Header="تاريخ التفعيل الأول" Binding="{Binding ActivationDateText}" Width="1.8*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                            <!-- 2. كود الكرت -->
                            <DataGridTextColumn Header="كود الكرت" Binding="{Binding VoucherCode}" Width="2*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                            <!-- 3. الباقة -->
                            <DataGridTextColumn Header="الباقة" Binding="{Binding ProfileName}" Width="1.5*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                            <!-- 4. السعر -->
                            <DataGridTextColumn Header="السعر" Binding="{Binding PriceText}" Width="1.2*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                            <!-- 5. الحالة -->
                            <DataGridTemplateColumn Header="الحالة" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EffectiveState}" Value="1">
                                                            <Setter Property="Foreground" Value="#FF1E88E5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EffectiveState}" Value="2">
                                                            <Setter Property="Foreground" Value="#FFEF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFD97706"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 6. Uptime المستهلك -->
                            <DataGridTextColumn Header="الوقت المستهلك" Binding="{Binding UptimeUsedText}" Width="1.3*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                            <!-- 7. التحميل المستهلك -->
                            <DataGridTextColumn Header="التحميل" Binding="{Binding DownloadUsedText}" Width="1.2*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                            <!-- 8. الرفع المستهلك -->
                            <DataGridTextColumn Header="الرفع" Binding="{Binding UploadUsedText}" Width="1.2*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                            <!-- 9. آخر ظهور -->
                            <DataGridTextColumn Header="آخر ظهور للكرت" Binding="{Binding LastSeenText}" Width="1.8*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Empty State Overlay -->
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GlobalCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📈" FontSize="48" Opacity="0.4" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="لا توجد مبيعات في هذا التاريخ أو الفلتر" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="تأكد من تاريخ التفعيل المختار أو قم بتغيير الفلاتر للبحث." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Loading More Indicator Overlay (Infinite Scrolling) -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                        Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="18" 
                        Padding="14,6" 
                        Margin="0,0,0,32" 
                        Panel.ZIndex="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Color="Black"/>
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingMore}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <hc:LoadingCircle Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="جارٍ تحميل المزيد من سجلات المبيعات..." FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
