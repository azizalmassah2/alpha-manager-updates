<Window x:Class="Lux.Management.Console.Modules.MikroTik.UserManager.Printing.Views.Dialogs.NewTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="إنشاء قالب جديد" 
        Height="260" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Border CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="إنشاء قالب جديد" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,16"/>

            <!-- Inputs -->
            <StackPanel Grid.Row="1">
                <!-- Name Field -->
                <TextBlock Text="اسم القالب الجديد (ضروري):" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtTemplateName" Height="34" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,6" VerticalContentAlignment="Center" MaxLength="50" Margin="0,0,0,12"/>

                <!-- Profile Field -->
                <TextBlock Text="الباقة المرتبطة (اختياري):" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                <ComboBox x:Name="CboProfiles" Height="34" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="حفظ" Click="BtnSave_Click" Style="{StaticResource PrimaryButtonStyle}" Width="100" Height="34" Margin="0,0,8,0"/>
                <Button Content="إلغاء" Click="BtnCancel_Click" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="34"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
