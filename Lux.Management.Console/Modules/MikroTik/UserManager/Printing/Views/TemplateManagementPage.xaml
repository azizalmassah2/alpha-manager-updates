<UserControl x:Class="Lux.Management.Console.Modules.MikroTik.UserManager.Printing.Views.TemplateManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Lux.Management.Console.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             FlowDirection="RightToLeft"
             Background="{DynamicResource RegionBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:MathConverter x:Key="MathConverter"/>
        <converters:DoubleToThicknessConverter x:Key="DoubleToThicknessConverter"/>
        <converters:XYToMarginConverter x:Key="XYToMarginConverter"/>
        <converters:CardSizeConverter x:Key="CardSizeConverter"/>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>

        <!-- Section title style -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Label above field -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Compact TextBox -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <TextBlock x:Name="HintText"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"
                                           Opacity="0.5"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="HintText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="HintText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Spinner control (minus/value/plus) reusable style -->
        <Style x:Key="SpinnerBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Color picker button style -->
        <Style x:Key="ColorPickerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Root grid: 3 rows — toolbar | info bar | workspace -->
    <Grid Margin="12,10,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Template selector toolbar -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: Template info (full width) -->
            <RowDefinition Height="*"/>     <!-- Row 2: Side panel + Preview -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 0 — Template Selection Toolbar
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10,7" Margin="0,0,0,8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180"/>   <!-- Template selector -->
                    <ColumnDefinition Width="Auto"/>               <!-- New -->
                    <ColumnDefinition Width="Auto"/>               <!-- Compress toggle -->
                    <ColumnDefinition Width="Auto"/>               <!-- Preview -->
                    <ColumnDefinition Width="Auto"/>               <!-- Save -->
                    <ColumnDefinition Width="Auto"/>               <!-- Delete -->
                </Grid.ColumnDefinitions>

                <!-- Template ComboBox -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="القالب النشط الحالي:" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              DisplayMemberPath="Name"
                              Height="32"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"
                              ToolTip="{Binding SelectedTemplate.Name}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="قالب جديد"
                        Command="{Binding AddNewCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,6,0" Padding="14,4" Height="32" VerticalAlignment="Bottom"/>

                <!-- Compress toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"
                            Margin="4,0,10,1" FlowDirection="LeftToRight">
                    <TextBlock Text="ضغط" VerticalAlignment="Center"
                               Foreground="#FCD34D" FontSize="11" FontWeight="SemiBold"
                               Margin="0,0,4,0" FlowDirection="RightToLeft"/>
                    <ToggleButton IsChecked="{Binding CompressOutput}"
                                  Style="{DynamicResource ToggleButtonSwitch}"
                                  VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="3" Content="📄 معاينة"
                        Command="{Binding PreviewTemplateCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Foreground="#60A5FA" BorderBrush="#60A5FA"
                        Margin="0,0,6,0" Padding="14,4" Height="32" VerticalAlignment="Bottom"/>

                <Button Grid.Column="4" Content="حفظ"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,6,0" Padding="14,4" Height="32" VerticalAlignment="Bottom"/>

                <Button Grid.Column="5" Content="حذف"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Foreground="#F87171" BorderBrush="#F87171"
                        Padding="14,4" Height="32" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 1 — Template Info Bar (full width, 2 rows of fields)
             All fields span full width so paths never clip
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10,8"
                Margin="0,0,0,8"
                DataContext="{Binding SelectedTemplate}"
                Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel>
                <!-- Sub-row A: Name | Profile | IsDefault -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="120"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="2*" MinWidth="140"/>
                        <ColumnDefinition Width="10"/>
                        <!-- Font family -->
                        <ColumnDefinition Width="1.4*" MinWidth="110"/>
                        <ColumnDefinition Width="10"/>
                        <!-- Font size + bold + italic -->
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <!-- IsDefault -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Name -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="اسم القالب:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Tag="اسم القالب"
                                 ToolTip="{Binding Name}"/>
                    </StackPanel>

                    <!-- Profile -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="الباقة المرتبطة (اختياري):" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding DataContext.AvailableProfiles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding LinkedProfileName}"
                                  Height="30"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1"
                                  ToolTip="{Binding LinkedProfileName}"/>
                    </StackPanel>

                    <!-- Font Family -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="نوع الخط:" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox Text="{Binding FontFamily}"
                                  Height="30"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1"
                                  ToolTip="{Binding FontFamily}">
                            <ComboBoxItem Content="Arial"/>
                            <ComboBoxItem Content="Tahoma"/>
                            <ComboBoxItem Content="Segoe UI"/>
                            <ComboBoxItem Content="Times New Roman"/>
                            <ComboBoxItem Content="Calibri"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Font Size -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="حجم:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding FontSize}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Bold -->
                    <StackPanel Grid.Column="8" VerticalAlignment="Bottom" Margin="0,0,0,5">
                        <TextBlock Text="غامق" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding IsBold}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Italic -->
                    <StackPanel Grid.Column="10" VerticalAlignment="Bottom" Margin="0,0,0,5">
                        <TextBlock Text="مائل" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding IsItalic}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- IsDefault -->
                    <CheckBox Grid.Column="12"
                              Content="قالب افتراضي"
                              IsChecked="{Binding IsDefault}"
                              Foreground="{DynamicResource PrimaryBrush}"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,5"/>
                </Grid>

                <!-- Sub-row B: Background path | Logo path | Font Color | Frame Color -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="120"/>  <!-- background path -->
                        <ColumnDefinition Width="Auto"/>               <!-- browse bg -->
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="3*" MinWidth="120"/>  <!-- logo path -->
                        <ColumnDefinition Width="Auto"/>               <!-- browse logo -->
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.5*" MinWidth="100"/> <!-- font color -->
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.5*" MinWidth="100"/> <!-- frame color -->
                    </Grid.ColumnDefinitions>

                    <!-- Background path -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="مسار خلفية الكرت:" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Height="30" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Background="{DynamicResource SurfaceBrush}"
                                ToolTip="{Binding BackgroundImagePath}">
                            <TextBlock Text="{Binding BackgroundImagePath}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="6,0"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="📁 استعراض..."
                            Command="{Binding DataContext.BrowseBackgroundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="4,16,0,0" Height="30" Padding="8,0" FontSize="11"
                            ToolTip="اختر صورة خلفية الكرت"/>

                    <!-- Logo path -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="مسار شعار الشبكة:" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Height="30" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Background="{DynamicResource SurfaceBrush}"
                                ToolTip="{Binding LogoImagePath}">
                            <TextBlock Text="{Binding LogoImagePath}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="6,0"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="4"
                            Content="📁 استعراض..."
                            Command="{Binding DataContext.BrowseLogoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="4,16,0,0" Height="30" Padding="8,0" FontSize="11"
                            ToolTip="اختر صورة الشعار"/>

                    <!-- Font Color -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="لون الخط:" Style="{StaticResource FieldLabelStyle}"/>
                        <Button Click="BtnFontColor_Click" Style="{StaticResource ColorPickerButtonStyle}"
                                ToolTip="{Binding FontColorHex}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="16" Height="16" CornerRadius="3"
                                        BorderThickness="1" BorderBrush="#666"
                                        Background="{Binding FontColorHex, Converter={StaticResource HexToBrushConverter}}"
                                        Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FontColorHex}"
                                           VerticalAlignment="Center"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Frame Color -->
                    <StackPanel Grid.Column="8">
                        <TextBlock Text="لون إطار الكرت:" Style="{StaticResource FieldLabelStyle}"/>
                        <Button Click="BtnFrameColor_Click" Style="{StaticResource ColorPickerButtonStyle}"
                                ToolTip="{Binding FrameColorHex}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="16" Height="16" CornerRadius="3"
                                        BorderThickness="1" BorderBrush="#666"
                                        Background="{Binding FrameColorHex, Converter={StaticResource HexToBrushConverter}}"
                                        Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FrameColorHex}"
                                           VerticalAlignment="Center"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 2 — Main workspace: Side Panel (260px) | Preview (*)
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2"
              Visibility="{Binding SelectedTemplate, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>  <!-- Side control panel -->
                <ColumnDefinition Width="8"/>    <!-- Gutter -->
                <ColumnDefinition Width="*"/>    <!-- Preview - gets ALL remaining space -->
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────────────────────────────────
                 SIDE PANEL — Elements toggles + X/Y position + Dimensions (Expander)
                 ───────────────────────────────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>    <!-- Scrollable controls -->
                        <RowDefinition Height="Auto"/> <!-- Fixed footer: card count -->
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,10,10,4">
                        <StackPanel DataContext="{Binding SelectedTemplate}">

                        <!-- ── Voucher Elements ── -->
                        <TextBlock Text="عناصر الكرت" Style="{StaticResource SectionTitleStyle}"/>
                        <UniformGrid Columns="3" Margin="0,0,0,4">
                            <StackPanel Margin="1,0,1,6" HorizontalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ShowUsername}"
                                              Style="{DynamicResource ToggleButtonSwitch}" Cursor="Hand"/>
                                <TextBlock Text="رمز الدخول" FontSize="9.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="1,0,1,6" HorizontalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ShowPassword}"
                                              Style="{DynamicResource ToggleButtonSwitch}" Cursor="Hand"/>
                                <TextBlock Text="كلمة السر" FontSize="9.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="1,0,1,6" HorizontalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ShowSerialNumber}"
                                              Style="{DynamicResource ToggleButtonSwitch}" Cursor="Hand"/>
                                <TextBlock Text="تسلسلي" FontSize="9.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="1,0,1,6" HorizontalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ShowPrintDate}"
                                              Style="{DynamicResource ToggleButtonSwitch}" Cursor="Hand"/>
                                <TextBlock Text="تاريخ طبع" FontSize="9.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="1,0,1,6" HorizontalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ShowPrice}"
                                              Style="{DynamicResource ToggleButtonSwitch}" Cursor="Hand"/>
                                <TextBlock Text="السعر" FontSize="9.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="1,0,1,6" HorizontalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ShowQr}"
                                              Style="{DynamicResource ToggleButtonSwitch}" Cursor="Hand"/>
                                <TextBlock Text="QR Code" FontSize="9.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="1,0,1,6" HorizontalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ShowValidity}"
                                              Style="{DynamicResource ToggleButtonSwitch}" Cursor="Hand"/>
                                <TextBlock Text="الصلاحية" FontSize="9.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="1,0,1,6" HorizontalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ShowTime}"
                                              Style="{DynamicResource ToggleButtonSwitch}" Cursor="Hand"/>
                                <TextBlock Text="الوقت" FontSize="9.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="1,0,1,6" HorizontalAlignment="Center">
                                <ToggleButton IsChecked="{Binding ShowBarcode}"
                                              Style="{DynamicResource ToggleButtonSwitch}" Cursor="Hand"/>
                                <TextBlock Text="باركود" FontSize="9.5" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>

                        <Separator Margin="0,2,0,8" Background="{DynamicResource BorderBrush}"/>

                        <!-- ── Element Position (X/Y) ── -->
                        <TextBlock Text="موقع العنصر المحدد" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="X:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12" FontWeight="SemiBold"/>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="−" Click="BtnActiveXDown_Click"
                                            Background="{DynamicResource SurfaceBrush}"
                                            Foreground="{DynamicResource PrimaryBrush}"
                                            BorderThickness="0" Cursor="Hand" Padding="8,3"/>
                                    <TextBox Grid.Column="1" x:Name="TxtActiveX" Text="0"
                                             IsReadOnly="True" TextAlignment="Center"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" FontSize="12"
                                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Button Grid.Column="2" Content="+" Click="BtnActiveXUp_Click"
                                            Background="{DynamicResource SurfaceBrush}"
                                            Foreground="{DynamicResource PrimaryBrush}"
                                            BorderThickness="0" Cursor="Hand" Padding="8,3"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Y:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12" FontWeight="SemiBold"/>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="−" Click="BtnActiveYDown_Click"
                                            Background="{DynamicResource SurfaceBrush}"
                                            Foreground="{DynamicResource PrimaryBrush}"
                                            BorderThickness="0" Cursor="Hand" Padding="8,3"/>
                                    <TextBox Grid.Column="1" x:Name="TxtActiveY" Text="0"
                                             IsReadOnly="True" TextAlignment="Center"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" FontSize="12"
                                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Button Grid.Column="2" Content="+" Click="BtnActiveYUp_Click"
                                            Background="{DynamicResource SurfaceBrush}"
                                            Foreground="{DynamicResource PrimaryBrush}"
                                            BorderThickness="0" Cursor="Hand" Padding="8,3"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Separator Margin="0,8,0,0" Background="{DynamicResource BorderBrush}"/>

                        <!-- ── Card Dimensions (collapsible Expander) ── -->
                        <Expander Header="أبعاد وإطار الكرت" IsExpanded="False"
                                  Foreground="{DynamicResource PrimaryBrush}"
                                  FontSize="11" FontWeight="SemiBold"
                                  Margin="0,4,0,0">
                            <StackPanel Margin="0,8,0,0">

                                <!-- Rows (Card Height) -->
                                <TextBlock Text="طول الكرت (صفوف):"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10.5" Margin="0,0,0,2"/>
                                <Border Style="{StaticResource SpinnerBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="−" Click="BtnRowDown_Click"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                BorderThickness="0" Cursor="Hand" Padding="8,3"/>
                                        <TextBox Grid.Column="1" Text="{Binding Rows}"
                                                 IsReadOnly="True" TextAlignment="Center"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalAlignment="Center" FontSize="12"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <Button Grid.Column="2" Content="+" Click="BtnRowUp_Click"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                BorderThickness="0" Cursor="Hand" Padding="8,3"/>
                                    </Grid>
                                </Border>

                                <!-- Columns (Card Width) -->
                                <TextBlock Text="عرض الكرت (أعمدة):"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10.5" Margin="0,0,0,2"/>
                                <Border Style="{StaticResource SpinnerBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="−" Click="BtnColDown_Click"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                BorderThickness="0" Cursor="Hand" Padding="8,3"/>
                                        <TextBox Grid.Column="1" Text="{Binding Columns}"
                                                 IsReadOnly="True" TextAlignment="Center"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalAlignment="Center" FontSize="12"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <Button Grid.Column="2" Content="+" Click="BtnColUp_Click"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                BorderThickness="0" Cursor="Hand" Padding="8,3"/>
                                    </Grid>
                                </Border>

                                <!-- Margins -->
                                <TextBlock Text="هامش أفقي:"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10.5" Margin="0,0,0,2"/>
                                <Border Style="{StaticResource SpinnerBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="−" Click="BtnMarginXDown_Click"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                BorderThickness="0" Cursor="Hand" Padding="8,3"/>
                                        <TextBox Grid.Column="1" Text="{Binding MarginX}"
                                                 IsReadOnly="True" TextAlignment="Center"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalAlignment="Center" FontSize="12"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <Button Grid.Column="2" Content="+" Click="BtnMarginXUp_Click"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                BorderThickness="0" Cursor="Hand" Padding="8,3"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="هامش رأسي:"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10.5" Margin="0,0,0,2"/>
                                <Border Style="{StaticResource SpinnerBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="−" Click="BtnMarginYDown_Click"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                BorderThickness="0" Cursor="Hand" Padding="8,3"/>
                                        <TextBox Grid.Column="1" Text="{Binding MarginY}"
                                                 IsReadOnly="True" TextAlignment="Center"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalAlignment="Center" FontSize="12"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <Button Grid.Column="2" Content="+" Click="BtnMarginYUp_Click"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource PrimaryBrush}"
                                                BorderThickness="0" Cursor="Hand" Padding="8,3"/>
                                    </Grid>
                                </Border>

                                <!-- Frame size -->
                                <TextBlock Text="سماكة الإطار (px):"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10.5" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding FrameSize}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Margin="0,0,0,8"
                                         ToolTip="سماكة إطار الكرت بالبيكسل"/>

                                <!-- Frame Color inside expander too -->
                                <TextBlock Text="لون الإطار:"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10.5" Margin="0,0,0,2"/>
                                <Button Click="BtnFrameColor_Click"
                                        Style="{StaticResource ColorPickerButtonStyle}"
                                        Margin="0,0,0,4"
                                        ToolTip="{Binding FrameColorHex}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="16" Height="16" CornerRadius="3"
                                                BorderThickness="1" BorderBrush="#666"
                                                Background="{Binding FrameColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FrameColorHex}"
                                                   VerticalAlignment="Center"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>

                <!-- ── Total Cards — Fixed footer, always visible ── -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8"
                        Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="إجمالي كروت الصفحة"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="12"
                                Padding="12,4">
                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="White">
                                <Run Text="{Binding DataContext.PreviewCards.Count, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Run Text=" كرت" FontSize="11" FontWeight="Normal"/>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>
                </Grid>
            </Border>

            <!-- ─────────────────────────────────────────────────────────
                 PREVIEW — takes ALL remaining horizontal space
                 ───────────────────────────────────────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8"
                        ClipToBounds="True"
                        DataContext="{Binding SelectedTemplate}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Viewbox Margin="12" Stretch="Uniform"
                                 StretchDirection="Both"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Border BorderBrush="{Binding FrameColorHex}"
                                    BorderThickness="{Binding FrameSize, Converter={StaticResource DoubleToThicknessConverter}, ConverterParameter=2}"
                                    Background="White">
                                <!-- Card canvas size = paper / grid cells × 15 px/mm -->
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource CardSizeConverter}" ConverterParameter="15.0">
                                        <Binding Source="210.0"/>
                                        <Binding Path="Columns"/>
                                        <Binding Path="MarginX"/>
                                    </MultiBinding>
                                </Border.Width>
                                <Border.Height>
                                    <MultiBinding Converter="{StaticResource CardSizeConverter}" ConverterParameter="15.0">
                                        <Binding Source="297.0"/>
                                        <Binding Path="Rows"/>
                                        <Binding Path="MarginY"/>
                                    </MultiBinding>
                                </Border.Height>
                                <Grid ClipToBounds="True">
                                    <!-- Background image -->
                                    <Image Source="{Binding BackgroundImagePath}" Stretch="Fill"/>
                                    <!-- Logo -->
                                    <Image Source="{Binding LogoImagePath}"
                                           Width="150" Height="150"
                                           Margin="16"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <!-- Draggable elements canvas -->
                                    <Canvas>
                                        <!-- Username -->
                                        <Thumb x:Name="ThumbUsername"
                                               DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"
                                               Tag="Username"
                                               Visibility="{Binding ShowUsername, Converter={StaticResource BoolToVis}}"
                                               Canvas.Left="{Binding UsernameX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}"
                                               Canvas.Top="{Binding UsernameY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="123456789"
                                                           Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*12, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Cursor="SizeAll"/>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <!-- Password -->
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"
                                               Tag="Password"
                                               Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}"
                                               Canvas.Left="{Binding PasswordX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}"
                                               Canvas.Top="{Binding PasswordY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="12345678"
                                                           Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*12, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Cursor="SizeAll"/>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <!-- QR Code -->
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"
                                               Tag="Qr"
                                               Visibility="{Binding ShowQr, Converter={StaticResource BoolToVis}}"
                                               Canvas.Left="{Binding QrX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}"
                                               Canvas.Top="{Binding QrY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}">
                                            <Thumb.Template><ControlTemplate>
                                                <Border Background="#1E293B" CornerRadius="2" Cursor="SizeAll"
                                                        Width="{Binding DataContext.SelectedTemplate.QrSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Height="{Binding DataContext.SelectedTemplate.QrSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <!-- Price -->
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"
                                               Tag="Price"
                                               Visibility="{Binding ShowPrice, Converter={StaticResource BoolToVis}}"
                                               Canvas.Left="{Binding PriceX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}"
                                               Canvas.Top="{Binding PriceY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="1000 YER"
                                                           Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*12, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Cursor="SizeAll"/>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <!-- Validity -->
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"
                                               Tag="Validity"
                                               Visibility="{Binding ShowValidity, Converter={StaticResource BoolToVis}}"
                                               Canvas.Left="{Binding ValidityX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}"
                                               Canvas.Top="{Binding ValidityY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="30 Days"
                                                           Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*12, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Cursor="SizeAll"/>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <!-- Time -->
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"
                                               Tag="Time"
                                               Visibility="{Binding ShowTime, Converter={StaticResource BoolToVis}}"
                                               Canvas.Left="{Binding TimeX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}"
                                               Canvas.Top="{Binding TimeY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="10 GB"
                                                           Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*12, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Cursor="SizeAll"/>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <!-- Serial Number -->
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"
                                               Tag="SerialNumber"
                                               Visibility="{Binding ShowSerialNumber, Converter={StaticResource BoolToVis}}"
                                               Canvas.Left="{Binding SerialNumberX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}"
                                               Canvas.Top="{Binding SerialNumberY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="SN-12345"
                                                           Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*12, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Cursor="SizeAll"/>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <!-- Print Date -->
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"
                                               Tag="PrintDate"
                                               Visibility="{Binding ShowPrintDate, Converter={StaticResource BoolToVis}}"
                                               Canvas.Left="{Binding PrintDateX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}"
                                               Canvas.Top="{Binding PrintDateY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="2026/05/07"
                                                           Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*12, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Cursor="SizeAll"/>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <!-- Barcode -->
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"
                                               Tag="Barcode"
                                               Visibility="{Binding ShowBarcode, Converter={StaticResource BoolToVis}}"
                                               Canvas.Left="{Binding BarcodeX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}"
                                               Canvas.Top="{Binding BarcodeY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0}">
                                            <Thumb.Template><ControlTemplate>
                                                <Border Background="#333" CornerRadius="1" Cursor="SizeAll"
                                                        Width="300"
                                                        Height="{Binding DataContext.SelectedTemplate.BarcodeSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*15.0, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Viewbox>
                    </ScrollViewer>
                </Border>
            </Border>
        </Grid>

        <!-- Busy Overlay -->
        <Grid Grid.RowSpan="3" Background="#AA000000"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳ جارٍ التحميل..." FontSize="20" Foreground="White"
                           HorizontalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
