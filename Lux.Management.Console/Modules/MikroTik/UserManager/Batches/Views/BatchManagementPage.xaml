<UserControl x:Class="Lux.Management.Console.Modules.MikroTik.UserManager.Batches.Views.BatchManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Lux.Management.Console.Converters"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1280"
             FlowDirection="RightToLeft"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:NullToVisibilityConverter x:Key="NullToVis"/>

            <!-- Compact DataGrid Cell Style (Reduced font by 1.5pt, zero vertical cropping) -->
            <Style x:Key="CompactDataGridCellStyle" TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4,1"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Compact DataGrid Header Style (Reduced font by 1.5pt) -->
            <Style x:Key="CompactDataGridHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <!-- Custom Compact DataGrid Style -->
            <Style x:Key="CompactDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource HighDensityDataGridStyle}">
                <Setter Property="CellStyle" Value="{StaticResource CompactDataGridCellStyle}"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource CompactDataGridHeaderStyle}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- High-Density Main Grid (Fits 100% on screen without scrollbar) -->
    <Grid Margin="10,4,10,6">
        <Grid.RowDefinitions>
            <!-- Row 0: Page Title & Subtitle Header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Selected Batch Dashboard Card -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Action Buttons & Filter/Search Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Batches Table (قائمة الدفعات) -->
            <RowDefinition Height="1.2*"/>
            <!-- Row 4: Selected Batch Vouchers Details Section (كروت الدفعة المحددة) -->
            <RowDefinition Height="1.5*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!-- ROW 0: COMPACT PAGE HEADER                                           -->
        <!-- ════════════════════════════════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="إدارة الدفعات (Batch Management)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text=" — إنشاء، مزامنة، طباعة، وإدارة دفعات الكروت" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!-- ROW 1: ULTRA-COMPACT DASHBOARD CARD (معلومات الدفعة المحددة)        -->
        <!-- ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,4"
                Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Metrics Top Row -->
                    <RowDefinition Height="Auto"/> <!-- Metrics Counters Cards -->
                </Grid.RowDefinitions>

                <!-- Top Metrics Row -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <!-- Col 0: Title & Circular Gauge -->
                        <ColumnDefinition Width="170"/>
                        <!-- Col 1: Metrics Badges -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Gauge Stack -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Gauge -->
                        <Grid Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Border Width="38" Height="38" CornerRadius="19" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="4" Opacity="0.85"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SelectedBatch.SyncSuccessPercent, Mode=OneWay, StringFormat=\{0:F0\}%, FallbackValue=15%}"
                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="معلومات الدفعة" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="التقدم الكلي" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Metric Badges -->
                    <UniformGrid Grid.Column="1" Columns="4" VerticalAlignment="Center">
                        <!-- الباقة -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="6,3" Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="الباقة: " FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedBatch.ProfileName, FallbackValue='باقة 100 جيجا'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- الراوتر -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="6,3" Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="الراوتر: " FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedBatch.RouterName, FallbackValue='MikroTik-01'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- الحالة -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="6,3" Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="الحالة: " FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,4,0"/>
                                <Border Background="#DBEAFE" CornerRadius="8" Padding="6,1">
                                    <TextBlock Text="{Binding SelectedBatch.SyncStatusText, FallbackValue='جار المزامنة'}" FontSize="8.5" FontWeight="Bold" Foreground="#1E40AF"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- رقم الدفعة -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="6,3" Margin="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="رقم الدفعة: " FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding SelectedBatch.Name, FallbackValue='B-20260803-001'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>

                <!-- Middle Metrics Counters Cards Row (7 Compact Pillars) -->
                <UniformGrid Grid.Row="1" Columns="7">
                    <!-- آخر نشاط -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="4,2" Margin="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="آخر نشاط" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedBatch.AgeText, FallbackValue='منذ 2 دقيقة'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- تم الطباعة -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="4,2" Margin="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="تم الطباعة" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedBatch.PrintedCards, FallbackValue='0 كرت'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- إجمالي الكروت -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="4,2" Margin="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="إجمالي الكروت" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedBatch.TotalCards, FallbackValue='100 كرت'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- تمت المزامنة -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="4,2" Margin="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="تمت المزامنة" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedBatch.SyncedCards, FallbackValue='15 كرت'}" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- المتبقي -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="4,2" Margin="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="المتبقي" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedBatch.PendingCards, FallbackValue='85 كرت'}" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- نموذج الطباعة -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="4,2" Margin="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="نموذج الطباعة" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="📄 افتراضي" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- الملف PDF -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="4,2" Margin="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="الملف PDF" FontSize="8.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="🔴 لم ينشأ بعد" FontSize="8.5" FontWeight="Bold" Foreground="#991B1B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!-- ROW 2: ACTION BUTTONS & FILTER SEARCH TOOLBAR                         -->
        <!-- ════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <!-- Left (Buttons) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Right (Search & Filters) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Action Buttons Cluster -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Command="{Binding SyncBatchCommand}" CommandParameter="{Binding SelectedBatch}"
                        Content="🔄  مزامنة" Style="{StaticResource PrimaryButtonStyle}" Height="26" Padding="10,0" FontSize="11" Margin="0,0,4,0"/>

                <Button Command="{Binding ResumeSyncCommand}" CommandParameter="{Binding SelectedBatch}"
                        Content="▶  استكمال سنة" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="8,0" FontSize="11" Margin="0,0,4,0"/>

                <Button Command="{Binding RetryFailedCommand}" CommandParameter="{Binding SelectedBatch}"
                        Content="⟳  إعادة المحاولة" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="8,0" FontSize="11" Margin="0,0,4,0"/>

                <Button Command="{Binding ReprintBatchCommand}" CommandParameter="{Binding SelectedBatch}"
                        Content="🔁  إعادة الطباعة" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="8,0" FontSize="11" Margin="0,0,4,0"/>

                <Button Command="{Binding PrintBatchCommand}" CommandParameter="{Binding SelectedBatch}"
                        Content="🖨️  إنشاء PDF" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="8,0" FontSize="11" Margin="0,0,4,0"/>
            </StackPanel>

            <!-- Search & Filters -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                <TextBox Width="180" Height="26" FontSize="11"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,1" VerticalContentAlignment="Center"/>

                <ComboBox Width="100" Height="26" FontSize="11" Margin="4,0,0,0" SelectedIndex="0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="كل الحالات"/>
                    <ComboBoxItem Content="مكتملة"/>
                    <ComboBoxItem Content="جاري المزامنة"/>
                    <ComboBoxItem Content="فشلت"/>
                </ComboBox>

                <Button Content="🔻 تصدير" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="8,0" FontSize="11" Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!-- ROW 3: BATCHES DATAGRID TABLE (قائمة الدفعات)                        -->
        <!-- ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="6,4"
                Margin="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,3">
                    <TextBlock Text="قائمة الدفعات" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" DockPanel.Dock="Right"/>
                    <TextBlock Text="عرض 1-1 من 5 دفعات" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left" DockPanel.Dock="Left"/>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Batches}"
                          SelectedItem="{Binding SelectedBatch}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="32"
                          Style="{StaticResource CompactDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding Name}" Width="1.5*"/>
                        <!-- الراوتر column hidden as requested -->
                        <DataGridTextColumn Header="الباقة" Binding="{Binding ProfileName}" Width="1.2*"/>

                        <!-- الحالة Badge (reduced font size) -->
                        <DataGridTemplateColumn Header="الحالة" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#DBEAFE" CornerRadius="8" Padding="6,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SyncStatusText}" FontSize="8.5" FontWeight="Bold" Foreground="#1E40AF"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- التقدم ProgressBar (reduced font size) -->
                        <DataGridTemplateColumn Header="التقدم" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ProgressBar Value="{Binding SyncSuccessPercent, Mode=OneWay}" Maximum="100" Width="35" Height="5" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding SyncSuccessPercent, Mode=OneWay, StringFormat=\{0:F0\}%}" FontSize="8.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="تمت المزامنة" Binding="{Binding SyncedCards}" Width="85"/>
                        <DataGridTextColumn Header="تمت الطباعة" Binding="{Binding PrintedCards}" Width="85"/>
                        <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAt, StringFormat=\{0:dd-MM-yyyy HH:mm\}}" Width="120"/>
                        <!-- آخر نشاط column hidden as requested -->

                        <!-- إجراءات الملونة الموسعة -->
                        <DataGridTemplateColumn Header="إجراءات" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.SyncBatchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                ToolTip="مزامنة الدفعة" Background="#EFF6FF" BorderBrush="#3B82F6" Foreground="#1D4ED8" Width="26" Height="22" Padding="0" Margin="0,0,3,0">
                                            <TextBlock Text="🔄" FontSize="10"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.PrintBatchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                ToolTip="طباعة PDF" Background="#ECFDF5" BorderBrush="#10B981" Foreground="#047857" Width="26" Height="22" Padding="0" Margin="0,0,3,0">
                                            <TextBlock Text="🖨️" FontSize="10"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteBatchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                ToolTip="حذف الدفعة" Background="#FEF2F2" BorderBrush="#EF4444" Foreground="#B91C1C" Width="26" Height="22" Padding="0">
                                            <TextBlock Text="🗑️" FontSize="10"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════════ -->
        <!-- ROW 4: SELECTED BATCH VOUCHERS DETAILS SECTION                       -->
        <!-- ════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="6,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,3">
                    <TextBlock Text="{Binding SelectedBatch.Name, StringFormat='كروت الدفعة المحددة ({0})', FallbackValue='كروت الدفعة المحددة'}"
                               FontWeight="Bold" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" DockPanel.Dock="Right"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="🟢 تمت المزامنة: 15  |  " FontSize="9.5" Foreground="#10B981"/>
                        <TextBlock Text="🟠 في انتظار المزامنة: 85  |  " FontSize="9.5" Foreground="#F59E0B"/>
                        <TextBlock Text="🔴 فشلت: 0" FontSize="9.5" Foreground="#EF4444"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Right Side: Vouchers DataGrid Table -->
                        <ColumnDefinition Width="*"/>
                        <!-- Left Side: Batch Info Side Panel -->
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>

                    <!-- Main Vouchers Table -->
                    <Grid Grid.Column="0" Margin="0,0,6,0">
                        <DataGrid ItemsSource="{Binding SelectedBatchVouchers}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  RowHeight="30"
                                  Style="{StaticResource CompactDataGridStyle}">
                            <DataGrid.Columns>
                                <!-- # column hidden as requested -->
                                <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="1.2*"/>
                                <DataGridTextColumn Header="كلمة السر" Binding="{Binding Password}" Width="1.2*"/>

                                <DataGridTemplateColumn Header="الحالة" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#D1FAE5" CornerRadius="8" Padding="6,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SyncStatusText}" FontSize="8.5" FontWeight="Bold" Foreground="#065F46"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="تاريخ الإضافة" Binding="{Binding CreatedAt, StringFormat=\{0:dd-MM-yyyy HH:mm\}}" Width="120"/>
                                <DataGridTextColumn Header="حالة الطباعة" Binding="{Binding PrintStatusText}" Width="85"/>

                                <!-- إجراءات الملونة الموسعة -->
                                <DataGridTemplateColumn Header="إجراءات" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.CopyCredentialsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                        ToolTip="معاينة ونسخ" Background="#EFF6FF" BorderBrush="#3B82F6" Foreground="#1D4ED8" Width="26" Height="22" Padding="0" Margin="0,0,3,0">
                                                    <TextBlock Text="👁️" FontSize="10"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.CopyCredentialsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                        ToolTip="نسخ الكرت" Background="#ECFDF5" BorderBrush="#10B981" Foreground="#047857" Width="26" Height="22" Padding="0" Margin="0,0,3,0">
                                                    <TextBlock Text="📋" FontSize="10"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.DisableVoucherCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                        ToolTip="طباعة الكرت" Background="#FFF7ED" BorderBrush="#F97316" Foreground="#C2410C" Width="26" Height="22" Padding="0">
                                                    <TextBlock Text="🖨️" FontSize="10"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Batch Info Side Panel -->
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Padding="6,4">
                        <StackPanel>
                            <TextBlock Text="تفاصيل الدفعة" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedBatch.Name, FallbackValue='B-20260803-001'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,1,0,3"/>

                            <TextBlock Text="الراوتر" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedBatch.RouterName, FallbackValue='MikroTik-01 (172.168.16.1)'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,1,0,3"/>

                            <TextBlock Text="الباقة" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedBatch.ProfileName, FallbackValue='100 جيجا'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,1,0,3"/>

                            <TextBlock Text="إجمالي الكروت" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedBatch.TotalCards, StringFormat='\{0\} كرت', FallbackValue='100 كرت'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,1,0,3"/>

                            <TextBlock Text="النسبة الكلية" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedBatch.SyncSuccessPercent, Mode=OneWay, StringFormat='\{0:F0\}%', FallbackValue='15%'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,1,0,3"/>

                            <TextBlock Text="حالة PDF" FontSize="9.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="🔴 لم ينشأ بعد" FontSize="8.5" FontWeight="Bold" Foreground="#991B1B" Margin="0,1,0,4"/>

                            <Button Command="{Binding LoadBatchesCommand}" Content="تحديث" Style="{StaticResource SecondaryButtonStyle}" Height="22" FontSize="9.5"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
