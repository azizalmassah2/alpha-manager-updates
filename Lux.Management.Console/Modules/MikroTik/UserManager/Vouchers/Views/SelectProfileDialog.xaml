<hc:Window x:Class="Lux.Management.Console.Modules.MikroTik.UserManager.Vouchers.Views.SelectProfileDialog"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           mc:Ignorable="d"
           Title="تحديد الباقة"
           Height="260" Width="440"
           WindowStartupLocation="CenterOwner"
           ResizeMode="NoResize"
           FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Title -->
        <TextBlock x:Name="TxtDialogTitle" Grid.Row="0" Text="اختر الباقة المطلوب تطبيقها على الكرت" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
        
        <!-- Voucher Info Subtitle -->
        <TextBlock x:Name="TxtVoucherInfo" Grid.Row="1" Text="اسم الكرت: —" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>

        <!-- Profile Selector -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <TextBlock Text="الباقة:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbProfiles" Height="36" Style="{StaticResource ComboBoxExtend}" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="تأكيد العملية" Style="{StaticResource ButtonPrimary}" Click="BtnConfirm_Click" Width="110" Height="32" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource ButtonDefault}" Click="BtnCancel_Click" Width="90" Height="32" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</hc:Window>
