<Window x:Class="Lux.Management.Console.Modules.MikroTik.UserManager.Vouchers.Views.CreateBatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:enums="clr-namespace:MikroTikVoucherPrinter.Domain.Enums;assembly=MikroTikVoucherPrinter.Domain"
        Title="إنشاء دفعة كروت جديدة"
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        Background="{DynamicResource RegionBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Form Fields -->
            <RowDefinition Height="Auto"/> <!-- Banners & Telemetry -->
            <RowDefinition Height="Auto"/> <!-- Footer Controls -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="إنشاء دفعة كروت جديدة 💳" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock Text="قم بتعبئة معطيات التوليد لتوليد الدفعة محلياً، ومزامنتها تلقائياً مع خادم المايكروتك وطباعتها." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Form Fields -->
        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/> <!-- Right Column: Core settings -->
                <ColumnDefinition Width="20"/> <!-- Spacer -->
                <ColumnDefinition Width="*"/> <!-- Left Column: Auth & Identity settings -->
            </Grid.ColumnDefinitions>

            <!-- Column 0: Core Settings -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <TextBlock Text="معطيات الإنتاج الأساسية" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,10"/>

                <!-- Profile Selection -->
                <TextBlock Text="الباقة (Profile):" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName"
                          Style="{StaticResource ComboBoxExtend}" Height="32" Margin="0,0,0,12"/>

                <!-- Count Selection -->
                <TextBlock Text="الكمية:" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxExtend}" Height="32" Margin="0,0,0,12"/>

                <!-- Agent Selection -->
                <TextBlock Text="نقطة البيع (الوكيل) الاختيارية:" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}" DisplayMemberPath="Name"
                          hc:InfoElement.Placeholder="لا يوجد وكيل محدد"
                          Style="{StaticResource ComboBoxExtend}" Height="32" Margin="0,0,0,12"/>

                <!-- Print Template Selection -->
                <TextBlock Text="قالب الطباعة الأساسي:" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding PrintTemplateOptions}" SelectedItem="{Binding SelectedPrintTemplateOption}"
                          Style="{StaticResource ComboBoxExtend}" Height="32" Margin="0,0,0,12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="11.5"/>
                                <TextBlock Text=" · " Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Column 2: Identity & Cryptographic parameters -->
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <TextBlock Text="محددات الحسابات والهوية" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,10"/>

                <!-- Generation Mode (Auth Vector) -->
                <TextBlock Text="نمط التوليد (Auth Vector):" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox SelectedValue="{Binding SelectedCredentialMode}" SelectedValuePath="Tag" Style="{StaticResource ComboBoxExtend}" Height="32" Margin="0,0,0,12">
                    <ComboBoxItem Content="مستخدم فقط (بدون كلمة سر)" Tag="{x:Static enums:CredentialMode.UsernameOnly}"/>
                    <ComboBoxItem Content="المستخدم يطابق كلمة السر" Tag="{x:Static enums:CredentialMode.UsernameEqualsPassword}"/>
                    <ComboBoxItem Content="مستخدم وكلمة سر مستقلة" Tag="{x:Static enums:CredentialMode.UsernameAndPassword}"/>
                </ComboBox>

                <!-- Username character set -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="أحرف المستخدم:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding SelectedCharacterMode}" SelectedValuePath="Tag" Style="{StaticResource ComboBoxExtend}" Height="32">
                            <ComboBoxItem Content="أرقام فقط (0-9)" Tag="{x:Static enums:CharacterMode.DigitsOnly}"/>
                            <ComboBoxItem Content="حروف إنجليزية" Tag="{x:Static enums:CharacterMode.LettersOnly}"/>
                            <ComboBoxItem Content="مختلط" Tag="{x:Static enums:CharacterMode.Mixed}"/>
                            <ComboBoxItem Content="حروف صغيرة ومختلطة" Tag="{x:Static enums:CharacterMode.LowercaseMixed}"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="طول الاسم:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding UsernameLength}" Style="{StaticResource TextBoxExtend}" Height="32" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Username Prefix -->
                <TextBlock Text="بادئة اسم المستخدم (اختياري):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Prefix}" Style="{StaticResource TextBoxExtend}" Height="32" hc:InfoElement.Placeholder="مثال: A- أو 55" Margin="0,0,0,12"/>

                <!-- Password parameters (visible if full mode) -->
                <StackPanel Visibility="{Binding ShowPasswordLength, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="أحرف كلمة السر:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding PasswordCharacterMode}" SelectedValuePath="Tag" Style="{StaticResource ComboBoxExtend}" Height="32">
                                <ComboBoxItem Content="أرقام فقط (0-9)" Tag="{x:Static enums:CharacterMode.DigitsOnly}"/>
                                <ComboBoxItem Content="حروف إنجليزية" Tag="{x:Static enums:CharacterMode.LettersOnly}"/>
                                <ComboBoxItem Content="مختلط" Tag="{x:Static enums:CharacterMode.Mixed}"/>
                                <ComboBoxItem Content="حروف صغيرة ومختلطة" Tag="{x:Static enums:CharacterMode.LowercaseMixed}"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="طول الرمز:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding PasswordLength}" Style="{StaticResource TextBoxExtend}" Height="32" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="بادئة كلمة السر (اختياري):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PasswordPrefix}" Style="{StaticResource TextBoxExtend}" Height="32" hc:InfoElement.Placeholder="مثال: P" Margin="0,0,0,10"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Banners & Telemetry -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <!-- Telemetry & Switches Banner -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Expected income -->
                        <ColumnDefinition Width="*"/>    <!-- Spacing / Toggles -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="الإيراد المتوقع الكلي:" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" Foreground="#FF10B981"/>
                            <TextBlock Text=" ريال" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="40,0,0,0" VerticalAlignment="Center">
                        <CheckBox Content="مزامنة فورية للمايكروتك" IsChecked="{Binding AutoSyncAfterGenerate}" Margin="0,0,20,0" FontSize="11.5"/>
                        <CheckBox Content="فتح المعاينة والطباعة تلقائياً" IsChecked="{Binding PrintAfterGenerate}" FontSize="11.5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress bar -->
            <Grid Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" Value="{Binding ProgressCurrent}" Maximum="{Binding ProgressTotal}" Height="18" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource PrimaryBrush}"/>
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </Grid>

            <!-- Result messages -->
            <Border Background="#1F10B981" BorderBrush="#FF10B981" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ResultMessage}" FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Footer Controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="إنشاء وطباعة الدفعة 🚀" Command="{Binding GenerateBulkCommand}" Style="{StaticResource ButtonPrimary}" Width="150" Margin="0,0,10,0"/>
            <Button Content="إلغاء" Click="BtnCancel_Click" Style="{StaticResource ButtonDefault}" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
