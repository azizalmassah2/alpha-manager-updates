<UserControl x:Class="Lux.Management.Console.Modules.MikroTik.UserManager.Vouchers.Views.VoucherManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             xmlns:local="clr-namespace:Lux.Management.Console.Modules.MikroTik.UserManager.Vouchers.Views">

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:ScreenStatusToColorConverter x:Key="ScreenStatusToColorConverter"/>

            <!-- Custom SearchBar Style with exact search checkbox natively built in -->
            <Style x:Key="SearchBarWithExactSearch" TargetType="hc:SearchBar" BasedOn="{StaticResource SearchBarPlus}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="hc:SearchBar">
                            <Border x:Name="border"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/> <!-- CheckBox -->
                                        <ColumnDefinition Width="Auto"/> <!-- Search Button -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Text Input Area -->
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Grid.Column="0"
                                                  Focusable="false"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0"/>

                                    <!-- Watermark / Placeholder -->
                                    <TextBlock x:Name="Placeholder"
                                               Grid.Column="0"
                                               Text="{TemplateBinding hc:InfoElement.Placeholder}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="12,0,8,0"
                                               Visibility="Collapsed"/>

                                    <!-- CheckBox -->
                                    <CheckBox Grid.Column="1"
                                              Content="مطابقة بالكامل"
                                              IsChecked="{Binding DataContext.IsExactSearch, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Foreground="{DynamicResource SecondaryTextBrush}"
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              VerticalAlignment="Center"
                                              Margin="8,0"/>

                                    <!-- Magnifying Glass Search Button -->
                                    <Button x:Name="PART_SearchButton"
                                            Grid.Column="2"
                                            Style="{StaticResource ButtonIcon}"
                                            Width="32"
                                            Height="30"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Cursor="Hand">
                                        <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                              Fill="{DynamicResource SecondaryTextBrush}"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Show placeholder if text is empty -->
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <!-- Focus and mouse over visual states -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- ══ Master Container: Split-View (Sidebar Tree Navigation + Main Area) ══ -->
    <Grid Background="{DynamicResource RegionBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- ══════════════════════════════════════════════════════
             منطقة إدارة الكروت الأساسية (عرض كامل - تم إزالة Sidebar)
             ══════════════════════════════════════════════════════ -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: KPI Cards Section (Compacted by 40%) -->
                <RowDefinition Height="Auto"/> <!-- 1: Command Toolbar (Compacted) -->
                <RowDefinition Height="Auto"/> <!-- 2: Search, Filters and Global Counter Banner (Compacted) -->
                <RowDefinition Height="Auto"/> <!-- 3: Global Status and Sync Progress Banner -->
                <RowDefinition Height="Auto"/> <!-- 4: First Run Import Wizard Banner (Non-blocking) -->
                <RowDefinition Height="Auto"/> <!-- 5: Background Import Progress Banner (Non-blocking) -->
                <RowDefinition Height="*"/>    <!-- 6: DataGrid / Virtualized Grid Area (Main Element - Occupies 70%+) -->
            </Grid.RowDefinitions>

            <!-- Row 0: KPI Cards Section (Compacted by 40% for maximum grid space) -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="16,8,16,4">
                <!-- Card 1: Total Vouchers -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="إجمالي الكروت" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding GlobalCount, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="#1F6366F1" VerticalAlignment="Center">
                            <TextBlock Text="💳" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2: Pending Sync -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="معلق بالمزامنة" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding PendingSyncCount, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="#1FF59E0B" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 3: Failed Sync -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="فشل المزامنة" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding FailedSyncCount, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="#1FEF4444" VerticalAlignment="Center">
                            <TextBlock Text="❌" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 4: Selected Cards -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.02" BlurRadius="4" ShadowDepth="1" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="الكروت المحددة" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedCount, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Background="#1F10B981" VerticalAlignment="Center">
                            <TextBlock Text="✅" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Row 1: Command Toolbar (Sleek and compact) -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,4" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Button Content="إنشاء دفعة جديدة  ➕" Command="{Binding CreateBatchCommand}" Style="{DynamicResource ButtonPrimary}" Height="28" Padding="12,0" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <Button Content="طباعة المحدد  🖨️" Command="{Binding PrintSelectedCommand}" Style="{DynamicResource ButtonDefault}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="تصدير المحدد  📤" Command="{Binding ExportSelectedCommand}" Style="{DynamicResource ButtonDefault}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="حذف المحدد  🗑️" Command="{Binding DeleteSelectedCommand}" Style="{DynamicResource ButtonDanger}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0" Visibility="{Binding IsNotRecycleBinActive, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="استعادة المحدد  ↻" Command="{Binding RestoreSelectedCommand}" Style="{DynamicResource ButtonPrimary}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0" Visibility="{Binding IsRecycleBinActive, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="إعادة محاولة المزامنة  ⚠" Command="{Binding RetryFailedCommand}" Style="{DynamicResource ButtonDefault}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,6,0" Visibility="{Binding HasFailedSyncs, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="مزامنة فورية  ↻" Command="{Binding RefreshCommand}" Style="{DynamicResource ButtonDefault}" Height="28" Padding="10,0" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="✓ آخر مزامنة: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LastSyncTimeText}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        
                        <TextBlock Text="⏳ معلق: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PendingSyncCount}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        
                        <TextBlock Text="✕ فشل: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FailedSyncCount}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Unified Filter Bar (Horizontally laid out) -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/> <!-- Search Box -->
                        <ColumnDefinition Width="Auto"/> <!-- Status Filter -->
                        <ColumnDefinition Width="Auto"/> <!-- Package Filter -->
                        <ColumnDefinition Width="Auto"/> <!-- Agent Filter -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- 1. Search Box (With Native CheckBox Style) -->
                    <hc:SearchBar Grid.Column="0" 
                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                  Height="32"
                                  hc:InfoElement.Placeholder="بحث"
                                  Style="{StaticResource SearchBarWithExactSearch}"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>
                    
                    <!-- 2. Status Filter -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="الحالة:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="120" Height="32" SelectedValue="{Binding FilterStatus}" SelectedValuePath="Tag" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="الكل" Tag="All" IsSelected="True"/>
                            <ComboBoxItem Content="المفضلة ⭐" Tag="Favorite"/>
                            <ComboBoxItem Content="غير مستخدم" Tag="Unused"/>
                            <ComboBoxItem Content="مستخدم" Tag="Used"/>
                            <ComboBoxItem Content="منتهي" Tag="Expired"/>
                            <ComboBoxItem Content="محذوف" Tag="Deleted"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 3. Package Filter -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="الباقة:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="140" Height="32" ItemsSource="{Binding ProfileFilters}" SelectedValue="{Binding FilterProfile}" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- 4. Agent Filter -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="الوكيل:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="150" Height="32" 
                                  ItemsSource="{Binding AgentFilters}" 
                                  DisplayMemberPath="Name" 
                                  SelectedValuePath="Id" 
                                  SelectedValue="{Binding FilterAgentId}"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Row 3: Global Status and Sync Progress Banner -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Panel.ZIndex="10" Padding="16,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusBannerVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Background>
                    <Binding Path="CurrentScreenStatus" Converter="{StaticResource ScreenStatusToColorConverter}"/>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusBannerMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        
                        <!-- Progress bar visible during background Syncing state -->
                        <ProgressBar Width="200" Height="6" Margin="16,0,0,0" Value="{Binding SyncProgressPercent}" Maximum="100" VerticalAlignment="Center" Foreground="White" Background="#33FFFFFF">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentScreenStatus}" Value="Syncing">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>

                    <hc:LoadingCircle Grid.Column="1" Width="12" Height="12" Foreground="White" VerticalAlignment="Center">
                        <hc:LoadingCircle.Style>
                            <Style TargetType="hc:LoadingCircle">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentScreenStatus}" Value="Loading">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentScreenStatus}" Value="Syncing">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:LoadingCircle.Style>
                    </hc:LoadingCircle>
                </Grid>
            </Border>

            <!-- Row 4: First Run Import Wizard Banner (Non-blocking) -->
            <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,6" Background="{DynamicResource RegionBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFirstRunImportRequired}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center">
                            <Run Text="تم اكتشاف "/>
                            <Run Text="{Binding RouterVoucherCount, StringFormat={}{0:N0}}" FontWeight="Bold"/>
                            <Run Text=" كرت موجودة في الراوتر. سيتم بناء قاعدة البيانات المحلية بالخلفية."/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="بدء الاستيراد" 
                                Command="{Binding StartBackgroundImportCommand}" 
                                Style="{DynamicResource ButtonPrimary}" 
                                Height="24" Width="90" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"/>
                        <Button Content="تجاهل" 
                                Command="{Binding DismissImportCommand}" 
                                Style="{DynamicResource ButtonDefault}" 
                                Height="24" Width="60" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 5: Background Import Progress Banner (Non-blocking) -->
            <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,6" Background="{DynamicResource RegionBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsImporting}" Value="True"/>
                                    <Condition Binding="{Binding IsImportDetailsHidden}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.Setters>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger.Setters>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="↻" FontSize="13" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImportPaused}" Value="True">
                                            <Setter Property="Text" Value="⏸"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="جاري استيراد الكروت من الراوتر" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImportPaused}" Value="True">
                                            <Setter Property="Text" Value="تم إيقاف الاستيراد مؤقتاً"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Progress Text -->
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Run Text="تم استيراد: "/>
                        <Run Text="{Binding ImportedCount, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Run Text=" من "/>
                        <Run Text="{Binding TotalImportCount, StringFormat={}{0:N0}}"/>
                    </TextBlock>

                    <!-- Progress Bar -->
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Height="6" Value="{Binding ImportProgressPercent}" Maximum="100" Foreground="{DynamicResource PrimaryBrush}" Background="#1F808080" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center">
                            <Run Text="{Binding ImportProgressPercent}"/>
                            <Run Text="%"/>
                        </TextBlock>
                    </Grid>

                    <!-- Pause/Resume Control Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <!-- Pause Button -->
                        <Button Content="إيقاف مؤقت" 
                                Command="{Binding PauseImportCommand}" 
                                Height="24" Width="80" FontSize="10.5" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImportPaused}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Resume Button -->
                        <Button Content="استئناف" 
                                Command="{Binding ResumeImportCommand}" 
                                Height="24" Width="80" FontSize="10.5" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImportPaused}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Hide Details Button -->
                    <Button Grid.Column="4" Content="إخفاء التفاصيل" 
                            Command="{Binding HideImportDetailsCommand}" 
                            Style="{DynamicResource ButtonDefault}" 
                            Height="24" Width="85" FontSize="10.5"/>
                </Grid>
            </Border>

            <!-- Row 6: DataGrid / Virtualized Grid Area (Main Element - Occupies 70%+) -->
            <Grid Grid.Row="6" Background="{DynamicResource WindowBackgroundBrush}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <!-- 1. The High-Density Workspace Grid Container -->
                <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Margin="16,8,16,16" Background="{StaticResource SurfaceBrush}">
                    <DataGrid x:Name="VouchersDataGrid" 
                              Style="{StaticResource HighDensityDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource HighDensityColumnHeaderStyle}"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Vouchers}" 
                              SelectedItem="{Binding SelectedVoucher, Mode=TwoWay}"
                              hc:DataGridAttach.ShowRowNumber="True"
                              SelectionMode="Extended"
                              SelectionChanged="VouchersDataGrid_SelectionChanged"
                              ScrollViewer.ScrollChanged="VouchersDataGrid_ScrollChanged">

                        <!-- Context Menu and Double Click for DataGrid row -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <EventSetter Event="MouseDoubleClick" Handler="VouchersDataGridRow_MouseDoubleClick"/>
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="إضافة / إزالة من المفضلة  ⭐" 
                                                      Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="إعادة شحن الكرت  ⚡" 
                                                      Command="{Binding PlacementTarget.Tag.RechargeVoucherCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="إعادة إنشاء الكرت  🔄" 
                                                      Command="{Binding PlacementTarget.Tag.RecreateVoucherCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="تقرير الكرت التفصيلي  📄" 
                                                      Command="{Binding PlacementTarget.Tag.ShowVoucherDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="نسخ اسم المستخدم" 
                                                      Command="{Binding PlacementTarget.Tag.CopyUsernameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="نسخ كلمة السر" 
                                                      Command="{Binding PlacementTarget.Tag.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="إعادة طباعة" 
                                                      Command="{Binding PlacementTarget.Tag.PrintSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="حذف" 
                                                      Command="{Binding PlacementTarget.Tag.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Visibility="{Binding PlacementTarget.Tag.IsNotRecycleBinActive, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"/>
                                            <MenuItem Header="استعادة" 
                                                      Command="{Binding PlacementTarget.Tag.RestoreSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Visibility="{Binding PlacementTarget.Tag.IsRecycleBinActive, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!-- 1. Checkbox Column -->
                            <DataGridTemplateColumn Width="45">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=TwoWay}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 2. اسم المستخدم مع مؤشر المفضلة -->
                            <DataGridTemplateColumn Header="اسم المستخدم" Width="2.5*" SortMemberPath="Username">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="⭐ " FontSize="11" Foreground="#FFD700" VerticalAlignment="Center"
                                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Username}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 3. اسم الباقة -->
                            <DataGridTextColumn Header="اسم الباقة" Binding="{Binding Profile}" Width="1.8*" SortMemberPath="Profile" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                            <!-- 4. التحميل -->
                            <DataGridTextColumn Header="التحميل" Binding="{Binding DownloadUsedText}" Width="1.2*" SortMemberPath="DownloadUsedBytes" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                            <!-- 5. الرفع -->
                            <DataGridTextColumn Header="الرفع" Binding="{Binding UploadUsedText}" Width="1.2*" SortMemberPath="UploadUsedBytes" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                            <!-- 6. الحالة -->
                            <DataGridTemplateColumn Header="الحالة" Width="1.4*" SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <!-- غير مستخدم -> أزرق -->
                                                        <DataTrigger Binding="{Binding Status}" Value="Unused">
                                                            <Setter Property="Foreground" Value="#FF1E88E5"/>
                                                        </DataTrigger>
                                                        <!-- مستخدم -> أصفر -->
                                                        <DataTrigger Binding="{Binding Status}" Value="Used">
                                                            <Setter Property="Foreground" Value="#FFD97706"/>
                                                        </DataTrigger>
                                                        <!-- منتهي -> أحمر -->
                                                        <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                            <Setter Property="Foreground" Value="#FFEF4444"/>
                                                        </DataTrigger>
                                                        <!-- محذوف -> رمادي داكن -->
                                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 7. حالة المزامنة -->
                            <DataGridTemplateColumn Header="حالة المزامنة" Width="1.3*" SortMemberPath="IsSyncedText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IsSyncedText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFF59E0B"/>
                                                    <Style.Triggers>
                                                        <!-- مزامن -> أخضر -->
                                                        <DataTrigger Binding="{Binding SyncStatus}" Value="Synced">
                                                            <Setter Property="Foreground" Value="#FF10B981"/>
                                                        </DataTrigger>
                                                        <!-- فشل المزامنة -> أحمر -->
                                                        <DataTrigger Binding="{Binding SyncStatus}" Value="Failed">
                                                            <Setter Property="Foreground" Value="#FFEF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 8. حالة الطباعة -->
                            <DataGridTemplateColumn Header="حالة الطباعة" Width="1.3*" SortMemberPath="PrintStatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PrintStatusText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF9CA3AF"/>
                                                    <Style.Triggers>
                                                        <!-- مطبوع -> أخضر -->
                                                        <DataTrigger Binding="{Binding IsPrinted}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 9. تاريخ الإنشاء -->
                            <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Width="1.4*" ElementStyle="{StaticResource CenterTextBlockStyle}"/>

                            <!-- 8. القائمة الجانبية للصف (⋮) -->
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Content="⋮"
                                                Width="28" Height="28"
                                                Foreground="{StaticResource DisabledBrush}"
                                                Padding="0"
                                                Cursor="Hand"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Click="BtnRowMenu_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="إضافة / إزالة من المفضلة  ⭐" 
                                                              Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="إعادة شحن الكرت  ⚡" 
                                                              Command="{Binding PlacementTarget.Tag.RechargeVoucherCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="إعادة إنشاء الكرت  🔄" 
                                                              Command="{Binding PlacementTarget.Tag.RecreateVoucherCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="تقرير الكرت التفصيلي  📄" 
                                                              Command="{Binding PlacementTarget.Tag.ShowVoucherDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="نسخ اسم المستخدم" 
                                                              Command="{Binding PlacementTarget.Tag.CopyUsernameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="نسخ كلمة السر" 
                                                              Command="{Binding PlacementTarget.Tag.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="إعادة طباعة" 
                                                              Command="{Binding PlacementTarget.Tag.PrintSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="حذف" 
                                                              Command="{Binding PlacementTarget.Tag.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Visibility="{Binding PlacementTarget.Tag.IsNotRecycleBinActive, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"/>
                                                    <MenuItem Header="استعادة" 
                                                              Command="{Binding PlacementTarget.Tag.RestoreSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Visibility="{Binding PlacementTarget.Tag.IsRecycleBinActive, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 2. Clean Workspace Empty State Overlay -->
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GlobalCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🗂️" FontSize="48" Opacity="0.4" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="لا توجد كروت حالياً في مساحة العمل" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="قم بتوليد دفعات كروت جديدة أو مزامنة الشبكة للبدء بالعمل الفوري." FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <Button Content="توليد دفعة جديدة  ➕" 
                                Command="{Binding CreateBatchCommand}" 
                                Style="{DynamicResource ButtonPrimary}" 
                                Width="160" Height="32" FontSize="12.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- 3. Loading More Indicator Overlay (Infinite Scrolling) -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                        Background="{DynamicResource SurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="18" 
                        Padding="14,6" 
                        Margin="0,0,0,32" 
                        Panel.ZIndex="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Color="Black"/>
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingMore}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <hc:LoadingCircle Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="جارٍ تحميل المزيد من الكروت..." FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>