<Window x:Class="Lux.Management.Console.Modules.MikroTik.UserManager.Vouchers.Views.UserReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تفاصيل الكرت والتقرير الشامل" Height="720" Width="820"
        WindowStartupLocation="CenterOwner"
        FontFamily="Tajawal, Segoe UI Variable, sans-serif"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="تقرير تفاصيل الكرت والمشترك" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtUserName" Text="UserName" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="الحالة: " FontSize="13" Foreground="#475569" FontWeight="Medium"/>
                        <TextBlock x:Name="TxtStatus" Text="—" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. معلومات الكرت والباقة والصلاحية -->
                <TextBlock Text="معلومات الكرت والباقة والصلاحية" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="4,0,0,8"/>
                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="الباقة المشتركة" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtProfile" Text="—" FontSize="14" FontWeight="Bold" Foreground="#2563EB"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,12">
                            <TextBlock Text="تاريخ أول استخدام" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtFirstUse" Text="—" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="تاريخ الانتهاء" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtExpiryDate" Text="—" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/>
                        </StackPanel>

                        <!-- Row 1 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="الصلاحية بالساعات (المتبقي)" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtValidityHours" Text="—" FontSize="13" FontWeight="Bold" Foreground="#D97706"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,12">
                            <TextBlock Text="تاريخ التسجيل" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtRegDate" Text="—" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="آخر اتصال للكرت" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtLastSeen" Text="—" FontSize="13" FontWeight="Bold" Foreground="#059669"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. إحصائيات الاستهلاك والرصيد المتبقي -->
                <TextBlock Text="إحصائيات الاستهلاك والرصيد المتبقي" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="4,0,0,8"/>
                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="التنزيل المستخدم" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtDownload" Text="0 MB" FontSize="15" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,12">
                            <TextBlock Text="الرفع المستخدم" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtUpload" Text="0 MB" FontSize="15" FontWeight="Bold" Foreground="#8B5CF6"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="الرصيد المتبقي" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtRemainingQuota" Text="—" FontSize="15" FontWeight="Bold" Foreground="#0284C7"/>
                        </StackPanel>

                        <!-- Row 1 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="إجمالي وقت الاتصال" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtUptime" Text="0 دقيقة" FontSize="14" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="عدد الجلسات" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSessionsCount" Text="0 جلسة" FontSize="14" FontWeight="Bold" Foreground="#3B82F6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. بيانات آخر اتصال والعناوين -->
                <TextBlock Text="بيانات آخر اتصال والعناوين" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="4,0,0,8"/>
                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="آخر عنوان IP" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtLastIp" Text="—" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="آخر عنوان MAC" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtLastMac" Text="—" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="آخر فيلان / منفذ" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtLastVlan" Text="—" FontSize="13" FontWeight="Bold" Foreground="#4F46E5"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. سجل كافة العناوين المرتبطة -->
                <TextBlock Text="سجل كافة العناوين المستخدمة" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="4,0,0,8"/>
                <Border Background="White" CornerRadius="10" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="عناوين IP المرتبطة:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtIPs" Text="لا يوجد" FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="عناوين MAC المرتبطة:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtMACs" Text="لا يوجد" FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 5. تفاصيل الجلسات التاريخية -->
                <TextBlock Text="سجل الجلسات التاريخية" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="4,0,0,8"/>
                <Border Background="White" CornerRadius="10" Padding="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
                    <DataGrid x:Name="SessionsDataGrid" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              RowHeaderWidth="0" 
                              GridLinesVisibility="Horizontal" 
                              HorizontalGridLinesBrush="#F1F5F9"
                              CanUserAddRows="False" 
                              MaxHeight="200" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="وقت البدء" Binding="{Binding StartTimeFormatted}" Width="130"/>
                            <DataGridTextColumn Header="الفيلان/المنفذ" Binding="{Binding Vlan}" Width="100"/>
                            <DataGridTextColumn Header="عنوان IP" Binding="{Binding IpAddress}" Width="110"/>
                            <DataGridTextColumn Header="عنوان MAC" Binding="{Binding MacAddress}" Width="130"/>
                            <DataGridTextColumn Header="المدة" Binding="{Binding DurationFormatted}" Width="90"/>
                            <DataGridTextColumn Header="التنزيل" Binding="{Binding DownloadFormatted}" Width="90"/>
                            <DataGridTextColumn Header="الرفع" Binding="{Binding UploadFormatted}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Actions -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16,12" Margin="0,16,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إغلاق" IsCancel="True" Style="{DynamicResource ButtonDefault}" Margin="0,0,12,0" Width="100"/>
                <Button x:Name="BtnSavePdf" Content="حفظ كملف PDF" Click="BtnSavePdf_Click" Style="{DynamicResource ButtonPrimary}" Background="#EF4444" BorderBrush="#EF4444" Foreground="White" Width="140">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA90;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="حفظ كملف PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
