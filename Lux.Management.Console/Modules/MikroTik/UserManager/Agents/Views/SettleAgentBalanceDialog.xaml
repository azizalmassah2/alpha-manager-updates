<hc:Window x:Class="Lux.Management.Console.Modules.MikroTik.UserManager.Agents.Views.SettleAgentBalanceDialog"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           mc:Ignorable="d"
           Title="تسديد / إيداع رصيد للوكيل"
           Height="320" Width="440"
           WindowStartupLocation="CenterOwner"
           ResizeMode="NoResize"
           FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtDialogTitle" Grid.Row="0" Text="💵 تسديد حساب الوكيل" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
        <TextBlock x:Name="TxtAgentInfo" Grid.Row="1" Text="الوكيل: —" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <!-- Payment Amount -->
            <TextBlock Text="مبلغ التسديد / الإيداع *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtAmount" Height="36" Style="{StaticResource TextBoxExtend}" VerticalContentAlignment="Center" FontSize="14" FontWeight="Bold" TextAlignment="Right"/>

            <!-- Notes -->
            <TextBlock Text="ملاحظات البيان / رقم السند" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,12,0,6"/>
            <TextBox x:Name="TxtNotes" Height="36" Style="{StaticResource TextBoxExtend}" VerticalContentAlignment="Center" FontSize="13"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="تأكيد التسديد" Style="{StaticResource ButtonPrimary}" Click="BtnConfirm_Click" Width="110" Height="32" IsDefault="True"/>
            <Button Content="إلغاء" Style="{StaticResource ButtonDefault}" Click="BtnCancel_Click" Width="90" Height="32" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</hc:Window>
