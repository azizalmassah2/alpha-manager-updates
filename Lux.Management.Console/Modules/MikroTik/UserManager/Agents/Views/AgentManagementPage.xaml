<UserControl x:Class="Lux.Management.Console.Modules.MikroTik.UserManager.Agents.Views.AgentManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Top Toolbar -->
            <RowDefinition Height="Auto"/>  <!-- KPI Cards -->
            <RowDefinition Height="Auto"/>  <!-- Collapsible Form -->
            <RowDefinition Height="*"/>     <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 1. Top Header & Toolbar                        -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Search -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="👥 إدارة الوكلاء والموزعين" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                
                <!-- Search Box -->
                <hc:SearchBar Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                              hc:InfoElement.Placeholder="بحث باسم الوكيل أو الهاتف..." 
                              Width="260" Height="36" 
                              Style="{StaticResource SearchBarExtend}"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding LoadAgentsCommand}" Style="{StaticResource ButtonDefault}" Height="36" Margin="0,0,10,0" ToolTip="تحديث">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="تحديث" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding AddNewCommand}" Style="{StaticResource ButtonPrimary}" Height="36">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="إضافة وكيل جديد" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 2. KPI Summary Cards                           -->
        <!-- ══════════════════════════════════════════════ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <!-- Total Agents -->
            <hc:Card Margin="0,0,10,0" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إجمالي الوكلاء" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalAgents}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#1A3B82F6" VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </hc:Card>

            <!-- Active Agents -->
            <hc:Card Margin="5,0,5,0" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="الوكلاء النشطون" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ActiveAgents}" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#1A10B981" VerticalAlignment="Center">
                        <TextBlock Text="🟢" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </hc:Card>

            <!-- Total Vouchers -->
            <hc:Card Margin="5,0,5,0" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="الكروت الموزعة" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalVouchers}" FontSize="22" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#1A8B5CF6" VerticalAlignment="Center">
                        <TextBlock Text="🎫" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </hc:Card>

            <!-- Net Owed Balance -->
            <hc:Card Margin="10,0,0,0" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="صافي المتبقي المطلوب" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalNetOwed, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#1AEF4444" VerticalAlignment="Center">
                        <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </hc:Card>
        </UniformGrid>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 3. Collapsible Agent Form                      -->
        <!-- ══════════════════════════════════════════════ -->
        <hc:Card Grid.Row="2" Margin="0,0,0,16" Padding="16" Visibility="{Binding ShowForm, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <TextBlock Text="{Binding FormTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <Button Command="{Binding CancelFormCommand}" Style="{StaticResource ButtonDefault}" Height="28" Width="28" Padding="0" HorizontalAlignment="Left" ToolTip="إغلاق">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                    </Button>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <!-- Name -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="اسم الوكيل *" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxExtend}" Height="34"/>
                    </StackPanel>

                    <!-- Phone -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="رقم الهاتف" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxExtend}" Height="34" FlowDirection="LeftToRight"/>
                    </StackPanel>

                    <!-- Commission Rate -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="العمولة (%)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormCommissionRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxExtend}" Height="34" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Notes -->
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="ملاحظات" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxExtend}" Height="54" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>

                <!-- Form Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                    <Button Command="{Binding SaveAgentCommand}" Style="{StaticResource ButtonPrimary}" Height="32" Width="120">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="حفظ التغييرات" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelFormCommand}" Style="{StaticResource ButtonDefault}" Height="32" Width="90" Margin="10,0,0,0" Content="إلغاء"/>
                </StackPanel>
            </StackPanel>
        </hc:Card>

        <!-- ══════════════════════════════════════════════ -->
        <!-- 4. Agents DataGrid                             -->
        <!-- ══════════════════════════════════════════════ -->
        <DataGrid Grid.Row="3" 
                  ItemsSource="{Binding DisplayedAgents}" 
                  SelectedItem="{Binding SelectedAgent}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="40"
                  HorizontalScrollBarVisibility="Auto">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="4,6"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="✏️ تعديل بيانات الوكيل" 
                                          Command="{Binding PlacementTarget.Tag.EditAgentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="💵 تسديد / إيداع رصيد" 
                                          Command="{Binding PlacementTarget.Tag.SettleBalanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="🔄 تغيير حالة النشاط" 
                                          Command="{Binding PlacementTarget.Tag.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="🗑️ حذف الوكيل" 
                                          Command="{Binding PlacementTarget.Tag.DeleteAgentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- Agent Name -->
                <DataGridTemplateColumn Header="اسم الوكيل" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                <TextBlock Text="👤" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Phone -->
                <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Commission Rate -->
                <DataGridTemplateColumn Header="العمولة" Width="75">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#1A8B5CF6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CommissionRate, StringFormat={}{0}%}" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Voucher Count -->
                <DataGridTextColumn Header="الكروت الموزعة" Binding="{Binding VoucherCount}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Total Sales -->
                <DataGridTextColumn Header="إجمالي المبيعات" Binding="{Binding TotalSalesAmount, StringFormat={}{0:N0}}" Width="105">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Earned Commission -->
                <DataGridTextColumn Header="العمولة المستحقة" Binding="{Binding EarnedCommission, StringFormat={}{0:N0}}" Width="105">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Paid Balance -->
                <DataGridTextColumn Header="المسدد (المدفوع)" Binding="{Binding Balance, StringFormat={}{0:N0}}" Width="105">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Net Owed -->
                <DataGridTemplateColumn Header="المتبقي المطلوب" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NetOwedBalance, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Status -->
                <DataGridTemplateColumn Header="الحالة" Width="75">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A10B981"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Background" Value="#1AEF4444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="نشط"/>
                                            <Setter Property="Foreground" Value="#10B981"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="متوقف"/>
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Actions -->
                <DataGridTemplateColumn Header="الإجراءات" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ButtonDefault}" 
                                    Height="28" Width="32" Padding="0" 
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Click="BtnRowMenu_Click">
                                <TextBlock Text="⋮" FontSize="16" FontWeight="Bold"/>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="✏️ تعديل بيانات الوكيل" 
                                                  Command="{Binding PlacementTarget.Tag.EditAgentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="💵 تسديد / إيداع رصيد" 
                                                  Command="{Binding PlacementTarget.Tag.SettleBalanceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="🔄 تغيير حالة النشاط" 
                                                  Command="{Binding PlacementTarget.Tag.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="🗑️ حذف الوكيل" 
                                                  Command="{Binding PlacementTarget.Tag.DeleteAgentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
