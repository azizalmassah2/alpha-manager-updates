<Page x:Class="Lux.Management.Console.Modules.Settings.Views.DbExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewmodels="clr-namespace:Lux.Management.Console.Modules.Settings.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="DbExplorerPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar / Table Selection -->
        <Border Grid.Column="0" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16">
                    <TextBlock Text="مستكشف قاعدة البيانات" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="User Manager DB" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                    <Button Content="سحب من المايكروتيك" Command="{Binding FetchLiveDatabaseCommand}" Margin="0,16,0,0" Style="{StaticResource ButtonPrimary}"/>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding TableItems}" SelectedValue="{Binding SelectedTable}" SelectedValuePath="Name" Margin="8,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" Padding="8" FontSize="14"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Main Area -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <hc:SearchBar Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                              hc:InfoElement.Placeholder="بحث..." 
                              Width="300" Margin="0,0,16,0"
                              Command="{Binding SearchInTableCommand}"/>
                
                <!-- Profile Filter -->
                <ComboBox ItemsSource="{Binding AvailableProfiles}" 
                          SelectedItem="{Binding SelectedProfileFilter}"
                          Visibility="{Binding ShowFilters, Converter={StaticResource Boolean2VisibilityConverter}}"
                          Width="150" Margin="0,0,16,0"
                          hc:InfoElement.Placeholder="الباقة"/>

                <!-- Status Filter -->
                <ComboBox ItemsSource="{Binding AvailableStatuses}" 
                          SelectedItem="{Binding SelectedStatusFilter}"
                          Visibility="{Binding ShowFilters, Converter={StaticResource Boolean2VisibilityConverter}}"
                          Width="150" Margin="0,0,16,0"
                          hc:InfoElement.Placeholder="الحالة"/>

                <Button Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource ButtonDefault}" Margin="0,0,8,0"/>
                <Button Content="مسح البحث" Command="{Binding ClearSearchCommand}" Style="{StaticResource ButtonDefault}"/>
            </StackPanel>

            <!-- DataGrid -->
            <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding DataTable}" 
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      hc:DataGridAttach.ShowRowNumber="True">

            </DataGrid>

            <TextBlock Grid.Row="1" Text="{Binding TotalRows, StringFormat='إجمالي السجلات: {0}'}" 
                       VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16"/>
        </Grid>
    </Grid>
</Page>
