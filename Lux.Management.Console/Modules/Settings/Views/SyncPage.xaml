<UserControl x:Class="Lux.Management.Console.Modules.Settings.Views.SyncPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="مركز مزامنة المايكروتك الحية" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
            <StackPanel Margin="30">
                <TextBlock Text="📡" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                
                <TextBlock Text="{Binding MetricsOutput}" 
                           FontSize="16" 
                           TextWrapping="Wrap" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center" 
                           Foreground="{DynamicResource PrimaryTextBrush}" 
                           Margin="0,0,0,40" />
                
                <Button Command="{Binding StartSyncCommand}" 
                        Content="بدء المزامنة (Sync Now)" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Height="50" FontSize="16"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
