<UserControl x:Class="Lux.Management.Console.Modules.Maintenance.Views.MaintenanceCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vms="clr-namespace:Lux.Management.Console.Modules.Maintenance.ViewModels"
             d:DataContext="{d:DesignInstance Type=vms:MaintenanceCenterViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛠️" FontSize="26" Margin="0,0,10,0"/>
                        <TextBlock Text="مركز الصيانة والجدولة الآلية" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                    <TextBlock Text="إدارة جدولة اسكريبتات الصيانة في MikroTik وصيانة قاعدة البيانات المحلية" 
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="36,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 2. Status Banner -->
            <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <hc:LoadingCircle Width="24" Height="24" Margin="0,0,12,0" 
                                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" 
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                </Grid>
            </Border>

            <!-- 3. Cards Section -->
            <UniformGrid Grid.Row="2" Columns="2" VerticalAlignment="Top">

                <!-- CARD 1: MikroTik Maintenance & Scheduler -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,10,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📡" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="صيانة وجدولة المايكروتيك (MikroTik)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>

                        <TextBlock Text="اختر نوع الصيانة المطلوبة، ثم يمكنك تنفيذ الصيانة فوراً على الراوتر أو تفعيل جدولة دورية تلقائية عبر المايكروتيك (/system/scheduler):" 
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                        <!-- Script Type Options -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <RadioButton Content="🧹 حذف كروت اليوزر مانجر التي استنفدت رصيد البايتات (Bytes Quota)" 
                                             IsChecked="{Binding IsCleanQuotaSelected}" 
                                             Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                
                                <RadioButton Content="⏱️ حذف كروت اليوزر مانجر التي انتهى وقتها المتاح (Time Limit)" 
                                             IsChecked="{Binding IsCleanTimeSelected}" 
                                             Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                
                                <RadioButton Content="📝 تنظيف الجلسات المنتهية وسجلات اللوج القديمة (Sessions &amp; Logs)" 
                                             IsChecked="{Binding IsCleanSessionsSelected}" 
                                             FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons Grid -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                    Command="{Binding ExecuteRouterScriptImmediatelyCommand}" 
                                    Style="{StaticResource ButtonPrimary}" 
                                    Content="تنفيذ الصيانة الآن ⚡" 
                                    Height="40"/>

                            <Button Grid.Column="2" 
                                    Command="{Binding ScheduleRouterScriptCommand}" 
                                    Style="{StaticResource ButtonDefault}" 
                                    Content="تفعيل الجدولة الدورية 📅" 
                                    Height="40"/>
                        </Grid>

                        <!-- Interval Selection for Scheduler -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="تكرار الجدولة الدورية:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <ComboBox ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding SelectedInterval}" Width="110" Height="32"/>
                            <TextBlock Text="(مثال: 1d = يومياً)" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 2 & 3: Database & Application Maintenance -->
                <StackPanel Margin="10,0,0,0">

                    <!-- CARD 2: SQLite DB Maintenance -->
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="🗄️" FontSize="20" Margin="0,0,8,0"/>
                                <TextBlock Text="صيانة قاعدة البيانات المحلية (SQLite)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>

                            <TextBlock Text="حدد خيارات صيانة قاعدة البيانات المحلية لإنعاشها وتنظيف الفراغات وتقليص حجم الملف على القرص الصلب:" 
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,14"/>

                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <CheckBox Content="🧹 حذف سجلات العمليات واللوج القديمة (System Logs)" 
                                              IsChecked="{Binding CleanDbLogs}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                    <CheckBox Content="📝 تنظيف الجلسات والكروت المحذوفة (Expired Sessions)" 
                                              IsChecked="{Binding CleanDbSessions}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                                    <CheckBox Content="🗄️ تقليص حجم الملف وتنظيم الفهارس (VACUUM &amp; REINDEX)" 
                                              IsChecked="{Binding VacuumDb}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding RebuildDatabaseCommand}" 
                                    Style="{StaticResource ButtonDefault}" 
                                    Content="إعادة بناء وصيانة قاعدة البيانات ⚡" 
                                    Height="40" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: MikroTik Router Reboot -->
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="🔌" FontSize="20" Margin="0,0,8,0"/>
                                <TextBlock Text="إعادة تشغيل راوتر المايكروتيك (MikroTik Reboot)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>

                            <TextBlock Text="إعادة تشغيل الراوتر النشط حالياً (/system/reboot) لتفريغ الذاكرة المؤقتة للمايكروتيك وتحديث سياق النظام بالكامل." 
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                            <Button Command="{Binding RebootRouterCommand}" 
                                    Style="{StaticResource ButtonWarning}" 
                                    Content="إعادة تشغيل الراوتر الآن 🔌" 
                                    Height="40" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </UniformGrid>

        </Grid>
    </ScrollViewer>
</UserControl>
