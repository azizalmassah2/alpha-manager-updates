<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ========================================== -->
    <!-- DARK THEME TOKENS                          -->
    <!-- ========================================== -->

    <!-- Surfaces & Layout -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F172A" /> <!-- slate-900 -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E293B" /> <!-- slate-800 -->
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#0B1120" /> <!-- slate-950 -->
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#334155" /> <!-- slate-700 -->
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#475569" /> <!-- slate-600 -->
    
    <SolidColorBrush x:Key="SidebarBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="CardBrush" Color="#1E293B" />
    
    <!-- Dialogs & Overlays -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" /> <!-- Black at 70% -->

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" /> <!-- slate-50 -->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8" /> <!-- slate-400 -->
    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" /> <!-- slate-500 -->

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#334155" /> <!-- slate-700 -->
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#475569" /> <!-- slate-600 -->

    <!-- Brand / Primary Actions -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6" /> <!-- blue-500 -->
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#60A5FA" /> <!-- blue-400 -->
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#2563EB" /> <!-- blue-600 -->
    
    <!-- Secondary Actions -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#334155" /> <!-- slate-700 -->
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#475569" /> <!-- slate-600 -->

    <!-- Status / Semantic (Foreground/Stroke) -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" /> <!-- green-500 -->
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" /> <!-- amber-500 -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444" /> <!-- red-500 -->
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6" /> <!-- blue-500 -->
    
    <!-- Status Backgrounds (e.g. for Badges/Alerts ~15% opacity equivalent overlayed on dark) -->
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#1A22C55E" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#1AF59E0B" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#1AEF4444" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#1A3B82F6" />

    <!-- State -->
    <SolidColorBrush x:Key="DisabledBrush" Color="#64748B" /> <!-- slate-500 -->
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#1E293B" /> <!-- slate-800 -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#1E3A8A" /> <!-- blue-900 -->
</ResourceDictionary>
