<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\img\icon.ico</ApplicationIcon>
    <Version>2.0.4</Version>
    <AssemblyVersion>2.0.4.0</AssemblyVersion>
    <FileVersion>2.0.4.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <PackageReference Include="Obfuscar" Version="2.2.50">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lux.Platform.Abstractions\Lux.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\MikroTikVoucherPrinter.Application\MikroTikVoucherPrinter.Application.csproj" />
    <ProjectReference Include="..\MikroTikVoucherPrinter.Infrastructure\MikroTikVoucherPrinter.Infrastructure.csproj" />
    <ProjectReference Include="..\Lux.OpenWrt\Lux.OpenWrt.csproj" />
    <ProjectReference Include="..\Lux.MikroTik\Lux.MikroTik.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\img\logo.png" />
    <Resource Include="Resources\img\logo2.png" />
    <Resource Include="Resources\img\icon.ico" />
    <Resource Include="Resources\img\telegram_qr.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\ALFA.enc" />
  </ItemGroup>

  <UsingTask TaskName="GenerateIntegrityFile" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildBinPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <TargetDirectory ParameterType="System.String" Required="true" />
      <ProjectDirectory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          string[] files = new string[] {
              "Lux.MikroTik.dll",
              "Lux.OpenWrt.dll",
              "Lux.Platform.Abstractions.dll",
              "MikroTikVoucherPrinter.Application.dll",
              "MikroTikVoucherPrinter.Infrastructure.dll"
          };
          
          StringBuilder sb = new StringBuilder();
          foreach (string file in files)
          {
              string filePath = Path.Combine(TargetDirectory, file);
              if (!File.Exists(filePath))
              {
                  Log.LogError("DLL not found for integrity hashing: " + filePath);
                  return false;
              }
              
              byte[] fileBytes = File.ReadAllBytes(filePath);
              byte[] hashBytes;
              using (var sha = SHA256.Create())
              {
                  hashBytes = sha.ComputeHash(fileBytes);
              }
              
              StringBuilder hashString = new StringBuilder();
              foreach (byte b in hashBytes)
              {
                  hashString.Append(b.ToString("x2"));
              }
              
              sb.AppendLine(file + ":" + hashString.ToString());
              Log.LogMessage(MessageImportance.High, "Integrity Hash for " + file + " = " + hashString.ToString());
          }
          
          string manifestPayload = sb.ToString().Trim();
          byte[] manifestBytes = Encoding.UTF8.GetBytes(manifestPayload);
          
          string privateKeyXml = @"<RSAKeyValue><Modulus></Modulus><Exponent>AQAB</Exponent><P>+LTWOKI0V9Zv+W62914LOJMAxaXMeYySWEP+HXeC78UQfucuhYJoidojXL2TFllZgAAqcgRE/psroJZW/BDsgL5LclP37EF/Y41Grop+bh0EeleAIHyrNEqSHQSfjox13oLIl+jJaW+WLIRFMMky7BhL74oIP43COJ+8LXAnk3M=</P><Q>zBmuYUxRjEB0EB+c+XGf9n91nqEFaRQ9YeGyKkZjAbSP+EBMP1aB/pqTe223WDMZNloMpQ8Uj0XBO31IezHC2jqPHS0xNJCtA3EV9acPuCTSUt5Jj0u37ZLsgWz9J8/UvApg2i74verqB3HIrmjIXQcnpzhX/cNfM/WwK5WXoMc=</Q><DP>JxZkxKnZiCSPnKgl4WLKaK3R5T5VkJTjOzQUcBUkYwKZwRgcW6dPPrsl66FvyIdqZY+hHCJHpaxFgwudyCfww5skyGciA+OXXdIKVcw2ap/s4D14SaLOVX2S0TS0zvaMX9g2JonTfdqnw39WUICOnESFSrRq73IcIEIalRmXXrk=</DP><DQ>iS5Fr64NLZhwqhmld19wpcxbsQgHS+5Hp498Ib/3ccD79164IOYzL36T3CUNU2Hc81QpJZPyPK4kx6hYXD1A+07avECQzwTi1OpgWSE1ho5xMzOm+4JoGG1lO0SXDvg4wz6yhFOH6paHQAOxX9CbwzM46sMLGUwEpDbhdxnvtSc=</DQ><InverseQ>wlxp1NTF9hjia2pwVKVOyyVHkzCfV84q64yI3uDEYQZoulfp3wLJd+a5Ox0Ifm+03C6CJmPg+VVNrHNUdL3jPauNU14txdc8zLChKWKgSN0G8yLDnAY3SWuv0vvo1lmf13oCfqDvZEh/342mQwnuDEg2WJ5az5g+onIdab3ikXc=</InverseQ><D></D></RSAKeyValue>";
          
          byte[] signatureBytes;
          using (RSA rsa = RSA.Create())
          {
              rsa.FromXmlString(privateKeyXml);
              signatureBytes = rsa.SignData(manifestBytes, HashAlgorithmName.SHA256, RSASignaturePadding.Pkcs1);
          }
          
          string signatureBase64 = Convert.ToBase64String(signatureBytes);
          string outputContent = signatureBase64 + "\n" + manifestPayload;
          
          string outputPath = Path.Combine(TargetDirectory, "integrity.dat");
          File.WriteAllText(outputPath, outputContent, Encoding.UTF8);
          Log.LogMessage(MessageImportance.High, "🔒 [Integrity] Generated digitally signed integrity.dat at: " + outputPath);
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="ObfuscateRelease" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Release'">
    <Message Importance="High" Text="🔒 [Obfuscar] Running Obfuscar obfuscation from '$(TargetDir)'..." />
    <Exec Command="&quot;$(NugetPackageRoot)obfuscar\2.2.50\tools\Obfuscar.Console.exe&quot; &quot;$(MSBuildProjectDirectory)\obfuscar.xml&quot;" WorkingDirectory="$(TargetDir)" />
    
    <Message Importance="High" Text="📦 [Obfuscar] Copying obfuscated assemblies back to '$(TargetDir)'..." />
    <ItemGroup>
      <ObfuscatedFiles Include="$(TargetDir)Obfuscated\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ObfuscatedFiles)" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" />
    
    <Message Importance="High" Text="🔒 [Integrity] Generating assembly integrity.dat..." />
    <GenerateIntegrityFile TargetDirectory="$(TargetDir)" ProjectDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="CopyIntegrityToPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <Message Importance="High" Text="📦 [Integrity] Copying integrity.dat to publish directory: '$(PublishDir)'..." />
    <Copy SourceFiles="$(TargetDir)integrity.dat" DestinationFolder="$(PublishDir)" Condition="Exists('$(TargetDir)integrity.dat')" OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
