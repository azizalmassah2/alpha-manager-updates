    <Message Importance="High" Text="📦 [Obfuscar] Copying obfuscated assemblies back to '$(TargetDir)'..." />
    <ItemGroup>
      <ObfuscatedFiles Include="$(TargetDir)Obfuscated\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ObfuscatedFiles)" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" />
    <Message Importance="High" Text="🔒 [Integrity] Generating assembly integrity.dat..." />
    <GenerateIntegrityFile TargetDirectory="$(TargetDir)" ProjectDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Target Name="CopyIntegrityToPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <Message Importance="High" Text="📦 [Integrity] Copying integrity.dat to publish directory: '$(PublishDir)'..." />
