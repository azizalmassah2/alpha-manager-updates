<Window x:Class="Lux.Management.Console.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="480" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Resources/img/icon.ico">

    <Window.Resources>
        <!-- زر التحديث الرئيسي -->
        <Style x:Key="UpdateNowBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F5A623" Offset="0"/>
                                    <GradientStop Color="#E94560" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- زر التخطي الثانوي -->
        <Style x:Key="SkipBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Entrance Animation -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.93" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder"
            CornerRadius="16"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Opacity="0.15" ShadowDepth="0" Color="#000000"/>
        </Border.Effect>

        <Grid FlowDirection="RightToLeft">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Admin message (conditional) -->
                <RowDefinition Height="Auto"/> <!-- Version compare -->
                <RowDefinition Height="*"/>    <!-- Release notes -->
                <RowDefinition Height="Auto"/> <!-- Meta info (date, size) -->
                <RowDefinition Height="Auto"/> <!-- Progress bar -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- ══ HEADER ══ -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="22,18,22,18" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F8FAFC" Offset="0"/>
                        <GradientStop Color="#F1F5F9" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="🔄 تحديث متاح"
                                   FontSize="19" FontWeight="Bold"
                                   FontFamily="Segoe UI" Foreground="#0F172A"/>
                        <TextBlock Text="يتوفر إصدار جديد من Alpha Manager"
                                   FontSize="11" FontFamily="Segoe UI"
                                   Foreground="#475569" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Update Type Badge -->
                    <Border Grid.Column="1" x:Name="TypeBadge"
                            CornerRadius="20" Padding="14,6"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TypeBadgeText"
                                   Text="اختياري"
                                   FontSize="12" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ══ ADMIN MESSAGE (مرئي فقط إذا كانت هناك رسالة) ══ -->
            <Border Grid.Row="1" x:Name="AdminMessagePanel"
                    Visibility="Collapsed"
                    Background="#F0FDF4"
                    BorderBrush="#DCFCE7"
                    BorderThickness="0,1,0,1"
                    Padding="22,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📢"
                               FontSize="14" VerticalAlignment="Top"
                               Foreground="#166534"
                               Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="AdminMessageText"
                               FontSize="12" FontFamily="Segoe UI"
                               Foreground="#166534"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- ══ VERSION COMPARE ══ -->
            <Border Grid.Row="2" Margin="22,14,22,0" CornerRadius="10"
                    BorderThickness="1" BorderBrush="#E2E8F0"
                    Padding="16,12" Background="#F8FAFC">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="الإصدار الحالي" FontSize="10"
                                   FontFamily="Segoe UI" Foreground="#64748B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CurrentVersionText"
                                   FontSize="18" FontWeight="Bold"
                                   FontFamily="Segoe UI Mono" Foreground="#334155"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="←"
                               FontSize="20" Foreground="#E94560"
                               VerticalAlignment="Center" Margin="10,0"/>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="الإصدار الجديد" FontSize="10"
                                   FontFamily="Segoe UI" Foreground="#64748B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NewVersionText"
                                   FontSize="18" FontWeight="Bold"
                                   FontFamily="Segoe UI Mono"
                                   HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F5A623" Offset="0"/>
                                    <GradientStop Color="#E94560" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ RELEASE NOTES ══ -->
            <Border Grid.Row="3" Margin="22,10,22,0"
                    CornerRadius="10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📋 ملاحظات الإصدار"
                               FontSize="11" FontFamily="Segoe UI"
                               Foreground="#64748B" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="100">
                        <ItemsControl x:Name="ReleaseNotesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="•"
                                                   Foreground="#E94560" FontSize="14"
                                                   VerticalAlignment="Top" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding}"
                                                   FontSize="12" FontFamily="Segoe UI"
                                                   Foreground="#334155"
                                                   TextWrapping="Wrap" LineHeight="20"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ META INFO (date + size) ══ -->
            <Grid Grid.Row="4" Margin="22,8,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Release Date -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📅 " FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ReleaseDateText"
                               FontSize="11" FontFamily="Segoe UI"
                               Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- File Size -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="📦 " FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FileSizeText"
                               FontSize="11" FontFamily="Segoe UI"
                               Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ══ DOWNLOAD PROGRESS (مخفي حتى بدء التنزيل) ══ -->
            <StackPanel Grid.Row="5" x:Name="ProgressPanel"
                        Visibility="Collapsed" Margin="22,10,22,0">
                <Grid Margin="0,0,0,5">
                    <TextBlock x:Name="DownloadStatusText"
                               Text="جاري التنزيل..."
                               FontSize="11" FontFamily="Segoe UI" Foreground="#475569"/>
                    <TextBlock x:Name="DownloadPctText"
                               Text="0%"
                               FontSize="11" FontFamily="Segoe UI" Foreground="#F5A623"
                               HorizontalAlignment="Left"/>
                </Grid>
                <Border CornerRadius="4" Height="6" Background="#E2E8F0">
                    <Border x:Name="ProgressFill" CornerRadius="4"
                            HorizontalAlignment="Left" Width="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F5A623" Offset="0"/>
                                <GradientStop Color="#E94560" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
            </StackPanel>

            <!-- ══ BUTTONS ══ -->
            <Grid Grid.Row="6" Margin="22,12,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="SkipButton"
                        Content="لاحقاً" Style="{StaticResource SkipBtn}"
                        Click="OnSkipClicked"/>
                <Button Grid.Column="2" x:Name="UpdateButton"
                        Content="⬇️  تحديث الآن" Style="{StaticResource UpdateNowBtn}"
                        Click="OnUpdateClicked"/>
            </Grid>
        </Grid>
    </Border>
</Window>
