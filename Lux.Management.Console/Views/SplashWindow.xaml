<Window x:Class="Lux.Management.Console.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="300" Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="pack://application:,,,/Resources/img/icon.ico"
        ResizeMode="NoResize">

    <Border CornerRadius="16"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Opacity="0.15" ShadowDepth="0" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>       <!-- Logo Image -->
                <RowDefinition Height="Auto"/>    <!-- Separator -->
                <RowDefinition Height="Auto"/>    <!-- Status -->
                <RowDefinition Height="Auto"/>    <!-- Progress -->
                <RowDefinition Height="Auto"/>    <!-- Version -->
            </Grid.RowDefinitions>

            <!-- ══ Logo Image ══ -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" ClipToBounds="True">
                <Image Source="pack://application:,,,/Resources/img/logo.png"
                       Stretch="UniformToFill"
                       MaxHeight="200"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"
                                        CenterX="270" CenterY="100"/>
                    </Image.RenderTransform>
                    <Image.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetName="LogoScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     From="1.0" To="1.04" Duration="0:0:2.5">
                                         <DoubleAnimation.EasingFunction>
                                             <SineEase EasingMode="EaseInOut"/>
                                         </DoubleAnimation.EasingFunction>
                                     </DoubleAnimation>
                                     <DoubleAnimation Storyboard.TargetName="LogoScale"
                                                      Storyboard.TargetProperty="ScaleY"
                                                      From="1.0" To="1.04" Duration="0:0:2.5">
                                         <DoubleAnimation.EasingFunction>
                                             <SineEase EasingMode="EaseInOut"/>
                                         </DoubleAnimation.EasingFunction>
                                     </DoubleAnimation>
                                 </Storyboard>
                             </BeginStoryboard>
                         </EventTrigger>
                     </Image.Triggers>
                 </Image>
             </Border>
 
             <!-- ══ Separator ══ -->
             <Rectangle Grid.Row="1" Height="1" Fill="#E2E8F0"/>
 
             <!-- ══ Status ══ -->
             <TextBlock Grid.Row="2"
                        x:Name="StatusText"
                        Text="⚙️ جارٍ التهيئة..."
                        Foreground="#1A202C"
                        FontSize="12"
                        FontFamily="Segoe UI"
                        HorizontalAlignment="Center"
                        FlowDirection="RightToLeft"
                        Margin="0,10,0,8"/>
 
             <!-- ══ Progress ══ -->
             <ProgressBar Grid.Row="3"
                          x:Name="ProgressBar"
                          Height="4"
                          Minimum="0" Maximum="4" Value="0"
                          Background="#EDF2F7"
                          BorderThickness="0"
                          Margin="0,0,0,0">
                 <ProgressBar.Foreground>
                     <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                         <GradientStop Color="#F5A623" Offset="0"/>
                         <GradientStop Color="#E94560" Offset="1"/>
                     </LinearGradientBrush>
                 </ProgressBar.Foreground>
                 <ProgressBar.Template>
                     <ControlTemplate TargetType="ProgressBar">
                         <Border Background="{TemplateBinding Background}" BorderThickness="0">
                             <Border x:Name="PART_Track">
                                 <Border x:Name="PART_Indicator"
                                         Background="{TemplateBinding Foreground}"
                                         HorizontalAlignment="Left"/>
                             </Border>
                         </Border>
                     </ControlTemplate>
                 </ProgressBar.Template>
             </ProgressBar>
 
             <!-- ══ Version ══ -->
             <TextBlock Grid.Row="4"
                        x:Name="VersionText"
                        Text="v1.0.0"
                        Foreground="#718096"
                        FontSize="10"
                        FontFamily="Segoe UI"
                        HorizontalAlignment="Right"
                        Margin="0,6,12,8"/>
         </Grid>
     </Border>
</Window>
