        <!-- Redesigned Minimal Scrollbar Style for Lists -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#CBD5E1" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Card ListBox Style -->
        <Style x:Key="ConnectionCardListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style with Left Icon inside -->
        <Style x:Key="ModernFieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="40,0,10,0"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="IconPath"
                                      Grid.Column="0"
                                      Data="{TemplateBinding Tag}"
                                      Fill="#94A3B8"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Margin="4,0,10,0"/>
                                <TextBlock x:Name="placeholderText"
                                           Grid.Column="1"
                                           Text="{Binding (hc:InfoElement.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="IconPath" Property="Fill" Value="#2563EB"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                                </MultiTrigger.Setters>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Refresh Button Style -->
        <Style x:Key="SmallRefreshButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource RefreshIconGeometry}" Fill="#475569" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" x:Name="RefreshIcon"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter TargetName="RefreshIcon" Property="Fill" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round Add Device Button Style -->
        <Style x:Key="RoundAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Star Favorite Button Style -->
        <Style x:Key="FavoriteToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}">
                            <Path x:Name="StarPath"
                                  Data="{StaticResource StarBorderIconGeometry}"
                                  Fill="#94A3B8"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StarPath" Property="Data" Value="{StaticResource StarIconGeometry}"/>
                                <Setter TargetName="StarPath" Property="Fill" Value="#F59E0B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StarPath" Property="Fill" Value="#F59E0B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Connect Button Style (Small) -->
        <Style x:Key="SmallPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical Menu Dots Button Style -->
        <Style x:Key="ThreeDotsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <Path Data="{StaticResource ThreeVerticalDotsIconGeometry}"
                                  Fill="#94A3B8"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Large Manual Connect Action Button Style -->
        <Style x:Key="MainPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid>
                                <StackPanel x:Name="NormalContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource ThunderboltIconGeometry}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="الاتصال بالراوتر" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel x:Name="BusyContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <hc:LoadingCircle Width="16" Height="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="جاري الاتصال..." FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter TargetName="NormalContent" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="BusyContent" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Large Manual Connect Exit Button Style -->
        <Style x:Key="MainSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource ExitIconGeometry}" Fill="#475569" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" x:Name="ExitIcon"/>
                                <TextBlock Text="خروج" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter TargetName="ExitIcon" Property="Fill" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bottom Navigation Bar Button Style -->
        <Style x:Key="BottomBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Chrome Wrapper with Rounded Corners and Light Dropshadow -->
    <Border CornerRadius="16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Opacity="0.12" ShadowDepth="0" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Bar (45px) -->
                <RowDefinition Height="45"/>
                <!-- Main Body Content (*) -->
                <RowDefinition Height="*"/>
                <!-- Bottom Navigation Bar (55px) -->
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <!-- ================= TOP WINDOW TITLE BAR ================= -->
            <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#FFFFFF" CornerRadius="16,16,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <!-- Right Side: Logo & Header Title -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/img/logo2.png" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="مرحباً بك في مدير الشبكة" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Left Side: System Control Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Content="─" Width="36" Height="28" Background="Transparent" BorderThickness="0" Foreground="#64748B" Cursor="Hand" Click="MinimizeButton_Click"/>
                        <Button Content="✕" Width="36" Height="28" Background="Transparent" BorderThickness="0" Foreground="#64748B" Cursor="Hand" Click="CloseButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EF4444"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN LAYOUT WITH 3 PANELS ================= -->
            <Grid Grid.Row="1" Margin="10,6">
                <Grid.ColumnDefinitions>
                    <!-- Visual Right (Column 0 in RTL): Connection Form Card -->
                    <ColumnDefinition Width="350"/>
                    <!-- Visual Center (Column 1 in RTL): Saved & Discovered Lists -->
                    <ColumnDefinition Width="*"/>
                    <!-- Visual Left (Column 2 in RTL): Branding card -->
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <!-- ================= Grid.Column="2" (VISUAL LEFT PANEL): BRANDING ================= -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Logo -->
                            <RowDefinition Height="Auto"/> <!-- Titles -->
                            <RowDefinition Height="*"/>    <!-- Features Card -->
                            <RowDefinition Height="Auto"/> <!-- Version & Security Status Row -->
                        </Grid.RowDefinitions>

                        <!-- Large Circle Logo -->
                        <Image Grid.Row="0" 
                               Source="pack://application:,,,/Resources/img/logo2.png" 
                               Width="160" Height="160"
                               Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality" 
                               HorizontalAlignment="Center" 
                               Margin="0,10,0,16"/>

                        <!-- Titles and description -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="Alpha Manager" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                            <TextBlock Text="نظام الجيل الذكي لإدارة الراوتر والشبكات" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                            <TextBlock Text="إدارة احترافية لشبكتك بكفاءة وموثوقية" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            
                            <!-- Soft separator line -->
                            <Border BorderBrush="#F97316" BorderThickness="0,1,0,0" Width="40" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Features Box with target badge icon -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" VerticalAlignment="Top" Margin="0,4,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource TargetIconGeometry}" Fill="#F97316" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="مميزات النظام الرئيسية" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <StackPanel>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="إدارة وتوليد وطباعة الكروت والـ Vouchers بكفاءة عالية" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="كشف ومراقبة أجهزة الشبكة تلقائياً (Neighbors)" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="التحكم الكامل عبر User Manager داخلياً وخارجياً" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="نظام نسخ احتياطي لقاعدة البيانات وإعدادات الراوتر" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Text="التهيئة والضبط السريع وتحديث أجهزة البث بنقرة واحدة" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Bottom Version Info & Security Status Row -->
                        <Grid Grid.Row="3" Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Version -->
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <Ellipse Width="6" Height="6" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center">
                                    <Run Text="الإصدار "/>
                                    <Run Text="{Binding AppVersion, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Security Status -->
                            <StackPanel Orientation="Horizontal" Grid.Column="1">
                                <Path Data="{StaticResource ShieldIconGeometry}" Fill="#F59E0B" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="اتصال آمن ومحمي" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ================= Grid.Column="1" (VISUAL CENTER PANEL): SAVED & DISCOVERED ================= -->
                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <!-- Saved Routers Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Saved Routers List -->
                        <RowDefinition Height="2*"/>
                        <!-- Separator line -->
                        <RowDefinition Height="Auto"/>
                        <!-- Discovered MNDP Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Discovered MNDP List -->
                        <RowDefinition Height="1.5*"/>
                        <!-- Bottom Info Tip badge -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Saved Routers Header Title -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DiskIconGeometry}" Fill="#0F172A" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الأجهزة المحفوظة" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#2563EB" CornerRadius="10" Padding="8,2" Visibility="{Binding SavedRouters.Count, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SavedRouters.Count}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <!-- Saved Routers List -->
                    <ListBox Grid.Row="1" 
                             Style="{StaticResource ConnectionCardListBoxStyle}"
                             ItemsSource="{Binding SavedRouters}"
                             SelectedItem="{Binding SelectedSavedRouter}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Action elements -->
                                            <ColumnDefinition Width="*"/>    <!-- Text & Badge -->
                                            <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Action elements StackPanel on visual right (Column 0 in RTL) -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Context Menu Options (three dots) -->
                                            <Button Style="{StaticResource ThreeDotsButtonStyle}" Click="MenuButton_Click" Margin="0,0,8,0">
                                                <Button.ContextMenu>
                                                    <ContextMenu FlowDirection="RightToLeft">
                                                        <MenuItem Header="حذف الجهاز" Command="{Binding DataContext.DeleteSavedRouterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <!-- Connect Button -->
                                            <Button Content="اتصال" Command="{Binding DataContext.ConnectSavedRouterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource SmallPrimaryButtonStyle}" Margin="0,0,8,0"/>
                                            <!-- Favorite Toggle star -->
                                            <ToggleButton IsChecked="{Binding IsFavorite}" Style="{StaticResource FavoriteToggleButtonStyle}"/>
                                        </StackPanel>

                                        <!-- Device Text & Primary Badge -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                <!-- Primary Badge -->
                                                <Border x:Name="PrimaryBadge" Background="#DCFCE7" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <TextBlock Text="الرئيسي" Foreground="#16A34A" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Host}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Blue Router Icon Box on visual left (Column 2 in RTL) -->
                                        <Border Grid.Column="2" Width="36" Height="36" CornerRadius="8" Background="#EFF6FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource ServerPortsIconGeometry}" Fill="#2563EB" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Display Primary Badge dynamically for 192.168.1.45 IP -->
                                    <DataTrigger Binding="{Binding Host}" Value="192.168.1.45">
                                        <Setter TargetName="PrimaryBadge" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Separator Line -->
                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,2,0,8"/>

                    <!-- Discovered MNDP Header Title -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource WifiIconGeometry}" Fill="#0F172A" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="المكتشفة على الشبكة (MNDP)" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"/>
                            <hc:LoadingCircle Width="14" Height="14" Margin="8,0,0,0" Foreground="#2563EB" Visibility="{Binding IsDiscovering, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="تحديث" Command="{Binding RefreshDiscoveryCommand}" Style="{StaticResource SmallRefreshButtonStyle}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                    </Grid>

                    <!-- Discovered MNDP List -->
                    <ListBox Grid.Row="4" 
                             Style="{StaticResource ConnectionCardListBoxStyle}"
                             ItemsSource="{Binding DiscoveredDevices}"
                             SelectedItem="{Binding SelectedDevice}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Select and Add button (+) on visual right (Column 0 in RTL) -->
                                        <Button Grid.Column="0" Content="+" Click="AddDeviceButton_Click" Style="{StaticResource RoundAddButtonStyle}"/>

                                        <!-- Device Text & Status Badge -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Identity}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                <Border Background="#DCFCE7" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="متاح" Foreground="#16A34A" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Green Discovered Icon Box on visual left (Column 2 in RTL) -->
                                        <Border Grid.Column="2" Width="36" Height="36" CornerRadius="8" Background="#DCFCE7" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource RouterSwitchIconGeometry}" Fill="#16A34A" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Bottom Info Tip badge -->
                    <Border Grid.Row="5" Background="#F1F5F9" CornerRadius="8" Padding="12,8" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource LockIconGeometry}" Fill="#64748B" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="يتم تخزين بيانات الاتصال محلياً فقط على جهازك" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= Grid.Column="0" (VISUAL RIGHT PANEL): MANUAL CONNECTION ================= -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header Form titles -->
                            <RowDefinition Height="Auto"/>
                            <!-- Spacing / Banners -->
                            <RowDefinition Height="Auto"/>
                            <!-- Scrollable connection fields -->
                            <RowDefinition Height="*"/>
                            <!-- Primary & Secondary connection action buttons -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Form Titles -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource LinkIconGeometry}" Fill="#0F172A" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="اتصال يدوي جديد" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="الرجاء إدخال بيانات الاتصال أو تخطي للوصول" FontSize="11.5" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Error Banner (In case of authentication/connection failure) -->
                        <Border Grid.Row="1" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12" Visibility="{Binding ErrorMessage, Converter={StaticResource String2VisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⚠️" Margin="0,0,8,0" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="16" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Scrollable connection inputs -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Host (IP / Domain) -->
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="عنوان IP أو اسم المضيف" FontSize="12.5" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" 
                                             hc:InfoElement.Placeholder="مثال: 192.168.1.1 أو router.local"
                                             Style="{StaticResource ModernFieldTextBoxStyle}"
                                             Tag="{StaticResource GlobeIconGeometry}"
                                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                                </StackPanel>

                                <!-- Port -->
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="منفذ API" FontSize="12.5" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" 
                                             hc:InfoElement.Placeholder="8728" 
                                             Style="{StaticResource ModernFieldTextBoxStyle}"
                                             Tag="{StaticResource LinkIconGeometry}"
                                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                                </StackPanel>

                                <!-- Username -->
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="اسم المستخدم" FontSize="12.5" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                             hc:InfoElement.Placeholder="admin" 
                                             Style="{StaticResource ModernFieldTextBoxStyle}"
                                             Tag="{StaticResource UserIconGeometry}"
                                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                                </StackPanel>

                                <!-- Password (Wrapped for Icon & Focus Border styling) -->
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="كلمة المرور" FontSize="12.5" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <Border CornerRadius="8" Background="#FFFFFF" Height="40" x:Name="PasswordBorder">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding ElementName=PasswordBoxControl, Path=IsFocused}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#2563EB"/>
                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Password Icon -->
                                            <Path Grid.Column="0" Data="{StaticResource LockIconGeometry}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="#94A3B8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=PasswordBoxControl, Path=IsFocused}" Value="True">
                                                                <Setter Property="Fill" Value="#2563EB"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            
                                            <!-- Masked input with built-in eye toggle -->
                                            <PasswordBox x:Name="PasswordBoxControl" 
                                                         Grid.Column="1"
                                                         PasswordChanged="PasswordBoxControl_PasswordChanged"
                                                         hc:InfoElement.Placeholder="أدخل كلمة المرور" 
                                                         Style="{StaticResource PasswordBoxExtend}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         VerticalContentAlignment="Center"
                                                         FlowDirection="LeftToRight"
                                                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Primary & Secondary connection action buttons -->
                        <StackPanel Grid.Row="3" Margin="0,4,0,0">
                            <!-- Connect -->
                            <Button Command="{Binding ConnectCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource MainPrimaryButtonStyle}"/>
                            
                            <!-- Spacer -->
                            <Border Height="10"/>

                            <!-- Exit -->
                            <Button Click="ExitApp_Click"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource MainSecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= BOTTOM NAVIGATION BAR ================= -->
            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#FFFFFF" CornerRadius="0,0,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left Item (Documentation) -->
                        <ColumnDefinition Width="*"/>
                        <!-- Center Item (Technical Support) -->
                        <ColumnDefinition Width="*"/>
                        <!-- Right Item (Settings) -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Documentation -->
                    <Button Grid.Column="2" Style="{StaticResource BottomBarButtonStyle}" Click="DocumentationButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource BookIconGeometry}" Fill="#475569" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="دليل المستخدم" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Center: Support -->
                    <Button Grid.Column="1" Style="{StaticResource BottomBarButtonStyle}" Click="SupportButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource HeadsetIconGeometry}" Fill="#475569" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الدعم الفني" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Right: Settings -->
                    <Button Grid.Column="0" Style="{StaticResource BottomBarButtonStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="{StaticResource GearIconGeometry}" Fill="#475569" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="الإعدادات" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
