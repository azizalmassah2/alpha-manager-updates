<UserControl x:Class="Lux.Management.Console.Views.LicensePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:coreViews="clr-namespace:Lux.Management.Console.Core.Views"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000"
             FlowDirection="RightToLeft">
    
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ PAGE HEADER ══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="الترخيص والتسجيل" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="إدارة التراخيص ومعلومات الترخيص النشط لبرنامج Alpha Manager" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══ PAGE CONTENT ══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left" Width="900">
                
                <!-- 🚫 CASE 1: No Connection Warning -->
                <Border Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRouterConnected}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border Background="{DynamicResource ErrorBackgroundBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="⚠️ يرجى الاتصال بالراوتر أولاً لتفعيل البرنامج" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="نظام التفعيل يعتمد على البصمة الفريدة للراوتر المتصل حالياً. يرجى الاتصال بالراوتر من الشاشة الرئيسية ثم العودة لهذه الصفحة لإجراء التفعيل." 
                                       FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Grid.Row="2" Content="🔌 فتح نافذة الاتصال بالراوتر" 
                                    Command="{Binding OpenConnectionDialogCommand}"
                                    Style="{DynamicResource OutlineButtonStyle}" 
                                    HorizontalAlignment="Right" Padding="20,8"/>
                        </Grid>
                    </Border>
                </Border>
 
                <!-- 📶 CASE 2: Router is Connected -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRouterConnected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Right Column: بيانات المايكروتيك (Merged Router Info & Hardware ID) -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Title -->
                            <TextBlock Grid.Row="0" Text="بيانات المايكروتيك" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                            <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5" Margin="0,0,0,12"/>

                            <!-- Section: بصمة الجهاز -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                <TextBlock Text="بصمة الراوتر الفريدة (Hardware ID):" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" 
                                             Text="{Binding FormattedHardwareId, Mode=OneWay}" 
                                             IsReadOnly="True" 
                                             Background="{DynamicResource SurfaceAltBrush}" 
                                             BorderBrush="{DynamicResource BorderBrush}" 
                                             Padding="10,0" 
                                             FontFamily="Consolas" 
                                             FontSize="12.5" 
                                             FontWeight="Bold" 
                                             Foreground="{DynamicResource SuccessBrush}" 
                                             VerticalContentAlignment="Center" 
                                             Height="36"/>
                                    <Button Grid.Column="1" 
                                            Content="نسخ البصمة 📋" 
                                            Command="{Binding CopyHwidCommand}" 
                                            Margin="8,0,0,0" 
                                            Padding="14,0" 
                                            Height="36" 
                                            Style="{DynamicResource OutlineButtonStyle}"
                                            Cursor="Hand"/>
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="3" Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.3" Margin="0,4,0,12"/>

                            <!-- Section: معلومات الجهاز -->
                            <TextBlock Grid.Row="4" Text="تفاصيل نظام المايكروتيك:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                            
                            <Grid Grid.Row="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: Name & IP -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="اسم الجهاز" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding RouterName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                    <TextBlock Text="عنوان IP" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding RouterIp}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Row 1: Status & Version -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="حالة الاتصال" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRouterConnected}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="غير متصل"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRouterConnected}" Value="True">
                                                            <Setter Property="Text" Value="متصل"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                    <TextBlock Text="إصدار RouterOS" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding RouterVersion}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Row 2: Model & Architecture -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="الموديل" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding RouterModel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                                    <TextBlock Text="المعمارية" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding RouterArchitecture}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Row 3: Serial Number -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                                    <TextBlock Text="الرقم التسلسلي" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding SerialRaw}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 2. Left Column: تفعيل الترخيص + معلومات الترخيص (stacked) -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                        
                        <!-- Card: تفعيل الترخيص -->
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="تفعيل الترخيص" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                                <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5" Margin="0,0,0,12"/>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="قم باستعراض ملف الترخيص الصادر للراوتر المتصل حالياً لتفعيل الميزات." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <!-- File selection box -->
                                    <Grid Grid.Row="1" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" 
                                                 IsReadOnly="True" 
                                                 Background="{DynamicResource SurfaceAltBrush}" 
                                                 BorderBrush="{DynamicResource BorderBrush}" 
                                                 Padding="10,0" 
                                                 FontSize="12.5" 
                                                 VerticalContentAlignment="Center"
                                                 HorizontalAlignment="Stretch"
                                                 Height="36"
                                                 Text="{Binding DisplayFilePath, Mode=OneWay}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedFilePath}" Value="">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <Button Grid.Column="1" 
                                                Content="استعراض 📂" 
                                                Command="{Binding BrowseLicenseCommand}" 
                                                Margin="8,0,0,0" 
                                                Padding="14,0" 
                                                Height="36"
                                                Style="{DynamicResource OutlineButtonStyle}"
                                                Cursor="Hand"/>
                                    </Grid>

                                    <!-- Activate Button -->
                                    <Button Grid.Row="2" Content="تفعيل الترخيص 🔑"
                                            Command="{Binding ActivateLicenseCommand}"
                                            Height="36" Cursor="Hand"
                                            Background="{DynamicResource PrimaryBrush}"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            FontSize="12.5"
                                            BorderThickness="0"
                                            HorizontalAlignment="Left"
                                            Padding="24,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Card: معلومات الترخيص -->
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="معلومات الترخيص النشط" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                                <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5" Margin="0,0,0,12"/>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 0: Status & Type -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="حالة الترخيص" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLicenseValid}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LicenseStatus}" Value="منتهي الصلاحية ❌">
                                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="● غير مرخص"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLicenseValid}" Value="True">
                                                                <Setter Property="Text" Value="✓ مرخص"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LicenseStatus}" Value="منتهي الصلاحية ❌">
                                                                <Setter Property="Text" Value="⚠ منتهي"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                        <TextBlock Text="نوع الترخيص" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding LicenseType}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Row 1: Issue Date & Expiry Date -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="تاريخ الإصدار" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding LicenseIssueDate}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                        <TextBlock Text="تاريخ الانتهاء" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding LicenseExpiryDate}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Row 2: Days Remaining & Owner -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="الأيام المتبقية" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding DaysRemaining, StringFormat='{}{0} يوم'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                                        <TextBlock Text="صاحب الترخيص" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding LicenseOwner}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Row 3: Linked Router -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                                        <TextBlock Text="الراوتر المرتبط" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding LinkedRouter}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
