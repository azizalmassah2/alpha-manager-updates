<UserControl x:Class="Lux.Management.Console.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800"
             FlowDirection="RightToLeft">
    
    <UserControl.Resources>
        <Style x:Key="VisibleIfUpdating" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="حول البرنامج" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="معلومات الإصدار والدعم الفني لبرنامج Alpha Manager" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left" Width="800">
                
                <!-- Main Branding Card -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon/Logo -->
                        <Image Grid.Column="0" Source="pack://application:,,,/Resources/img/logo2.png" Width="70" Height="70" Margin="0,0,20,0" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding AppVersion, StringFormat='الإصدار: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,6"/>
                            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Copyright}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Status Card -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="تحديثات النظام" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,4"/>
                            <TextBlock Text="{Binding AppVersion, StringFormat='الإصدار المثبت حالياً: {0}'}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="🔎 فحص التحديثات الآن" 
                                Command="{Binding CheckForUpdatesCommand}"
                                IsEnabled="{Binding IsChecking, Converter={StaticResource StringToBoolConverter}, ConverterParameter=false}"
                                Style="{DynamicResource PrimaryButtonStyle}" 
                                Padding="20,10"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Update Details Card (Visible only when update found) -->
                <Border Style="{StaticResource VisibleIfUpdating}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="✨ يتوفر إصدار جديد للتثبيت!" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,10"/>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="{Binding UpdateVersion, StringFormat='الإصدار المتاح: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                        
                        <TextBlock Text="سجل التغييرات (Changelog):" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <TextBlock Text="{Binding Changelog}" FontSize="12.5" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" FontFamily="Consolas"/>
                        </Border>

                        <Button Content="📥 تنزيل وتثبيت التحديث الآن" 
                                Command="{Binding DownloadUpdateCommand}"
                                Style="{DynamicResource PrimaryButtonStyle}" 
                                Background="{DynamicResource SuccessBrush}"
                                Foreground="White"
                                HorizontalAlignment="Right"
                                Padding="24,10"/>
                    </StackPanel>
                </Border>

                <!-- Technical Details Card -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Right: Details -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="معلومات المطور والدعم الفني" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,16"/>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: Developer -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="المطور:" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="ابو احمد المساح" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10" VerticalAlignment="Center"/>

                                <!-- Row 1: Support Phone -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="الدعم الفني:" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="771122633" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <Border Margin="8,0,0,0" CornerRadius="4" Background="#151890FF" BorderBrush="#301890FF" BorderThickness="1" Padding="6,2">
                                        <TextBlock Text="اتصال مباشر 📞" FontSize="10" Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Row 2: Facebook Link -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="فيسبوك:" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" VerticalAlignment="Center">
                                    <Hyperlink NavigateUri="https://facebook.com/aziz.almassah" RequestNavigate="Hyperlink_RequestNavigate">
                                        <TextBlock Text="facebook.com/aziz.almassah" FontSize="13" FontWeight="SemiBold"/>
                                    </Hyperlink>
                                </TextBlock>

                                <!-- Row 3: Telegram Link -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="تلجرام:" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" VerticalAlignment="Center">
                                    <Hyperlink NavigateUri="https://t.me/alpha_amn" RequestNavigate="Hyperlink_RequestNavigate">
                                        <TextBlock Text="t.me/alpha_amn" FontSize="13" FontWeight="SemiBold"/>
                                    </Hyperlink>
                                </TextBlock>

                                <!-- Row 4: Environment -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="بيئة التشغيل:" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text=".NET 8.0 (Windows Presentation Foundation)" FontSize="12.5" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10" VerticalAlignment="Center"/>

                                <!-- Row 5: Notes -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="ملاحظة:" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="للدعم الفني وتحديث التراخيص يرجى التواصل عبر أرقام أو صفحات الدعم الموضحة." FontSize="12" Foreground="{DynamicResource ThirdTextBrush}" TextWrapping="Wrap" LineHeight="18"/>
                            </Grid>
                        </StackPanel>

                        <!-- Left: QR Code -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Top" Width="180">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8" Background="White" Margin="0,0,0,8">
                                <Image Source="pack://application:,,,/Resources/img/telegram_qr.png" Width="140" Height="170" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="قناة التلجرام الرسمية" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="امسح الرمز للاشتراك" FontSize="10" Foreground="{DynamicResource ThirdTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
