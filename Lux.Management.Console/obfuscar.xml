<?xml version="1.0" encoding="utf-8" ?>
<Obfuscator>
  <Var name="InPath" value="." />
  <Var name="OutPath" value=".\Obfuscated" />
  
  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameEvents" value="false" />
  <Var name="RenameFields" value="true" />
  <Var name="UseUnicodeNames" value="false" />
  <Var name="HideStrings" value="true" />
  <Var name="OptimizeMethods" value="true" />
  <Var name="SuppressIldasm" value="true" />

  <Module file="$(InPath)\Lux.Management.Console.dll">
    <Var name="KeepPublicApi" value="false" />
    <Var name="RenameProperties" value="false" />
    
    <!-- Skip views/viewmodels to prevent WPF XAML parsing/binding exceptions -->
    <SkipType name="Lux.Management.Console.App" />
    <SkipType name="Lux.Management.Console.ViewModels.*" />
    <SkipType name="Lux.Management.Console.Views.*" />
    <SkipType name="Lux.Management.Console.Modules.*" />
    <SkipNamespace name="Lux.Management.Console.ViewModels" />
    <SkipNamespace name="Lux.Management.Console.Views" />
    <SkipNamespace name="Lux.Management.Console.Navigation" />
    <SkipNamespace name="Lux.Management.Console.Services" />
  </Module>

  <Module file="$(InPath)\MikroTikVoucherPrinter.Infrastructure.dll" />
  <Module file="$(InPath)\MikroTikVoucherPrinter.Application.dll" />
  <Module file="$(InPath)\Lux.OpenWrt.dll" />
  <Module file="$(InPath)\Lux.MikroTik.dll" />
  <Module file="$(InPath)\Lux.Platform.Abstractions.dll" />
</Obfuscator>
