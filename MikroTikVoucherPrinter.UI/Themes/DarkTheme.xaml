<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════ Dark Theme (Deep Navy/Charcoal) ══════════════════ -->

    <!-- Base Colors -->
    <Color x:Key="AppBackgroundColor">#0B0F19</Color>
    <Color x:Key="SurfaceCardColor">#151A28</Color>
    <Color x:Key="PrimaryActionColor">#00ADFF</Color>
    <Color x:Key="TextMainColor">#FFFFFF</Color>
    <Color x:Key="TextMutedColor">#8B949E</Color>
    <Color x:Key="BorderColor">#2A3241</Color>
    <Color x:Key="InputFillColor">#111520</Color>
    <Color x:Key="InputStrokeColor">#33FFFFFF</Color>
    
    <!-- Base Brushes (The Keys to bind to) -->
    <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceCard" Color="{StaticResource SurfaceCardColor}"/>
    <SolidColorBrush x:Key="PrimaryAction" Color="{StaticResource PrimaryActionColor}"/>
    <SolidColorBrush x:Key="TextMain" Color="{StaticResource TextMainColor}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="InputFill" Color="{StaticResource InputFillColor}"/>
    <SolidColorBrush x:Key="InputStroke" Color="{StaticResource InputStrokeColor}"/>

    <!-- DataGrid Alternating Row -->
    <SolidColorBrush x:Key="DataGridAltRow" Color="#181D2E"/>

</ResourceDictionary>
