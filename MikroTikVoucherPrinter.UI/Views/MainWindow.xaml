<Window x:Class="MikroTikVoucherPrinter.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:MikroTikVoucherPrinter.UI.Views.Pages"
        xmlns:vm="clr-namespace:MikroTikVoucherPrinter.UI.ViewModels.Pages"
        Title="لوكس كارد - نظام طباعة الكروت" 
        Height="700" Width="1200"
        MinHeight="600" MinWidth="1024"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        FlowDirection="RightToLeft"
        FontFamily="Tajawal, Segoe UI Variable, Segoe UI"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- DataTemplates for Navigation — styles are all in App.xaml -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><pages:DashboardPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GenerateVoucherViewModel}"><pages:GenerateVoucherPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VoucherManagementViewModel}"><pages:VoucherManagementPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SyncViewModel}"><pages:SyncPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrintCenterViewModel}"><pages:PrintCenterPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileManagementViewModel}"><pages:ProfileManagementPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AgentManagementViewModel}"><pages:AgentManagementPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TemplateManagementViewModel}"><pages:TemplateManagementPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DbExplorerViewModel}"><pages:DbExplorerPage/></DataTemplate>
    </Window.Resources>



    <!-- ROOT GRID: Row 0 Header, Row 1 Content -->
    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <!-- Pinned Header Row -->
            <RowDefinition Height="Auto"/>
            <!-- Viewport Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ Row 0: Mandatory Header ═══════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
            <Grid FlowDirection="LeftToRight" Margin="0,8">
                <!-- Left Side: Logo and App Name -->
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <!-- Mini Logo -->
                    <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource PrimaryHueMidBrushColor}" Offset="0"/>
                                <GradientStop Color="#00E5FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- App Name -->
                    <TextBlock Text="LuxCard" FontSize="14" FontWeight="Black" Foreground="{DynamicResource MaterialDesignBody}" FontFamily="Segoe UI Variable" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Enterprise" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" FontFamily="Segoe UI Variable" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right Side: Window Controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChromeButton}" Command="{Binding ToggleThemeCommand}" ToolTip="تبديل الثيم">
                        <TextBlock Text="{Binding ThemeIcon}" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="MinimizeButton_Click" ToolTip="تصغير">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="MaximizeButton_Click" ToolTip="تكبير">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button Style="{StaticResource ChromeCloseButton}" Click="CloseButton_Click" ToolTip="إغلاق">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ Row 1: The Viewport Solution ═══════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Viewbox Stretch="Uniform" VerticalAlignment="Top">
                <Grid Width="1400" Height="800" Background="{DynamicResource MaterialDesignPaper}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/> <!-- Fixed Width Sidebar -->
                        <ColumnDefinition Width="*"/>   <!-- Dynamic Content -->
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar (Modern Fluent Navigation Rail) -->
                    <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Modern Premium Logo Area -->
                            <Border Grid.Row="0" Padding="20,24,20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Glow Accent -->
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2563EB" Offset="0"/>
                                                <GradientStop Color="#3B82F6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#3B82F6" Opacity="0.4" BlurRadius="12" ShadowDepth="2" Direction="270"/>
                                        </Border.Effect>
                                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="LuxCard" FontSize="18" FontWeight="Black" Foreground="{DynamicResource MaterialDesignBody}" FontFamily="Segoe UI"/>
                                        <TextBlock Text="ISP Operations Center" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Segoe UI Variable" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Fluent Navigation System -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10" Style="{StaticResource MaterialDesignScrollViewer}">
                                <StackPanel>
                                    <!-- SECTION 1: Operations -->
                                    <TextBlock Text="نظام التشغيل" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="28,8,28,4" TextAlignment="Right"/>
                                    <RadioButton Style="{StaticResource PillSidebarButtonStyle}" Tag="&#xE80F;" Content="لوحة المراقبة (NOC)" IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityConverter}, ConverterParameter=Dashboard}" Command="{Binding NavigateToCommand}" CommandParameter="Dashboard"/>
                                    
                                    <!-- SECTION 2: Production -->
                                    <TextBlock Text="خط الإنتاج" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="28,20,28,4" TextAlignment="Right"/>
                                    <RadioButton Style="{StaticResource PillSidebarButtonStyle}" Tag="&#xE8C8;" Content="توليد كروت جديدة" IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityConverter}, ConverterParameter=Generate}" Command="{Binding NavigateToCommand}" CommandParameter="Generate"/>
                                    <RadioButton Style="{StaticResource PillSidebarButtonStyle}" Tag="&#xE749;" Content="إدارة العمليات" IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityConverter}, ConverterParameter=Management}" Command="{Binding NavigateToCommand}" CommandParameter="Management"/>
                                    <RadioButton Style="{StaticResource PillSidebarButtonStyle}" Tag="&#xE773;" Content="المزامنة والسحب" IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityConverter}, ConverterParameter=Sync}" Command="{Binding NavigateToCommand}" CommandParameter="Sync"/>
                                    <RadioButton Style="{StaticResource PillSidebarButtonStyle}" Tag="&#xE749;" Content="تصدير للطباعة" IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityConverter}, ConverterParameter=Print}" Command="{Binding NavigateToCommand}" CommandParameter="Print"/>

                                    <!-- SECTION 3: Configuration -->
                                    <TextBlock Text="التكوين والبنية" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="28,20,28,4" TextAlignment="Right"/>
                                    <RadioButton Style="{StaticResource PillSidebarButtonStyle}" Tag="&#xE81E;" Content="باقات الإنترنت" IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityConverter}, ConverterParameter=ProfileManagement}" Command="{Binding NavigateToCommand}" CommandParameter="ProfileManagement"/>
                                    <RadioButton Style="{StaticResource PillSidebarButtonStyle}" Tag="&#xE716;" Content="نظام الوكلاء" IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityConverter}, ConverterParameter=AgentManagement}" Command="{Binding NavigateToCommand}" CommandParameter="AgentManagement"/>
                                    <RadioButton Style="{StaticResource PillSidebarButtonStyle}" Tag="&#xE7B3;" Content="قوالب الرندر" IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityConverter}, ConverterParameter=TemplateManagement}" Command="{Binding NavigateToCommand}" CommandParameter="TemplateManagement"/>
                                    <RadioButton Style="{StaticResource PillSidebarButtonStyle}" Tag="&#xE713;" Content="إعدادات الـ API" IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityConverter}, ConverterParameter=Settings}" Command="{Binding NavigateToCommand}" CommandParameter="Settings"/>

                                    <!-- SECTION 4: Dev Tools (Temporary) -->
                                    <TextBlock Text="أدوات التطوير" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="28,20,28,4" TextAlignment="Right"/>
                                    <RadioButton Style="{StaticResource PillSidebarButtonStyle}" Tag="&#xEA37;" Content="استعراض قاعدة البيانات" IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityConverter}, ConverterParameter=DbExplorer}" Command="{Binding NavigateToCommand}" CommandParameter="DbExplorer"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Modern User Presence Card -->
                            <Border Grid.Row="2" Margin="16,0,16,20" Padding="12" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="8" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Avatar -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- Online Presence -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="مدير النظام" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <!-- Green Indicator if Connected -->
                                            <Ellipse Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#EF4444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMikroTikConnected}" Value="True">
                                                                <Setter Property="Fill" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding MikroTikConnectionText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMikroTikConnected}" Value="True">
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Logout Action -->
                                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconForegroundButton}" Width="28" Height="28" Padding="0" Foreground="#94A3B8" ToolTip="تسجيل الخروج">
                                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Main Content Column -->
                    <Grid Grid.Column="1" Background="#F8FAFC">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Top Status Bar -->
                            <RowDefinition Height="Auto"/> <!-- Page Title Header -->
                            <RowDefinition Height="*"/>    <!-- Page Content -->
                        </Grid.RowDefinitions>

                        <!-- Enterprise Top Status Bar -->
                        <Border Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="24,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- MikroTik Connection LED -->
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#EF4444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMikroTikConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#10B981"/> <!-- Emerald Green -->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding MikroTikConnectionText, FallbackValue='Connecting...'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,24,0"/>
                                    
                                    <!-- Network Metrics (Static UI presentation, data binds to nothing yet but adds the Enterprise feel) -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsMikroTikConnected, Converter={StaticResource BoolToVisConverter}}">
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Ping: 12ms" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Users: 48" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="CPU: 8%" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right Actions -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentViewModel.StatusMessage, FallbackValue='System Ready'}" FontSize="12" Foreground="#94A3B8" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Page Header -->
                        <Grid Grid.Row="1" Margin="32,24,32,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentViewModel.Title, FallbackValue='إدارة الكروت'}" FontSize="28" FontWeight="Black" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBlock Text="إدارة ومتابعة جميع العمليات من واجهة واحدة تفاعلية" FontSize="14" Foreground="#64748B"/>
                            </StackPanel>
                        </Grid>

                        <!-- Dynamic Page Content -->
                        <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}" Margin="0,0,0,0"/>
                    </Grid>
                </Grid>
            </Viewbox>
        </ScrollViewer>
    </Grid>
</Window>
