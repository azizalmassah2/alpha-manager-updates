<Window x:Class="MikroTikVoucherPrinter.UI.Views.Windows.UserReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تقرير المستخدم" Height="650" Width="550"
        WindowStartupLocation="CenterOwner"
        FontFamily="Tajawal, Segoe UI Variable, sans-serif"
        FlowDirection="RightToLeft"
        Background="#F8FAFC">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="تقرير شامل للمستخدم" FontSize="14" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtUserName" Text="UserName" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- معلومات عامة -->
                <TextBlock Text="معلومات عامة" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="4,0,0,8"/>
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="الباقة المشتركة" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtProfile" Text="—" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="حالة الكرت" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtStatus" Text="—" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="تاريخ التسجيل" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtRegDate" Text="—" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="آخر ظهور" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtLastSeen" Text="—" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- الإحصائيات -->
                <TextBlock Text="إحصائيات الاستهلاك" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="4,0,0,8"/>
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="إجمالي التنزيل" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtDownload" Text="0 MB" FontSize="16" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="إجمالي الرفع" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtUpload" Text="0 MB" FontSize="16" FontWeight="Bold" Foreground="#8B5CF6"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="إجمالي وقت الاتصال" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtUptime" Text="0 دقيقة" FontSize="16" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="عدد الجلسات (سجل الاتصال)" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtSessionsCount" Text="0 جلسة" FontSize="16" FontWeight="Bold" Foreground="#3B82F6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- العناوين (IP و MAC) -->
                <TextBlock Text="سجل العناوين المستخدمة" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="4,0,0,8"/>
                <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="عناوين IP المرتبطة:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtIPs" Text="لا يوجد" FontSize="13" Foreground="#0F172A" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="عناوين MAC المرتبطة:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtMACs" Text="لا يوجد" FontSize="13" Foreground="#0F172A" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Actions -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16,12" Margin="0,16,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إغلاق" IsCancel="True" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0" Width="100"/>
                <Button x:Name="BtnSavePdf" Content="حفظ كملف PDF" Click="BtnSavePdf_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#EF4444" BorderBrush="#EF4444" Foreground="White" Width="140">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA90;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="حفظ كملف PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
