<UserControl x:Class="MikroTikVoucherPrinter.UI.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             FontFamily="Tajawal, Segoe UI Variable, sans-serif"
             Background="Transparent">

    <UserControl.Resources>
        <!-- ISP Color Palette -->
        <Color x:Key="BrandBlue">#2563EB</Color>
        <Color x:Key="BrandDark">#1E3A8A</Color>
        <Color x:Key="Slate900">#0F172A</Color>
        <Color x:Key="Slate800">#1E293B</Color>
        <Color x:Key="Slate100">#F1F5F9</Color>
        <Color x:Key="Slate50">#F8FAFC</Color>
        <Color x:Key="Emerald500">#10B981</Color>
        <Color x:Key="Rose500">#F43F5E</Color>
        <Color x:Key="Amber500">#F59E0B</Color>
        <Color x:Key="Purple500">#8B5CF6</Color>

        <SolidColorBrush x:Key="Brush.Brand" Color="{StaticResource BrandBlue}"/>
        <SolidColorBrush x:Key="Brush.Slate900" Color="{StaticResource Slate900}"/>
        <SolidColorBrush x:Key="Brush.Slate800" Color="{StaticResource Slate800}"/>
        <SolidColorBrush x:Key="Brush.Emerald" Color="{StaticResource Emerald500}"/>
        <SolidColorBrush x:Key="Brush.Rose" Color="{StaticResource Rose500}"/>
        <SolidColorBrush x:Key="Brush.Amber" Color="{StaticResource Amber500}"/>
        <SolidColorBrush x:Key="Brush.Purple" Color="{StaticResource Purple500}"/>

        <!-- Telemetry Widget Style -->
        <Style x:Key="TelemetryWidgetStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Slate900}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Slate800}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.15" Color="Black" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Panel Style -->
        <Style x:Key="OperationalPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="Black" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Action Button Style -->
        <Style x:Key="QuickActionStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                                <!-- Subtle Hover Elevation -->
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.06" Color="Black" Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,12,24,32">
        <StackPanel>
            
            <!-- ═════════════════════════════════════════════════════════════════════════ -->
            <!-- 1. TOP OPERATIONAL STATUS & KPI METRICS GRID (The UniFi / NOC Feeling)     -->
            <!-- ═════════════════════════════════════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                <TextBlock Text="NOC Telemetry" FontSize="18" FontWeight="Black" Foreground="{StaticResource Brush.Slate900}" VerticalAlignment="Center"/>
                <Border Background="#10B981" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                </Border>
            </StackPanel>

            <UniformGrid Columns="4" Margin="0,0,0,24">
                
                <!-- Metric 1: Network Load -->
                <Border Style="{StaticResource TelemetryWidgetStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="ServerNetwork" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="NETWORK LOAD" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding ActiveHotspotUsers, FallbackValue=214}" FontSize="36" FontWeight="Black" Foreground="White" FontFamily="Segoe UI Variable"/>
                                <TextBlock Text="USERS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Emerald}" Margin="6,0,0,6" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock Text="Active Hotspot Sessions" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metric 2: Uptime & Stability -->
                <Border Style="{StaticResource TelemetryWidgetStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="ClockCheckOutline" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="ROUTER UPTIME" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Uptime, FallbackValue='4d 12h'}" FontSize="36" FontWeight="Black" Foreground="White" FontFamily="Segoe UI Variable"/>
                                <TextBlock Text="SYNCED" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Brand}" Margin="6,0,0,6" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock Text="System stability metric" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metric 3: Resource Utilization -->
                <Border Style="{StaticResource TelemetryWidgetStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="Cpu64Bit" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="RESOURCE UTILIZATION" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding CpuLoad, FallbackValue='14'}" FontSize="36" FontWeight="Black" Foreground="White" FontFamily="Segoe UI Variable"/>
                                <TextBlock Text="%" FontSize="24" FontWeight="Bold" Foreground="#94A3B8" Margin="2,0,0,4" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <!-- Mini progress bar mimicking telemetry -->
                            <ProgressBar Value="14" Maximum="100" Height="4" Background="#1E293B" Foreground="{StaticResource Brush.Purple}" BorderThickness="0" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metric 4: Total Capacity -->
                <Border Style="{StaticResource TelemetryWidgetStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="DatabaseOutline" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Text="SYSTEM CAPACITY" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding TotalMikroTikUsers, FallbackValue='4,102'}" FontSize="36" FontWeight="Black" Foreground="White" FontFamily="Segoe UI Variable"/>
                                <TextBlock Text="VOUCHERS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Amber}" Margin="6,0,0,6" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock Text="Total registered users" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </UniformGrid>

            <!-- ═════════════════════════════════════════════════════════════════════════ -->
            <!-- 2. LOWER SECTION: NETWORK HEALTH & QUICK OPERATIONS & ACTIVITY FEED       -->
            <!-- ═════════════════════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Operational Grid (Health + Actions) -->
                    <ColumnDefinition Width="2*"/>
                    <!-- Right: Activity Feed -->
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    
                    <!-- Network Health Panel -->
                    <TextBlock Text="Network Health" FontSize="16" FontWeight="Black" Foreground="{StaticResource Brush.Slate900}" Margin="0,0,0,12" FontFamily="Segoe UI"/>
                    <Border Style="{StaticResource OperationalPanelStyle}" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Emerald}" VerticalAlignment="Center"/>
                                    <TextBlock Text="API Connection" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Connected &amp; Stable" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Slate900}"/>
                                <TextBlock Text="Latency: ~2ms" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="16,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Brand}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sync Engine" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Idle / Ready" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Slate900}"/>
                                <TextBlock Text="Last sync: 2m ago" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Emerald}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Database" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Local Vault Active" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Slate900}"/>
                                <TextBlock Text="Cache hits: 99%" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quick Operations Grid -->
                    <TextBlock Text="Operational Workspace" FontSize="16" FontWeight="Black" Foreground="{StaticResource Brush.Slate900}" Margin="0,0,0,12" FontFamily="Segoe UI"/>
                    <UniformGrid Columns="2" Rows="2">
                        <!-- Generate Vouchers -->
                        <Button Style="{StaticResource QuickActionStyle}" Margin="0,0,12,12">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#EFF6FF" Margin="0,0,12,0">
                                    <materialDesign:PackIcon Kind="CardsOutline" Width="18" Height="18" Foreground="{StaticResource Brush.Brand}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="توليد دفعة كروت" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Slate900}"/>
                                    <TextBlock Text="بدء عملية توليد وتصدير" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Print Center -->
                        <Button Style="{StaticResource QuickActionStyle}" Margin="12,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#FEF2F2" Margin="0,0,12,0">
                                    <materialDesign:PackIcon Kind="PrinterOutline" Width="18" Height="18" Foreground="{StaticResource Brush.Rose}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="مركز الطباعة" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Slate900}"/>
                                    <TextBlock Text="طباعة العمليات السابقة" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Settings -->
                        <Button Style="{StaticResource QuickActionStyle}" Margin="0,12,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#F0FDF4" Margin="0,0,12,0">
                                    <materialDesign:PackIcon Kind="RouterWirelessSettings" Width="18" Height="18" Foreground="{StaticResource Brush.Emerald}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="تكوين المايكروتك" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Slate900}"/>
                                    <TextBlock Text="تعديل الـ API والاتصال" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Agent Sync -->
                        <Button Style="{StaticResource QuickActionStyle}" Margin="12,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#F5F3FF" Margin="0,0,12,0">
                                    <materialDesign:PackIcon Kind="AccountSyncOutline" Width="18" Height="18" Foreground="{StaticResource Brush.Purple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="مزامنة الوكلاء" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Slate900}"/>
                                    <TextBlock Text="سحب البيانات من الراوتر" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                </StackPanel>

                <!-- Right Column: Activity Feed -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Live Activity Log" FontSize="16" FontWeight="Black" Foreground="{StaticResource Brush.Slate900}" Margin="0,0,0,12" FontFamily="Segoe UI"/>
                    <Border Style="{StaticResource OperationalPanelStyle}" VerticalAlignment="Stretch">
                        <StackPanel>
                            <!-- Mock Data for Activity Stream -->
                            <!-- Activity 1 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#EFF6FF" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="ServerPlus" Width="14" Height="14" Foreground="{StaticResource Brush.Brand}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="تم توليد 100 كرت بنجاح" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Brush.Slate900}"/>
                                    <TextBlock Text="باقة: شهر مفتوح (Agent: أحمد)" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock Text="Just now" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Grid>

                            <!-- Activity 2 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#F0FDF4" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="CloudSyncOutline" Width="14" Height="14" Foreground="{StaticResource Brush.Emerald}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="مزامنة بيانات الراوتر" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Brush.Slate900}"/>
                                    <TextBlock Text="تم تحديث 4 باقات و 2 وكلاء" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock Text="12 mins ago" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Grid>

                            <!-- Activity 3 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#FEF2F2" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="PrinterCheck" Width="14" Height="14" Foreground="{StaticResource Brush.Rose}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="عملية طباعة مكتملة" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Brush.Slate900}"/>
                                    <TextBlock Text="دفعة رقم #4092 تم تصديرها كـ PDF" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock Text="1 hour ago" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Grid>

                            <!-- Activity 4 -->
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="Login" Width="14" Height="14" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="تسجيل دخول للنظام" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Brush.Slate900}"/>
                                    <TextBlock Text="المستخدم: مدير النظام (Admin)" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock Text="Today, 08:30 AM" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
