<UserControl x:Class="MikroTikVoucherPrinter.UI.Views.Pages.DbExplorerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FlowDirection="RightToLeft"
             FontFamily="Tajawal, Segoe UI Variable, sans-serif"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- شريط الأدوات -->
            <RowDefinition Height="*"/>       <!-- جدول البيانات -->
            <RowDefinition Height="Auto"/>   <!-- شريط الحالة -->
        </Grid.RowDefinitions>

        <!-- ═══════ شريط الأدوات ═══════ -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- اختيار الجدول -->
                        <ColumnDefinition Width="*"/>       <!-- البحث -->
                        <ColumnDefinition Width="Auto"/>   <!-- الأزرار -->
                    </Grid.ColumnDefinitions>

                    <!-- اختيار الجدول -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="الجدول:" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="220" 
                                  ItemsSource="{Binding TableItems}" 
                                  SelectedValue="{Binding SelectedTable}" 
                                  SelectedValuePath="Name"
                                  DisplayMemberPath="DisplayName"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  FlowDirection="RightToLeft"/>
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="عدد الصفوف:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding TotalRows}" FontSize="12" FontWeight="Black" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- شريط البحث -->
                    <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="24,0" Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent" FontSize="13" VerticalContentAlignment="Center" 
                                     materialDesign:HintAssist.Hint="ابحث في بيانات الجدول..." MinHeight="36"/>
                            <Button Grid.Column="2" Content="بحث" Command="{Binding SearchInTableCommand}" 
                                    Style="{StaticResource MaterialDesignFlatMidBgButton}" Height="28" FontSize="11" Margin="4,0,0,0" Padding="12,0"/>
                        </Grid>
                    </Border>

                    <!-- أزرار الإجراءات -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding FetchLiveDatabaseCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="#10B981" BorderBrush="#10B981" Foreground="White"
                                Height="34" FontSize="12" Margin="0,0,12,0" Padding="12,0"
                                ToolTip="يسحب ملف sqldb من المايكروتك مباشرة">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="سحب مباشر من المايكروتك" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" 
                                Style="{StaticResource MaterialDesignFlatMidBgButton}" Height="34" FontSize="12" Margin="0,0,8,0" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="تحديث" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearSearchCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}" Height="34" FontSize="12" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="مسح البحث" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ═══════ فلاتر إضافية (تظهر فقط عند عرض الكروت) ═══════ -->
                <Border Margin="0,16,0,0" Background="#F1F5F9" CornerRadius="8" Padding="12,8"
                        Visibility="{Binding ShowFilters, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="تصفية النتائج:" FontSize="13" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <TextBlock Text="الباقة:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="180" Margin="0,0,24,0"
                                  ItemsSource="{Binding AvailableProfiles}"
                                  SelectedItem="{Binding SelectedProfileFilter, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalContentAlignment="Center" FontSize="13" Background="White" Padding="8,4"/>

                        <TextBlock Text="الحالة:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="160"
                                  ItemsSource="{Binding AvailableStatuses}"
                                  SelectedItem="{Binding SelectedStatusFilter, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalContentAlignment="Center" FontSize="13" Background="White" Padding="8,4"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>


        <!-- ═══════ جدول البيانات ═══════ -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0" ClipToBounds="True">
            <Border.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                        <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <DataGrid ItemsSource="{Binding DataTable}" 
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      RowHeight="45"
                      FontSize="13"
                      FontFamily="Tajawal, Segoe UI Variable, sans-serif"
                      HeadersVisibility="Column"
                      FlowDirection="RightToLeft"
                      hc:DataGridAttach.ShowRowNumber="True"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Margin="8">
            </DataGrid>
        </Border>

        <!-- ═══════ شريط الحالة ═══════ -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="16,8" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="شاشة اختبار مؤقتة — استعراض قاعدة بيانات يوزر مانجر (للقراءة فقط)" 
                               FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- مسار القاعدة -->
                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,2" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="d:\LUXCARD\desktop\user-manager\sqldb" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas, Segoe UI" FlowDirection="LeftToRight"/>
                </Border>

                <!-- مؤشر التحميل -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" 
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- رسالة الخطأ -->
        <Border Grid.Row="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                VerticalAlignment="Top"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ErrorMessage}" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
