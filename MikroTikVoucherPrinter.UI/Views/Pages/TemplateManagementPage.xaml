<UserControl x:Class="MikroTikVoucherPrinter.UI.Views.Pages.TemplateManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MikroTikVoucherPrinter.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1500"
             FlowDirection="RightToLeft"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:MathConverter x:Key="MathConverter"/>
        <converters:DoubleToThicknessConverter x:Key="DoubleToThicknessConverter"/>
        <converters:XYToMarginConverter x:Key="XYToMarginConverter"/>
        <converters:CardSizeConverter x:Key="CardSizeConverter"/>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryHueMidBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <Grid>
                                <TextBlock x:Name="HintText" 
                                           Text="{TemplateBinding Tag}" 
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                           Margin="{TemplateBinding Padding}" 
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                           IsHitTestVisible="False" 
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="HintText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="HintText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Template Selection Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10,12,10,8" Margin="0,0,0,8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="قالب جديد" Command="{Binding AddNewCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0" Padding="16,4" Height="34" VerticalAlignment="Center"/>
                <!-- سويتش ضغط الملف -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="8,0" FlowDirection="LeftToRight">
                    <TextBlock Text="ضغط" VerticalAlignment="Center" Foreground="#FCD34D"
                               FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"
                               FlowDirection="RightToLeft"/>
                    <ToggleButton IsChecked="{Binding CompressOutput}"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="3" Content="📄 معاينة" Command="{Binding PreviewTemplateCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0" Padding="16,4" Height="34" VerticalAlignment="Center" Foreground="#60A5FA"/>
                <Button Grid.Column="4" Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0" Padding="16,4" Height="34" VerticalAlignment="Center"/>
                <Button Grid.Column="5" Content="حذف" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButtonStyle}" Foreground="#F87171" BorderBrush="#F87171" Margin="4,0,0,0" Padding="16,4" Height="34" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Row 1: Basic Template Data and Images (2 rows) -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10,14,10,10" Margin="0,0,0,10" DataContext="{Binding SelectedTemplate}" Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel>
                <!-- Sub-Row 0: Name + Profile + IsDefault -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Padding="8,6" VerticalContentAlignment="Center" Tag="اسم القالب"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.AvailableProfiles, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding LinkedProfileName}" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Tag="باقة المايكروتيك (اختياري)" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="4" Content="قالب افتراضي" IsChecked="{Binding IsDefault}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
                <!-- Sub-Row 1: Background + Logo -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding BackgroundImagePath}" IsReadOnly="True" Style="{StaticResource ModernTextBoxStyle}" Height="32" Padding="8,4" VerticalContentAlignment="Center" Tag="مسار الخلفية"/>
                        <Button Grid.Column="1" Content="📷 خلفية" Command="{Binding DataContext.BrowseBackgroundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Height="32" Padding="8,0"/>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding LogoImagePath}" IsReadOnly="True" Style="{StaticResource ModernTextBoxStyle}" Height="32" Padding="8,4" VerticalContentAlignment="Center" Tag="مسار الشعار"/>
                        <Button Grid.Column="1" Content="🖼 شعار" Command="{Binding DataContext.BrowseLogoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Height="32" Padding="8,0"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>


        <!-- Main 3-Column Layout -->
        <Grid Grid.Row="2" Visibility="{Binding SelectedTemplate, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- RIGHT: Toggles + Element X/Y -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,8,0" DataContext="{Binding SelectedTemplate}">
                <StackPanel>
                    <TextBlock Text="عناصر الكرت" Style="{StaticResource SectionTitleStyle}" FontSize="13"/>
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <StackPanel Margin="2,0,2,8" HorizontalAlignment="Center">
                            <ToggleButton IsChecked="{Binding ShowUsername}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Cursor="Hand"/>
                            <TextBlock Text="رمز الدخول" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="2,0,2,8" HorizontalAlignment="Center">
                            <ToggleButton IsChecked="{Binding ShowPassword}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Cursor="Hand"/>
                            <TextBlock Text="كلمة السر" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="2,0,2,8" HorizontalAlignment="Center">
                            <ToggleButton IsChecked="{Binding ShowSerialNumber}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Cursor="Hand"/>
                            <TextBlock Text="تسلسلي" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="2,0,2,8" HorizontalAlignment="Center">
                            <ToggleButton IsChecked="{Binding ShowPrintDate}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Cursor="Hand"/>
                            <TextBlock Text="تاريخ طبع" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,2,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="2,0,2,8" HorizontalAlignment="Center">
                            <ToggleButton IsChecked="{Binding ShowPrice}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Cursor="Hand"/>
                            <TextBlock Text="السعر" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="2,0,2,8" HorizontalAlignment="Center">
                            <ToggleButton IsChecked="{Binding ShowQr}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Cursor="Hand"/>
                            <TextBlock Text="QR Code" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="2,0,2,8" HorizontalAlignment="Center">
                            <ToggleButton IsChecked="{Binding ShowValidity}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Cursor="Hand"/>
                            <TextBlock Text="الصلاحية" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="2,0,2,8" HorizontalAlignment="Center">
                            <ToggleButton IsChecked="{Binding ShowTime}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Cursor="Hand"/>
                            <TextBlock Text="الوقت" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="2,0,2,8" HorizontalAlignment="Center">
                            <ToggleButton IsChecked="{Binding ShowBarcode}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Cursor="Hand"/>
                            <TextBlock Text="باركود" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </UniformGrid>

                    <Separator Margin="0,0,0,10"/>
                    <TextBlock Text="موقع العنصر" Style="{StaticResource SectionTitleStyle}" FontSize="13"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="X :" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" FontSize="13" FontWeight="SemiBold"/>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="-" Click="BtnActiveXDown_Click" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                                <TextBox Grid.Column="1" x:Name="TxtActiveX" Text="0" IsReadOnly="True" TextAlignment="Center" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12"/>
                                <Button Grid.Column="2" Content="+" Click="BtnActiveXUp_Click" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Y :" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}" FontSize="13" FontWeight="SemiBold"/>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="-" Click="BtnActiveYDown_Click" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                                <TextBox Grid.Column="1" x:Name="TxtActiveY" Text="0" IsReadOnly="True" TextAlignment="Center" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12"/>
                                <Button Grid.Column="2" Content="+" Click="BtnActiveYUp_Click" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CENTER: Card Preview + Font/Rows Settings -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Card Preview Canvas -->
                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="8" ClipToBounds="True" DataContext="{Binding SelectedTemplate}">
                        <Viewbox Margin="16" Stretch="Uniform" StretchDirection="Both">
                            <Border BorderBrush="{Binding FrameColorHex}"
                                    BorderThickness="{Binding FrameSize, Converter={StaticResource DoubleToThicknessConverter}, ConverterParameter=2}"
                                    Background="White">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource CardSizeConverter}" ConverterParameter="3.77">
                                        <Binding Source="210.0"/>
                                        <Binding Path="Columns"/>
                                        <Binding Path="MarginX"/>
                                    </MultiBinding>
                                </Border.Width>
                                <Border.Height>
                                    <MultiBinding Converter="{StaticResource CardSizeConverter}" ConverterParameter="3.77">
                                        <Binding Source="297.0"/>
                                        <Binding Path="Rows"/>
                                        <Binding Path="MarginY"/>
                                    </MultiBinding>
                                </Border.Height>
                                <Grid ClipToBounds="True">
                                    <Image Source="{Binding BackgroundImagePath}" Stretch="Fill"/>
                                    <Image Source="{Binding LogoImagePath}" Width="40" Height="40" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <Canvas>
                                        
                                        <Thumb x:Name="ThumbUsername" DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted" Tag="Username" Visibility="{Binding ShowUsername, Converter={StaticResource BoolToVis}}" Canvas.Left="{Binding UsernameX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}" Canvas.Top="{Binding UsernameY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="123456789" Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3, RelativeSource={RelativeSource AncestorType=UserControl}}" Cursor="SizeAll"></TextBlock>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted" Tag="Password" Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}" Canvas.Left="{Binding PasswordX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}" Canvas.Top="{Binding PasswordY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="12345678" Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3, RelativeSource={RelativeSource AncestorType=UserControl}}" Cursor="SizeAll"></TextBlock>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted" Tag="Qr" Visibility="{Binding ShowQr, Converter={StaticResource BoolToVis}}" Canvas.Left="{Binding QrX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}" Canvas.Top="{Binding QrY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}">
                                            <Thumb.Template><ControlTemplate>
                                                <Border Background="#1E293B" CornerRadius="2" Cursor="SizeAll" Width="{Binding DataContext.SelectedTemplate.QrSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding DataContext.SelectedTemplate.QrSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77, RelativeSource={RelativeSource AncestorType=UserControl}}"></Border>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted" Tag="Price" Visibility="{Binding ShowPrice, Converter={StaticResource BoolToVis}}" Canvas.Left="{Binding PriceX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}" Canvas.Top="{Binding PriceY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="1000 YER" Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3, RelativeSource={RelativeSource AncestorType=UserControl}}" Cursor="SizeAll"></TextBlock>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted" Tag="Validity" Visibility="{Binding ShowValidity, Converter={StaticResource BoolToVis}}" Canvas.Left="{Binding ValidityX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}" Canvas.Top="{Binding ValidityY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="30 Days" Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3, RelativeSource={RelativeSource AncestorType=UserControl}}" Cursor="SizeAll"></TextBlock>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted" Tag="Time" Visibility="{Binding ShowTime, Converter={StaticResource BoolToVis}}" Canvas.Left="{Binding TimeX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}" Canvas.Top="{Binding TimeY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="10 GB" Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3, RelativeSource={RelativeSource AncestorType=UserControl}}" Cursor="SizeAll"></TextBlock>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted" Tag="SerialNumber" Visibility="{Binding ShowSerialNumber, Converter={StaticResource BoolToVis}}" Canvas.Left="{Binding SerialNumberX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}" Canvas.Top="{Binding SerialNumberY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="SN-12345" Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3, RelativeSource={RelativeSource AncestorType=UserControl}}" Cursor="SizeAll"></TextBlock>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted" Tag="PrintDate" Visibility="{Binding ShowPrintDate, Converter={StaticResource BoolToVis}}" Canvas.Left="{Binding PrintDateX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}" Canvas.Top="{Binding PrintDateY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}">
                                            <Thumb.Template><ControlTemplate>
                                                <TextBlock Text="2026/05/07" Foreground="{Binding DataContext.SelectedTemplate.FontColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{Binding DataContext.SelectedTemplate.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="{Binding DataContext.SelectedTemplate.FontSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3, RelativeSource={RelativeSource AncestorType=UserControl}}" Cursor="SizeAll"></TextBlock>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                        <Thumb DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted" Tag="Barcode" Visibility="{Binding ShowBarcode, Converter={StaticResource BoolToVis}}" Canvas.Left="{Binding BarcodeX, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}" Canvas.Top="{Binding BarcodeY, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77}">
                                            <Thumb.Template><ControlTemplate>
                                                <Border Background="#333" CornerRadius="1" Cursor="SizeAll" Width="80" Height="{Binding DataContext.SelectedTemplate.BarcodeSize, Converter={StaticResource MathConverter}, ConverterParameter=@VALUE*3.77, RelativeSource={RelativeSource AncestorType=UserControl}}"></Border>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Viewbox>
                    </Border>

                    <!-- Font + Info Bar below preview (2 rows) -->
                    <Border Grid.Row="1" DataContext="{Binding SelectedTemplate}" Margin="0,8,0,0" Padding="8,6" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="6">
                        <StackPanel>
                            <!-- Row A: Font | Size | Bold | Italic | Total -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="الخط" Foreground="{DynamicResource MaterialDesignBody}" FontSize="10" Margin="0,0,0,2"/>
                                    <ComboBox Text="{Binding FontFamily}" FontSize="11" Height="26" Padding="4,2">
                                        <ComboBoxItem Content="Arial"/>
                                        <ComboBoxItem Content="Tahoma"/>
                                        <ComboBoxItem Content="Segoe UI"/>
                                        <ComboBoxItem Content="Times New Roman"/>
                                        <ComboBoxItem Content="Calibri"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="الحجم" Foreground="{DynamicResource MaterialDesignBody}" FontSize="10" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding FontSize}" Style="{StaticResource ModernTextBoxStyle}" FontSize="11" Padding="4,2" Height="26"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="غامق" Foreground="{DynamicResource MaterialDesignBody}" FontSize="10" HorizontalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding IsBold}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="مائل" Foreground="{DynamicResource MaterialDesignBody}" FontSize="10" HorizontalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding IsItalic}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Foreground="{DynamicResource MaterialDesignBody}" FontSize="10" TextAlignment="Center">
                                        <Run Text="إجمالي: "/>
                                        <Run Text="{Binding DataContext.PreviewCards.Count, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        <Run Text=" كرت"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <!-- Row B: Font Color | Frame Color -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="لون النص" Foreground="{DynamicResource MaterialDesignBody}" FontSize="10" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding FontColorHex}" Style="{StaticResource ModernTextBoxStyle}" FontSize="11" Padding="4,2" Height="26"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="لون الإطار" Foreground="{DynamicResource MaterialDesignBody}" FontSize="10" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding FrameColorHex}" Style="{StaticResource ModernTextBoxStyle}" FontSize="11" Padding="4,2" Height="26"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- LEFT: Card Dimensions + Margins + Frame + Columns/Rows -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10" DataContext="{Binding SelectedTemplate}">
                <StackPanel>
                    <TextBlock Text="أبعاد الكرت" Style="{StaticResource SectionTitleStyle}" FontSize="13"/>

                    <!-- Rows = Card Height -->
                    <TextBlock Text="طول الكرت (صفوف)" Foreground="{DynamicResource MaterialDesignBody}" FontSize="11" Margin="0,0,0,2"/>
                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="-" Click="BtnRowDown_Click" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                            <TextBox Grid.Column="1" Text="{Binding Rows}" IsReadOnly="True" TextAlignment="Center" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12"/>
                            <Button Grid.Column="2" Content="+" Click="BtnRowUp_Click" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                        </Grid>
                    </Border>

                    <!-- Columns = Card Width -->
                    <TextBlock Text="عرض الكرت (أعمدة)" Foreground="{DynamicResource MaterialDesignBody}" FontSize="11" Margin="0,0,0,2"/>
                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="-" Click="BtnColDown_Click" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                            <TextBox Grid.Column="1" Text="{Binding Columns}" IsReadOnly="True" TextAlignment="Center" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12"/>
                            <Button Grid.Column="2" Content="+" Click="BtnColUp_Click" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                        </Grid>
                    </Border>

                    <Separator Margin="0,0,0,10"/>
                    <TextBlock Text="هامش الكرت" Style="{StaticResource SectionTitleStyle}" FontSize="13"/>

                    <TextBlock Text="أفقي :" Foreground="{DynamicResource MaterialDesignBody}" FontSize="11" Margin="0,0,0,2"/>
                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="-" Click="BtnMarginXDown_Click" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                            <TextBox Grid.Column="1" Text="{Binding MarginX}" IsReadOnly="True" TextAlignment="Center" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12"/>
                            <Button Grid.Column="2" Content="+" Click="BtnMarginXUp_Click" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="رأسي :" Foreground="{DynamicResource MaterialDesignBody}" FontSize="11" Margin="0,0,0,2"/>
                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="-" Click="BtnMarginYDown_Click" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                            <TextBox Grid.Column="1" Text="{Binding MarginY}" IsReadOnly="True" TextAlignment="Center" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12"/>
                            <Button Grid.Column="2" Content="+" Click="BtnMarginYUp_Click" Background="{DynamicResource MaterialDesignPaper}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" BorderThickness="0" Cursor="Hand" Padding="8,4"/>
                        </Grid>
                    </Border>

                    <Separator Margin="0,0,0,10"/>
                    <TextBlock Text="إطار الكرت" Style="{StaticResource SectionTitleStyle}" FontSize="13"/>

                    <TextBlock Text="حجم الإطار :" Foreground="{DynamicResource MaterialDesignBody}" FontSize="11" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding FrameSize}" Style="{StaticResource ModernTextBoxStyle}" FontSize="11" Padding="4" Margin="0,0,0,8"/>

                    <TextBlock Text="لون الإطار :" Foreground="{DynamicResource MaterialDesignBody}" FontSize="11" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding FrameColorHex}" Style="{StaticResource ModernTextBoxStyle}" FontSize="11" Padding="4"/>
                </StackPanel>
            </Border>

        </Grid>


        <!-- Busy Overlay -->
        <Grid Grid.RowSpan="3" Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardStyle}" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="300">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimaryHueMidBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
