<UserControl x:Class="MikroTikVoucherPrinter.UI.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="800">

            <!-- العنوان -->
            <TextBlock Text="⚙️ الإعدادات العامة"
                       Style="{DynamicResource PageTitleStyle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="تخصيص مظهر البرنامج وإعدادات الطباعة العامة"
                       Style="{DynamicResource SubTitleStyle}"
                       Margin="0,0,0,28"/>

            <!-- ═══ إعدادات المظهر ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="&#xE790;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="المظهر والثيم"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryHueMidBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="اختر المظهر المناسب للبرنامج"
                               Style="{DynamicResource LabelStyle}"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="🌙 الوضع الداكن"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding SwitchToDarkCommand}"
                                Margin="0,0,12,0"/>
                        <Button Content="☀️ الوضع الفاتح"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding SwitchToLightCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ إعدادات الاتصال ═══ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="&#xE839;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="الاتصال بالمايكروتك"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryHueMidBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- عرض بيانات الاتصال الحالية (للقراءة فقط) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="عنوان IP الحالي" Style="{DynamicResource LabelStyle}"/>
                            <TextBlock Text="{Binding CurrentHost}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryHueMidBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="اسم المستخدم" Style="{DynamicResource LabelStyle}"/>
                            <TextBlock Text="{Binding CurrentUsername}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryHueMidBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- حالة الاتصال -->
                    <Border Background="#1422C55E" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="متصل بالمايكروتك" Foreground="#22C55E" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- زر تغيير الاتصال -->
                    <Button Content="🔌 تغيير بيانات الاتصال"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Command="{Binding ChangeConnectionCommand}"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- رسالة الحالة -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="14"
                       Foreground="{DynamicResource SuccessBrush}"
                       Margin="0,8,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisConverter}}"/>

            <!-- رسالة الخطأ -->
            <Border Background="#1AF85149" CornerRadius="8" Padding="16" Margin="0,8,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="14"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
