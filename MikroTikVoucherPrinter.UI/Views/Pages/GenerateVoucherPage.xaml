<UserControl x:Class="MikroTikVoucherPrinter.UI.Views.Pages.GenerateVoucherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:enums="clr-namespace:MikroTikVoucherPrinter.Domain.Enums;assembly=MikroTikVoucherPrinter.Domain"
             FlowDirection="RightToLeft"
             FontFamily="Tajawal, Segoe UI, sans-serif"
             Background="Transparent">

    <UserControl.Resources>
        <!-- ══ PREMIUM ENTERPRISE SLATE PALETTE ══ -->
        <!-- Backgrounds -->
        <SolidColorBrush x:Key="Srf.AppBackground" Color="#F8FAFC"/> <!-- Slate 50 -->
        <SolidColorBrush x:Key="Srf.Card" Color="#FFFFFF"/> 
        <SolidColorBrush x:Key="Srf.DarkCard" Color="#0F172A"/> <!-- Slate 900 (Deep, rich enterprise dark) -->
        <SolidColorBrush x:Key="Srf.DarkElevated" Color="#1E293B"/> <!-- Slate 800 -->
        <SolidColorBrush x:Key="Srf.Subtle" Color="#F1F5F9"/> <!-- Slate 100 -->

        <!-- Borders -->
        <SolidColorBrush x:Key="Brd.Light" Color="#E2E8F0"/> <!-- Slate 200 -->
        <SolidColorBrush x:Key="Brd.Dark" Color="#334155"/> <!-- Slate 700 -->

        <!-- Text -->
        <SolidColorBrush x:Key="Tx.Primary" Color="#0F172A"/> <!-- Slate 900 -->
        <SolidColorBrush x:Key="Tx.Secondary" Color="#475569"/> <!-- Slate 600 -->
        <SolidColorBrush x:Key="Tx.Muted" Color="#94A3B8"/> <!-- Slate 400 -->
        <SolidColorBrush x:Key="Tx.OnDark" Color="#F8FAFC"/> <!-- Slate 50 -->
        <SolidColorBrush x:Key="Tx.OnDarkMuted" Color="#94A3B8"/> <!-- Slate 400 -->

        <!-- Accents -->
        <SolidColorBrush x:Key="Ac.Brand" Color="#2563EB"/> <!-- Blue 600 -->
        <SolidColorBrush x:Key="Ac.Success" Color="#10B981"/> <!-- Emerald 500 -->
        <SolidColorBrush x:Key="Ac.Warning" Color="#F59E0B"/> <!-- Amber 500 -->

        <!-- ══ TYPOGRAPHY SYSTEM ══ -->
        <Style x:Key="T.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Tx.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.SectionTitleOnDark" TargetType="TextBlock" BasedOn="{StaticResource T.SectionTitle}">
            <Setter Property="Foreground" Value="{StaticResource Tx.OnDark}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="T.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Tx.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="T.LabelOnDark" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Foreground" Value="{StaticResource Tx.OnDarkMuted}"/>
        </Style>

        <!-- ══ SURFACES & CONTAINERS ══ -->
        <!-- Premium Elevated Card -->
        <Style x:Key="PremiumCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Srf.Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brd.Light}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <!-- Controlled subtle shadow using MaterialDesign -->
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <!-- Micro-interaction: Subtle lift on hover -->
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp3"/>
                    <Setter Property="BorderBrush" Value="#CBD5E1"/> <!-- Slate 300 -->
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkPremiumCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Srf.DarkCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brd.Dark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp3"/>
        </Style>

        <!-- ══ CONTROLS (Material Outlined overrides for Premium Feel) ══ -->
        <Style x:Key="PremiumOutlinedCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Tx.Primary}"/>
            <Setter Property="Padding" Value="12,12,32,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="materialDesign:HintAssist.Foreground" Value="{StaticResource Tx.Muted}"/>
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource Ac.Brand}"/>
        </Style>

        <Style x:Key="PremiumOutlinedTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Tx.Primary}"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="materialDesign:HintAssist.Foreground" Value="{StaticResource Tx.Muted}"/>
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource Ac.Brand}"/>
        </Style>
    </UserControl.Resources>

    <!-- ══ MAIN LAYOUT ══ -->
    <Grid Background="{StaticResource Srf.AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Warning Strip (Material Design native) -->
        <materialDesign:Card Grid.Row="0" Background="{StaticResource Ac.Warning}" Foreground="#FFFFFF" Margin="24,16,24,0" Padding="16,8" 
                             Visibility="{Binding IsOfflineMode, Converter={StaticResource BoolToVisConverter}}"
                             UniformCornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="WifiOff" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="وضع عدم الاتصال: المزامنة معلقة حتى استعادة الاتصال بالشبكة." FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Main Workspace -->
        <Grid Grid.Row="1" Margin="24,16,24,32" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="600"/> <!-- Config Builder (Expanded for Outlined Inputs) -->
                <ColumnDefinition Width="24"/>  <!-- Spacing -->
                <ColumnDefinition Width="320"/> <!-- Telemetry & Pipeline -->
            </Grid.ColumnDefinitions>

            <!-- ── RIGHT AREA: CONFIGURATION WORKSPACE (Col 0 in RTL) ── -->
            <StackPanel Grid.Column="0">
                
                <!-- ▄▄ PANEL 1: CORE CONFIGURATION ▄▄ -->
                <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="DatabaseOutline" Width="22" Height="22" Foreground="{StaticResource Ac.Brand}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="معطيات الإنتاج الأساسية" Style="{StaticResource T.SectionTitle}" Margin="12,0,0,0"/>
                            <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconForegroundButton}" Command="{Binding RefreshProfilesCommand}" ToolTip="مزامنة القوائم" Height="32" Width="32">
                                <materialDesign:PackIcon Kind="Sync" Width="18" Height="18" Foreground="{StaticResource Tx.Secondary}"/>
                            </Button>
                        </Grid>

                        <!-- Row 1: Profile & Quantity -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" 
                                      materialDesign:HintAssist.Hint="الباقة (Profile)" Style="{StaticResource PremiumOutlinedCombo}"/>
                            
                            <TextBox Grid.Column="2" Text="{Binding Count}" materialDesign:HintAssist.Hint="الكمية" 
                                     Style="{StaticResource PremiumOutlinedTextBox}" FontWeight="Bold"/>
                        </Grid>

                        <!-- Row 2: Agent -->
                        <ComboBox Grid.Row="4" ItemsSource="{Binding Agents}" SelectedItem="{Binding SelectedAgent}" DisplayMemberPath="Name" 
                                  materialDesign:HintAssist.Hint="نقطة البيع (الوكيل)" Style="{StaticResource PremiumOutlinedCombo}"/>
                    </Grid>
                </Border>

                <!-- ▄▄ PANEL 2: IDENTITY BUILDER ▄▄ -->
                <Border Style="{StaticResource PremiumCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> 
                            <RowDefinition Height="24"/>   
                            <RowDefinition Height="Auto"/> 
                            <RowDefinition Height="24"/>   
                            <RowDefinition Height="Auto"/> 
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="KeyOutline" Width="22" Height="22" Foreground="{StaticResource Ac.Warning}" VerticalAlignment="Center"/>
                            <TextBlock Text="محددات الحسابات والهوية" Style="{StaticResource T.SectionTitle}" Margin="12,0,0,0"/>
                        </StackPanel>

                        <!-- Vector Selection -->
                        <ComboBox Grid.Row="2" SelectedValue="{Binding SelectedCredentialMode}" SelectedValuePath="Tag" 
                                  materialDesign:HintAssist.Hint="نمط التوليد (Auth Vector)" Style="{StaticResource PremiumOutlinedCombo}" HorizontalAlignment="Left" Width="300">
                            <ComboBoxItem Content="مستخدم فقط (بدون كلمة سر)" Tag="{x:Static enums:CredentialMode.UsernameOnly}"/>
                            <ComboBoxItem Content="المستخدم يطابق كلمة السر" Tag="{x:Static enums:CredentialMode.UsernameEqualsPassword}"/>
                            <ComboBoxItem Content="مستخدم وكلمة سر مستقلة" Tag="{x:Static enums:CredentialMode.UsernameAndPassword}"/>
                        </ComboBox>

                        <!-- Rules Builder Matrix -->
                        <Border Grid.Row="4" Background="{StaticResource Srf.Subtle}" CornerRadius="6" Padding="16" BorderBrush="{StaticResource Brd.Light}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Username Rule -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>  <!-- Lbl -->
                                        <ColumnDefinition Width="*"/>   <!-- Charset -->
                                        <ColumnDefinition Width="12"/>  <!-- Spc -->
                                        <ColumnDefinition Width="140"/> <!-- Prefix -->
                                        <ColumnDefinition Width="12"/>  <!-- Spc -->
                                        <ColumnDefinition Width="80"/>  <!-- Len -->
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="المستخدم" Style="{StaticResource T.Label}" Foreground="{StaticResource Tx.Primary}"/>
                                    
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedCharacterMode}" SelectedValuePath="Tag" materialDesign:HintAssist.Hint="تكوين الأحرف" Style="{StaticResource PremiumOutlinedCombo}">
                                        <ComboBoxItem Content="أرقام فقط" Tag="{x:Static enums:CharacterMode.DigitsOnly}"/>
                                        <ComboBoxItem Content="حروف إنجليزية" Tag="{x:Static enums:CharacterMode.LettersOnly}"/>
                                        <ComboBoxItem Content="مختلط" Tag="{x:Static enums:CharacterMode.Mixed}"/>
                                    </ComboBox>
                                    
                                    <TextBox Grid.Column="3" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="بادئة (اختياري)" FlowDirection="LeftToRight" Style="{StaticResource PremiumOutlinedTextBox}"/>
                                                
                                    <TextBox Grid.Column="5" Text="{Binding UsernameLength}" materialDesign:HintAssist.Hint="الطول" Style="{StaticResource PremiumOutlinedTextBox}" TextAlignment="Center"/>
                                </Grid>

                                <!-- Password Rule -->
                                <Grid Grid.Row="2" Visibility="{Binding ShowPasswordLength, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="كلمة السر" Style="{StaticResource T.Label}" Foreground="{StaticResource Tx.Primary}"/>
                                    
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding PasswordCharacterMode}" SelectedValuePath="Tag" materialDesign:HintAssist.Hint="تكوين الأحرف" Style="{StaticResource PremiumOutlinedCombo}">
                                        <ComboBoxItem Content="أرقام فقط" Tag="{x:Static enums:CharacterMode.DigitsOnly}"/>
                                        <ComboBoxItem Content="حروف إنجليزية" Tag="{x:Static enums:CharacterMode.LettersOnly}"/>
                                        <ComboBoxItem Content="مختلط" Tag="{x:Static enums:CharacterMode.Mixed}"/>
                                    </ComboBox>
                                    
                                    <TextBox Grid.Column="3" Text="{Binding PasswordPrefix, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="بادئة (اختياري)" FlowDirection="LeftToRight" Style="{StaticResource PremiumOutlinedTextBox}"/>
                                                
                                    <TextBox Grid.Column="5" Text="{Binding PasswordLength}" materialDesign:HintAssist.Hint="الطول" Style="{StaticResource PremiumOutlinedTextBox}" TextAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ── LEFT AREA: TELEMETRY, PIPELINE & ACTION ── -->
            <StackPanel Grid.Column="2">

                <!-- ▄▄ PANEL 3: ENTERPRISE TELEMETRY ▄▄ -->
                <Border Style="{StaticResource DarkPremiumCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Finance" Width="20" Height="20" Foreground="{StaticResource Ac.Success}" VerticalAlignment="Center"/>
                            <TextBlock Text="الإيراد الكلي المتوقع" Style="{StaticResource T.SectionTitleOnDark}" Foreground="{StaticResource Tx.Muted}" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- Main Value -->
                        <TextBlock Grid.Row="2" Foreground="{StaticResource Ac.Success}" FontSize="24" FontWeight="Bold" Margin="30,0,0,0">
                            <Run Text="{Binding TotalPrice, Mode=OneWay, StringFormat={}{0:N0}}"/>
                            <Run Text="ريال" FontSize="12" Foreground="{StaticResource Tx.OnDarkMuted}" FontWeight="Normal"/>
                        </TextBlock>

                        <!-- Micro Sub-metrics Grid -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource Srf.DarkElevated}" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="حجم الدفعة" Style="{StaticResource T.LabelOnDark}" FontSize="11"/>
                                    <TextBlock Text="{Binding Count, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Tx.OnDark}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource Srf.DarkElevated}" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="سعر الكرت" Style="{StaticResource T.LabelOnDark}" FontSize="11"/>
                                    <TextBlock Text="{Binding Price, Mode=OneWay, StringFormat={}{0:N0}}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Tx.OnDark}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ▄▄ PANEL 4: OPERATIONAL PIPELINE WIDGET ▄▄ -->
                <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,16" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PrinterOutline" Width="20" Height="20" Foreground="{StaticResource Tx.Secondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="توجيه الطباعة (Pipeline)" Style="{StaticResource T.SectionTitle}" Margin="10,0,0,0"/>
                        </StackPanel>

                        <ComboBox Grid.Row="2" ItemsSource="{Binding PrintTemplateOptions}" SelectedItem="{Binding SelectedPrintTemplateOption}" 
                                  materialDesign:HintAssist.Hint="قالب الطباعة" Style="{StaticResource PremiumOutlinedCombo}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" FontSize="12"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Premium Toggles Group -->
                        <Border Grid.Row="4" Background="{StaticResource Srf.Subtle}" CornerRadius="6" Padding="12" BorderBrush="{StaticResource Brd.Light}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="CloudUploadOutline" Width="18" Height="18" Foreground="{StaticResource Tx.Muted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="مزامنة فورية للراوتر" Style="{StaticResource T.Label}" Margin="8,0,0,0"/>
                                    <!-- Material Design Native Toggle -->
                                    <ToggleButton Grid.Column="2" IsChecked="{Binding AutoSyncAfterGenerate}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="تمكين المزامنة التلقائية"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="OpenInNew" Width="18" Height="18" Foreground="{StaticResource Tx.Muted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="فتح السبلوبر تلقائياً" Style="{StaticResource T.Label}" Margin="8,0,0,0"/>
                                    <ToggleButton Grid.Column="2" IsChecked="{Binding PrintAfterGenerate}" Style="{StaticResource MaterialDesignSwitchToggleButton}" ToolTip="تمكين العرض التلقائي"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ▄▄ PANEL 5: DYNAMIC ACTION FOCUS ▄▄ -->
                <Border Background="{StaticResource Srf.Card}" BorderBrush="{StaticResource Ac.Brand}" BorderThickness="1,1,1,4" CornerRadius="8" Padding="16" materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Dynamic Status -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="{StaticResource Ac.Success}" VerticalAlignment="Center" Visibility="{Binding IsNotBusy, Converter={StaticResource BoolToVisConverter}}"/>
                            <TextBlock Text="{Binding StatusMessage, FallbackValue='النظام مستعد للمعالجة'}" Style="{StaticResource T.Label}" Margin="6,0,0,0" Foreground="{StaticResource Ac.Success}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Primary CTA -->
                        <Button Grid.Row="2" Command="{Binding GenerateBulkCommand}" Style="{StaticResource MaterialDesignRaisedButton}" 
                                Background="{StaticResource Ac.Brand}" BorderThickness="0" Height="48" materialDesign:ButtonAssist.CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="22" Height="22" Foreground="White" Margin="0,0,0,8"/>
                                <TextBlock Text="طباعة الدفعة" FontSize="14" FontWeight="Bold" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Secondary -->
                        <Button Grid.Row="4" Command="{Binding GenerateSingleCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Foreground="{StaticResource Tx.Secondary}" BorderBrush="{StaticResource Brd.Light}" Height="36" materialDesign:ButtonAssist.CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TicketOutline" Width="16" Height="16" Margin="0,0,0,6"/>
                                <TextBlock Text="طباعة كارت تجريبي" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══ GENERATION OVERLAY ══ -->
        <Grid Panel.ZIndex="9999" Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#E60F172A"/> <!-- Deep Slate 900 Glass-like tint -->
            <Border Background="{StaticResource Srf.Card}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" MinWidth="480" materialDesign:ElevationAssist.Elevation="Dp8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <ProgressBar Grid.Row="0" Style="{StaticResource MaterialDesignCircularProgressBar}" Value="{Binding ProgressPercent, Mode=OneWay}" Width="64" Height="64" HorizontalAlignment="Center" Foreground="{StaticResource Ac.Brand}"/>
                    
                    <TextBlock Grid.Row="2" Text="{Binding CurrentPhase}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Tx.Primary}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Style="{StaticResource T.Label}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    
                    <ProgressBar Grid.Row="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="6" Foreground="{StaticResource Ac.Brand}" Background="{StaticResource Srf.Subtle}" materialDesign:TransitionAssist.DisableTransitions="True"/>
                    
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Foreground="{StaticResource Tx.Secondary}" FontSize="13">
                            <Run Text="{Binding ProgressCurrent, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Tx.Primary}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding ProgressTotal, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Foreground="{StaticResource Tx.Secondary}" FontSize="13">
                            <Run Text="المنقضي: "/>
                            <Run Text="{Binding ElapsedTimeText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Tx.Primary}"/>
                        </TextBlock>
                    </Grid>

                    <!-- Cancel floating at top right -->
                    <Button Grid.Row="0" Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-20,-20,0" Background="{StaticResource Srf.Subtle}" BorderThickness="0" ToolTip="إلغاء">
                        <materialDesign:PackIcon Kind="Close" Foreground="{StaticResource Tx.Secondary}"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
