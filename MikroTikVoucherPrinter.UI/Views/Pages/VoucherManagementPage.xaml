<UserControl x:Class="MikroTikVoucherPrinter.UI.Views.Pages.VoucherManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MikroTikVoucherPrinter.UI.Converters"
             Background="Transparent"
             FlowDirection="RightToLeft"
             FontFamily="Cairo, Segoe UI">

    <UserControl.Resources>
        <!-- Modern ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#D1D5DB" CornerRadius="4" Margin="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="ModernPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#6D28D9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" Opacity="0.3" BlurRadius="8" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="ModernSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F9FAFB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="ModernDangerButton" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Button -->
        <Style x:Key="ModernIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Toggle Button -->
        <Style x:Key="ModernComboToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1">
                                    <TextBlock x:Name="arrow" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform><RotateTransform x:Name="arrowRotate" Angle="0" CenterX="5" CenterY="5"/></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style for Modern Filters -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F5F3FF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#EDE9FE"/>
                                            <Setter Property="Foreground" Value="#7C3AED"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                                <Grid>
                                    <ToggleButton Style="{StaticResource ModernComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="dropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0" Padding="4">
                                    <Border.Effect><DropShadowEffect Color="#0F172A" Opacity="0.08" BlurRadius="16" ShadowDepth="4" Direction="270"/></Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#C4B5FD"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8B5CF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fast Filter CheckBox as Chips -->
        <Style x:Key="FilterChipStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16" BorderBrush="#E5E7EB" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3E8FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#C4B5FD"/>
                                <Setter Property="Foreground" Value="#7C3AED"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context Menu -->
        <ContextMenu x:Key="VoucherRowContextMenu" x:Shared="False" FontFamily="Cairo, Segoe UI" FontSize="13">
            <MenuItem Header="جلب الجلسات النشطة (Hotspot)"
                      Command="{Binding DataContext.ShowSessionsCommand, ElementName=MainGrid}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="نسخ اسم المستخدم"
                      Command="{Binding DataContext.CopyUsernameCommand, ElementName=MainGrid}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="نسخ كلمة المرور"
                      Command="{Binding DataContext.CopyPasswordCommand, ElementName=MainGrid}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- KPI Cards -->
            <RowDefinition Height="*"/>     <!-- Main Content Area -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════ -->
        <!--  KPI Cards Section                             -->
        <!-- ══════════════════════════════════════════════ -->
        <!-- Increased bottom margin to let it breathe -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,32">
            
            <!-- Card 1 -->
            <Border Background="#FFFFFF" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,16,0">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.02" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إجمالي الكروت" FontSize="13" Foreground="#6B7280" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="32" FontWeight="Black" Foreground="#111827"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="12" Background="#F3E8FF" VerticalAlignment="Top">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2 -->
            <Border Background="#FFFFFF" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,16,0">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.02" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="متزامن مع المايكروتك" FontSize="13" Foreground="#6B7280" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SyncedCount}" FontSize="32" FontWeight="Black" Foreground="#111827"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="12" Background="#DCFCE7" VerticalAlignment="Top">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3 -->
            <Border Background="#FFFFFF" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,16,0">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.02" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="قيد الانتظار" FontSize="13" Foreground="#6B7280" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding PendingCount}" FontSize="32" FontWeight="Black" Foreground="#111827"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="12" Background="#FEF3C7" VerticalAlignment="Top">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4 -->
            <Border Background="#FFFFFF" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.02" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="فشل التزامن" FontSize="13" Foreground="#6B7280" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding FailedCount}" FontSize="32" FontWeight="Black" Foreground="#111827"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="12" Background="#FEE2E2" VerticalAlignment="Top">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Main Content Area (Toolbar + Table)          -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.02" BlurRadius="16" ShadowDepth="4" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Toolbar Top (Search & Actions) -->
                    <RowDefinition Height="Auto"/> <!-- Toolbar Bottom (Fast Filters) -->
                    <RowDefinition Height="Auto"/> <!-- Divider -->
                    <RowDefinition Height="*"/>    <!-- DataGrid -->
                    <RowDefinition Height="Auto"/> <!-- Divider -->
                    <RowDefinition Height="Auto"/> <!-- Modern Footer Pagination -->
                </Grid.RowDefinitions>

                <!-- 1. Toolbar Top -->
                <Grid Grid.Row="0" Margin="24,24,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/> <!-- Left/Right Side (Search & Filters) -->
                        <ColumnDefinition Width="Auto"/> <!-- Actions -->
                    </Grid.ColumnDefinitions>

                    <!-- Search & Dropdowns -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Search Input -->
                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Background="#F9FAFB" Width="280" Height="38" Margin="0,0,16,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE11A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#9CA3AF" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="البحث عن مستخدم أو دفعة..." Foreground="#9CA3AF" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="8,0" Foreground="#111827" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>

                        <Border Width="1" Height="20" Background="#E5E7EB" Margin="0,0,16,0"/>

                        <!-- Dropdowns -->
                        <ComboBox Style="{StaticResource ModernComboBox}" SelectedValue="{Binding FilterStatus}" SelectedValuePath="Tag" Width="130" Margin="0,0,8,0">
                            <ComboBoxItem Content="كل الحالات" Tag="All" IsSelected="True"/>
                            <ComboBoxItem Content="🔓 مُستخدم" Tag="Used"/>
                            <ComboBoxItem Content="⛔ معطل" Tag="Disabled"/>
                            <ComboBoxItem Content="🗑️ محذوف" Tag="Deleted"/>
                        </ComboBox>

                        <ComboBox Style="{StaticResource ModernComboBox}" SelectedValue="{Binding FilterSync}" SelectedValuePath="Tag" Width="130" Margin="0,0,8,0">
                            <ComboBoxItem Content="كل المزامنة" Tag="All" IsSelected="True"/>
                            <ComboBoxItem Content="✅ متزامن" Tag="Synced"/>
                            <ComboBoxItem Content="⏳ معلّق" Tag="Pending"/>
                            <ComboBoxItem Content="❌ فاشل" Tag="Failed"/>
                        </ComboBox>

                        <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding ProfileFilters}" SelectedItem="{Binding FilterProfile}" Width="140" Margin="0,0,8,0"/>

                        <ComboBox Style="{StaticResource ModernComboBox}" SelectedValue="{Binding FilterInsight}" SelectedValuePath="Tag" Width="140" Margin="0,0,16,0" ToolTip="المصدر">
                            <ComboBoxItem Content="كل المصادر" Tag="All"/>
                            <ComboBoxItem Content="محلي فقط" Tag="LocalOnly"/>
                            <ComboBoxItem Content="من الراوتر" Tag="RouterOnly"/>
                            <ComboBoxItem Content="مدمج" Tag="RouterMerged"/>
                        </ComboBox>

                        <!-- Clear Filters -->
                        <Button Style="{StaticResource ModernIconButton}" Command="{Binding ClearFilterCommand}" ToolTip="إعادة ضبط الفلاتر">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                    </StackPanel>

                    <!-- Actions Section -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernSecondaryButton}" Command="{Binding PrintSelectedCommand}" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="طباعة المحدد" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Style="{StaticResource ModernDangerButton}" Command="{Binding DeleteSelectedCommand}" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="حذف" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ModernPrimaryButton}" Command="{Binding LoadCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تحديث البيانات" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Fast Filters (Chips) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,0,24,20">
                    <TextBlock Text="تصفية سريعة:" FontWeight="Bold" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <CheckBox Style="{StaticResource FilterChipStyle}" Content="بدون بروفايل" IsChecked="{Binding FilterShowOnlyNoProfile, Mode=TwoWay}" Margin="0,0,12,0"/>
                    <CheckBox Style="{StaticResource FilterChipStyle}" Content="منتهي الصلاحية" IsChecked="{Binding FilterShowOnlyExpiredValidity, Mode=TwoWay}" Margin="0,0,12,0"/>
                    <CheckBox Style="{StaticResource FilterChipStyle}" Content="رصيد / حصة منتهية" IsChecked="{Binding FilterShowOnlyQuotaDepleted, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Row="2" Height="1" Background="#F3F4F6"/>

                <!-- 3. Enterprise DataGrid -->
                <!-- Set HeadersVisibility="Column" and remove row headers cleanly -->
                <DataGrid Grid.Row="3" x:Name="MainGrid"
                          ItemsSource="{Binding VouchersView}"
                          SelectedItem="{Binding SelectedVoucher}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="#FFFFFF"
                          AlternatingRowBackground="#FAFAFA"
                          RowHeight="64"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          SelectionUnit="FullRow"
                          SelectionMode="Extended"
                          SelectionChanged="MainGrid_SelectionChanged"
                          Margin="0">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F6FB"/>
                            <Setter Property="Foreground" Value="#6B7280"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="24,16"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <!-- Remove left/right separators -->
                            <Setter Property="SeparatorVisibility" Value="Hidden"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ContextMenu" Value="{StaticResource VoucherRowContextMenu}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#111827"/>
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <!-- Soft row transition -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridRow">
                                        <Border x:Name="DGR_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <SelectiveScrollingGrid>
                                                <SelectiveScrollingGrid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </SelectiveScrollingGrid.ColumnDefinitions>
                                                <SelectiveScrollingGrid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </SelectiveScrollingGrid.RowDefinitions>
                                                <!-- Row Header is hidden by DataGrid property, but just in case we remove it from layout -->
                                                <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Visibility="{TemplateBinding DetailsVisibility}"/>
                                                <DataGridRowHeader Grid.RowSpan="2" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical" Visibility="Collapsed"/>
                                            </SelectiveScrollingGrid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#F3E8FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="24,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <!-- Default to Left alignment for modern tables -->
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <!-- Username -->
                        <DataGridTemplateColumn Header="المستخدم" Width="200" SortMemberPath="Username">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#F3F4F6" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Username, FallbackValue='U'}" FontFamily="Cairo, Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="24" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <TextBlock Text="{Binding Username, FallbackValue='-'}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#111827"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                            <Setter Property="Foreground" Value="#7C3AED"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Password -->
                        <DataGridTemplateColumn Header="كلمة المرور" Width="160" SortMemberPath="Password">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Password, FallbackValue='-'}" FontSize="14" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Profile -->
                        <DataGridTemplateColumn Header="الباقة" Width="160" SortMemberPath="Profile">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Profile, FallbackValue='-'}" Foreground="#374151" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Price -->
                        <DataGridTemplateColumn Header="السعر" Width="120" SortMemberPath="Price">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} ر'}" FontWeight="Black" FontSize="14" Foreground="#111827" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Modern Pills -->
                        <DataGridTemplateColumn Header="الحالة" Width="140" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F3F4F6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="غير مستخدم">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="مُستخدم">
                                                        <Setter Property="Background" Value="#F3E8FF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="منتهي">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="معطل">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="محذوف">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="غير مستخدم">
                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="مُستخدم">
                                                            <Setter Property="Foreground" Value="#7C3AED"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="منتهي">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="معطل">
                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="محذوف">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Data origin -->
                        <DataGridTemplateColumn Header="المصدر" Width="130" SortMemberPath="DataOriginText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataOriginText}" FontSize="13" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Quota -->
                        <DataGridTemplateColumn Header="الحصة" Width="140" SortMemberPath="QuotaSummaryText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding QuotaSummaryText}" FontSize="13" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Sync Status -->
                        <DataGridTemplateColumn Header="المزامنة" Width="130" SortMemberPath="SyncStatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#F59E0B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SyncStatusText}" Value="متزامن">
                                                            <Setter Property="Fill" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SyncStatusText}" Value="فشل التزامن">
                                                            <Setter Property="Fill" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding SyncStatusText}" FontSize="13" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Date -->
                        <DataGridTemplateColumn Header="التاريخ" Width="120" SortMemberPath="CreatedAt">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="13" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Action Menu -->
                        <DataGridTemplateColumn Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ModernIconButton}" ToolTip="خيارات"
                                            ContextMenu="{StaticResource VoucherRowContextMenu}"
                                            Click="VoucherOptionsButton_Click" HorizontalAlignment="Center">
                                        <TextBlock Text="⋮" FontSize="20" FontWeight="Bold"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Modern Loading Skeleton / Overlay -->
                <Grid Grid.Row="3" Background="#CCFFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                    <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="48,40">
                        <Border.Effect><DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="24" ShadowDepth="4"/></Border.Effect>
                        <StackPanel>
                            <ProgressBar IsIndeterminate="True" Width="160" Height="4" Foreground="#8B5CF6" Background="#F3F4F6" BorderThickness="0" Margin="0,0,0,24"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="15" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Divider -->
                <Border Grid.Row="4" Height="1" Background="#E5E7EB"/>

                <!-- 4. Modern Footer Pagination -->
                <Border Grid.Row="5" Padding="24,16" Background="#F9FAFB" CornerRadius="0,0,16,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Foreground="#6B7280" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="عرض "/>
                                <Run Text="{Binding FilteredCount}" Foreground="#111827" FontWeight="Bold"/>
                                <Run Text=" من "/>
                                <Run Text="{Binding TotalCount}" Foreground="#111827" FontWeight="Bold"/>
                            </TextBlock>
                            
                            <Border Width="1" Height="16" Background="#D1D5DB" Margin="16,0"/>

                            <TextBlock Foreground="#7C3AED" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                <Run Text="المحدد: "/>
                                <Run Text="{Binding SelectedCount}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Message -->
                            <TextBlock Text="{Binding LastOperationMessage}" Foreground="#10B981" FontSize="13" FontWeight="Bold" Margin="0,0,24,0" VerticalAlignment="Center"
                                       Visibility="{Binding LastOperationMessage, Converter={StaticResource StringToBoolConverter}}"/>
                            
                            <!-- Modern Pill Pagination Controls -->
                            <Button Style="{StaticResource ModernSecondaryButton}" Padding="16,0" Margin="0,0,8,0" IsEnabled="False" Height="36">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="السابق" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <Border Background="#8B5CF6" CornerRadius="8" Width="36" Height="36" Margin="0,0,8,0">
                                <TextBlock Text="1" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <Button Style="{StaticResource ModernSecondaryButton}" Padding="16,0" IsEnabled="False" Height="36">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="التالي" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
