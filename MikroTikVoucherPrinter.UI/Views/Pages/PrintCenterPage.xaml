<UserControl x:Class="MikroTikVoucherPrinter.UI.Views.Pages.PrintCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dto="clr-namespace:MikroTikVoucherPrinter.Application.DTOs;assembly=MikroTikVoucherPrinter.Application"
             Background="Transparent"
             FlowDirection="RightToLeft"
             FontFamily="Cairo, Segoe UI">

    <UserControl.Resources>
        <!-- Primary Button -->
        <Style x:Key="ModernPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#6D28D9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#8B5CF6" Opacity="0.3" BlurRadius="8" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="ModernSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text Box -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#8B5CF6"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════ -->
            <!--  القسم الأول: إعدادات القالب                  -->
            <!-- ══════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="16" Margin="0,0,0,24" Padding="32">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.02" BlurRadius="16" ShadowDepth="4" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="إعدادات القالب والورقة" FontSize="18" FontWeight="Black" Foreground="#111827" Margin="0,0,0,24"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- القالب من قاعدة البيانات -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="القالب (من قاعدة البيانات)" FontSize="13" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding AvailablePrintTemplates}" SelectedItem="{Binding SelectedPrintTemplate}" Style="{StaticResource ModernComboBox}" Height="56" Padding="8,4">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dto:TemplateConfigDto}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True" Width="50" Height="36" Background="#F3F4F6">
                                                <!-- Fallback if FilePathToImageConverter isn't available globally, use simple text or binding -->
                                                <TextBlock Text="📷" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9CA3AF"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#111827"/>
                                                    <Border Background="#F3E8FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding KindDisplay}" FontSize="10" FontWeight="Bold" Foreground="#8B5CF6"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,2,0,0">
                                                    <Run Text="{Binding GridSummary, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="أعمدة "/><Run Text="{Binding Columns, Mode=OneWay}"/>
                                                    <Run Text=" × صفوف "/><Run Text="{Binding Rows, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding TemplateLivePreviewLine}" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- كروت بالصف -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="كروت بالصف الواحد (A4)" FontSize="13" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,8"/>
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Settings.CardsPerRow}" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="2 كروت" Tag="2"/>
                                <ComboBoxItem Content="3 كروت" Tag="3"/>
                                <ComboBoxItem Content="4 كروت (افتراضي)" Tag="4"/>
                                <ComboBoxItem Content="5 كروت" Tag="5"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- حجم الخط -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="حجم الخط" FontSize="13" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="8" Maximum="20" Value="{Binding Settings.FontSize}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Height="40">
                                    <TextBlock Text="{Binding Settings.FontSize, StringFormat='{}{0} pt'}" FontSize="13" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════ -->
            <!--  القسم الثاني: بيانات الشركة والشعار          -->
            <!-- ══════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="16" Margin="0,0,0,24" Padding="32">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.02" BlurRadius="16" ShadowDepth="4" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="بيانات الشركة والمظهر" FontSize="18" FontWeight="Black" Foreground="#111827" Margin="0,0,0,24"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="اسم الشركة / العنوان العلوي" FontSize="13" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Settings.CompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,16,0"/>

                            <TextBlock Text="نص التذييل" FontSize="13" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Settings.FooterText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="مسار الشعار (Logo Path)" FontSize="13" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Settings.CompanyLogoPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                                <Button Grid.Column="2" Command="{Binding BrowseLogoCommand}" Style="{StaticResource ModernSecondaryButton}" Width="100">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="تصفح" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Text="رابط بوابة المايكروتك (QR Code)" FontSize="13" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Settings.QrBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="#F3F4F6" Margin="0,24"/>

                    <!-- خيارات QR والضغط -->
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding Settings.ShowQrCode}" Content="إضافة QR Code لكل كرت" FontWeight="Bold" Foreground="#374151" Margin="0,0,32,0"/>
                        <CheckBox IsChecked="{Binding Settings.UseTokenForQr}" Content="استخدام Token في رابط QR" FontWeight="Bold" Foreground="#374151" Margin="0,0,32,0"/>
                        <CheckBox IsChecked="{Binding Settings.CompressOutput}" Content="ضغط الصور (لتقليل حجم PDF)" FontWeight="Bold" Foreground="#374151"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════ -->
            <!--  القسم الثالث: اختيار الكروت                  -->
            <!-- ══════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="16" Margin="0,0,0,24">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.02" BlurRadius="16" ShadowDepth="4" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="32,32,32,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="اختيار الكروت المراد طباعتها" FontSize="18" FontWeight="Black" Foreground="#111827" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding LoadPendingCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تحميل غير المطبوعة" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding LoadAllCommand}" Style="{StaticResource ModernSecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B0;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="تحميل الكل" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="32,0,32,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Background="#F9FAFB" Height="40">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE11A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#9CA3AF" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding PrintSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="8,0" Foreground="#111827" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding FilterProfile}" Style="{StaticResource ModernComboBox}"/>

                        <Border Grid.Column="4" Background="#F3F4F6" CornerRadius="8" Padding="16,0" Height="40">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="محدد: " FontSize="13" FontWeight="Bold" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding PrintVouchers.Count}" FontSize="14" FontWeight="Black" Foreground="#8B5CF6"/>
                                <TextBlock Text=" كرت" FontSize="13" FontWeight="Bold" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Height="1" Background="#F3F4F6"/>

                    <!-- Enterprise DataGrid for Preview -->
                    <DataGrid Grid.Row="3" ItemsSource="{Binding PrintVouchersView}" AutoGenerateColumns="False" IsReadOnly="True" 
                              BorderThickness="0" Background="Transparent" RowBackground="#FFFFFF"
                              AlternatingRowBackground="#FAFAFA" RowHeight="48" GridLinesVisibility="None"
                              HeadersVisibility="Column" CanUserResizeRows="False" Margin="0" MaxHeight="400">
                              
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8F6FB"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="32,16"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="SeparatorVisibility" Value="Hidden"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#111827"/>
                                <Setter Property="BorderBrush" Value="#F3F4F6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRow">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <SelectiveScrollingGrid>
                                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </SelectiveScrollingGrid.ColumnDefinitions>
                                                    <SelectiveScrollingGrid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </SelectiveScrollingGrid.RowDefinitions>
                                                    <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                </SelectiveScrollingGrid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F9FAFB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="32,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المستخدم" Binding="{Binding Username}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#111827"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="الباقة" Binding="{Binding Profile}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#4B5563"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="السعر" Binding="{Binding Price, StringFormat='{}{0:N0}'}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Black"/>
                                        <Setter Property="Foreground" Value="#111827"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="المزامنة" Binding="{Binding SyncStatusText}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════ -->
            <!--  أزرار التنفيذ                                -->
            <!-- ══════════════════════════════════════════════ -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="16" Padding="32">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="24" ShadowDepth="4" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#4B5563">
                            <Run Text="جاهز لطباعة "/>
                            <Run Text="{Binding PrintVouchers.Count}" FontWeight="Black" FontSize="18" Foreground="#8B5CF6"/>
                            <Run Text=" كرت بتنسيق "/>
                            <Run Text="{Binding SelectedTemplateCaption}" FontWeight="Bold" Foreground="#111827"/>
                        </TextBlock>
                        <TextBlock Text="{Binding PrintStatusMessage}" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,8,0,0" Visibility="{Binding PrintStatusMessage, Converter={StaticResource StringToBoolConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding PreviewCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,16,0" Padding="24,0" Height="48">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#4B5563"/>
                                <TextBlock Text="معاينة PDF" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding PrintCommand}" Style="{StaticResource ModernPrimaryButton}" Padding="32,0" Height="48">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="طباعة مباشرة" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Loading Overlay -->
            <Grid Grid.RowSpan="4" Background="#CCFFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="48,40">
                    <Border.Effect><DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="24" ShadowDepth="4"/></Border.Effect>
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Width="160" Height="4" Foreground="#8B5CF6" Background="#F3F4F6" BorderThickness="0" Margin="0,0,0,24"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="15" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
