<Window x:Class="MikroTikVoucherPrinter.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="لوكس كارد — تسجيل الدخول"
        Height="720" Width="980"
        MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="Tajawal, Segoe UI, sans-serif">
    <Border CornerRadius="20" ClipToBounds="True">
        <!-- Deep dark gradient background -->
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#090914" Offset="0"/>
                <GradientStop Color="#1A0F2E" Offset="0.5"/>
                <GradientStop Color="#0A192F" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Ambient orbs -->
            <Ellipse Width="600" Height="600" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-200,-200,0" Opacity="0.35" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4A00E0" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-200,0,0,-200" Opacity="0.35" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00D4FF" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Two-column layout: Form | Branding -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58*"/>  <!-- Login Form -->
                    <ColumnDefinition Width="42*"/>  <!-- Branding  -->
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════ -->
                <!--        RIGHT COLUMN: Branding Panel    -->
                <!-- ═══════════════════════════════════════ -->
                <Border Grid.Column="1" CornerRadius="0,20,20,0"
                        Background="{StaticResource GlassBackground}"
                        BorderBrush="{StaticResource GlassBorder}"
                        BorderThickness="1,0,0,0" ClipToBounds="True">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                        <!-- Logo -->
                        <Border Width="96" Height="96" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00D4FF" Offset="0"/>
                                    <GradientStop Color="#6C63FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#00D4FF" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="46"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="لوكس كارد" FontSize="40" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Enterprise Voucher System" FontSize="15"
                                   Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,36"/>

                        <!-- Feature list -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Border Width="40" Height="40" CornerRadius="10" Background="#1AFFFFFF"
                                        BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,14,0">
                                    <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource ElectricBlue}" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="مزامنة فورية مع المايكروتك"
                                           Foreground="#E2E8F0" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Border Width="40" Height="40" CornerRadius="10" Background="#1AFFFFFF"
                                        BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,14,0">
                                    <TextBlock Text="&#xE8D3;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource ElectricBlue}" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="إدارة الباقات والوكلاء"
                                           Foreground="#E2E8F0" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="#1AFFFFFF"
                                        BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,14,0">
                                    <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource ElectricBlue}" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="طباعة عالية الدقة والسرعة"
                                           Foreground="#E2E8F0" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════ -->
                <!--        LEFT COLUMN: Login Form         -->
                <!-- ═══════════════════════════════════════ -->
                <Border Grid.Column="0" Background="#1A000000" CornerRadius="20,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>  <!-- Title bar -->
                            <RowDefinition Height="*"/>   <!-- Form content -->
                            <RowDefinition Height="4"/>   <!-- Progress bar -->
                        </Grid.RowDefinitions>

                        <!-- Window Controls -->
                        <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32"
                                        FontSize="12" Style="{StaticResource IconButtonStyle}"
                                        Click="CloseButton_Click" ToolTip="إغلاق"/>
                                <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32"
                                        FontSize="12" Style="{StaticResource IconButtonStyle}"
                                        Click="MinimizeButton_Click" ToolTip="تصغير"/>
                            </StackPanel>
                        </Grid>

                        <!-- Scrollable Form -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid Margin="56,16,56,32">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>   <!-- Heading -->
                                    <RowDefinition Height="Auto"/>   <!-- Fields  -->
                                    <RowDefinition Height="*"/>      <!-- Tabs    -->
                                </Grid.RowDefinitions>

                                <!-- Heading -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                    <TextBlock Text="تسجيل الدخول" FontSize="34" FontWeight="Bold"
                                               Foreground="White" Margin="0,0,0,6"/>
                                    <TextBlock Text="أدخل بيانات الاتصال بجهاز المايكروتك"
                                               FontSize="14" Foreground="#94A3B8"/>
                                </StackPanel>

                                <!-- Input Fields -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                                    <!-- IP & Port -->
                                    <Grid Margin="0,0,0,20" FlowDirection="LeftToRight">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBox x:Name="HostBox"
                                                     Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource GlassTextBoxStyle}"/>
                                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=HostBox, Path=IsFocused}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ElectricBlue}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <TextBox x:Name="PortBox"
                                                     Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource GlassTextBoxStyle}"/>
                                            <TextBlock Text="&#xE928;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=PortBox, Path=IsFocused}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ElectricBlue}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>

                                    <!-- Username -->
                                    <Grid Margin="0,0,0,20" FlowDirection="LeftToRight">
                                        <TextBox x:Name="UsernameBox"
                                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource GlassTextBoxStyle}"/>
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=UsernameBox, Path=IsFocused}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ElectricBlue}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Password -->
                                    <Grid Margin="0,0,0,20" FlowDirection="LeftToRight">
                                        <PasswordBox x:Name="PasswordBox"
                                                     Style="{StaticResource GlassPasswordBoxStyle}"
                                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=PasswordBox, Path=IsFocused}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ElectricBlue}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Save Device Button -->
                                    <Button Command="{Binding SaveDeviceCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            Foreground="{StaticResource ElectricBlue}"
                                            HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal" Margin="6,4">
                                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="حفظ بيانات الجهاز الحالي" FontSize="13"
                                                       FontFamily="Tajawal, Segoe UI" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Login Button -->
                                    <Button Command="{Binding LoginCommand}"
                                            Style="{StaticResource GradientButtonStyle}"
                                            IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBoolConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="تسجيل الدخول" FontSize="17" Margin="0,0,10,0"/>
                                            <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="17" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Status / Error -->
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                                               FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"
                                               FlowDirection="RightToLeft"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"/>

                                    <Border Background="#2AF85149" BorderBrush="#88F85149" BorderThickness="1"
                                            CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5"
                                                   FontSize="13" TextWrapping="Wrap" FlowDirection="RightToLeft"/>
                                    </Border>
                                </StackPanel>

                                <!-- Devices Tabs -->
                                <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                                    <TabControl.Resources>
                                        <Style TargetType="TabItem">
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Setter Property="FontFamily" Value="Tajawal, Segoe UI"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TabItem">
                                                        <Border Name="Border" Padding="12,6" Margin="0,0,6,0"
                                                                CornerRadius="8" Background="Transparent" Cursor="Hand">
                                                            <ContentPresenter x:Name="ContentSite"
                                                                              VerticalAlignment="Center"
                                                                              HorizontalAlignment="Center"
                                                                              ContentSource="Header"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="#33FFFFFF"/>
                                                                <Setter Property="Foreground" Value="{StaticResource ElectricBlue}"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                                    <Condition Property="IsSelected" Value="False"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="Border" Property="Background" Value="#1AFFFFFF"/>
                                                                <Setter Property="Foreground" Value="#E2E8F0"/>
                                                            </MultiTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TabControl.Resources>

                                    <!-- Discovered Devices -->
                                    <TabItem Header="الأجهزة المكتشفة">
                                        <Grid Margin="0,8,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0" Command="{Binding DiscoverNetworkCommand}"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    HorizontalAlignment="Right" Width="36" Height="36"
                                                    Margin="0,0,0,8" ToolTip="بحث عن الأجهزة">
                                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="17" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDiscovering}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.4"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Border Grid.Row="1" Background="{StaticResource GlassBackground}"
                                                    BorderBrush="{StaticResource GlassBorder}"
                                                    CornerRadius="10" BorderThickness="1" Padding="4">
                                                <DataGrid ItemsSource="{Binding DiscoveredDevices}"
                                                          SelectedItem="{Binding SelectedDevice}"
                                                          Style="{StaticResource GlassDataGridStyle}"
                                                          MinHeight="100">
                                                    <DataGrid.ColumnHeaderStyle>
                                                        <Style TargetType="DataGridColumnHeader">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                            <Setter Property="FontSize" Value="12"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Padding" Value="12,8"/>
                                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
                                                        </Style>
                                                    </DataGrid.ColumnHeaderStyle>
                                                    <DataGrid.RowStyle>
                                                        <Style TargetType="DataGridRow">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#E2E8F0"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="#2200D4FF"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.RowStyle>
                                                    <DataGrid.CellStyle>
                                                        <Style TargetType="DataGridCell">
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Padding" Value="12,0"/>
                                                        </Style>
                                                    </DataGrid.CellStyle>
                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Width="44">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="28" Height="28" CornerRadius="8" Background="#1A00D4FF">
                                                                        <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="14" Foreground="{StaticResource ElectricBlue}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="عنوان IP" Binding="{Binding IpAddress}" Width="1.5*"/>
                                                        <DataGridTextColumn Header="الهوية"   Binding="{Binding Identity}"   Width="1.5*"/>
                                                        <DataGridTextColumn Header="الإصدار"  Binding="{Binding Version}"    Width="1.2*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Border>
                                        </Grid>
                                    </TabItem>

                                    <!-- Saved Devices -->
                                    <TabItem Header="الأجهزة المحفوظة">
                                        <Border Margin="0,8,0,0" Background="{StaticResource GlassBackground}"
                                                BorderBrush="{StaticResource GlassBorder}"
                                                CornerRadius="10" BorderThickness="1" Padding="4">
                                            <DataGrid ItemsSource="{Binding SavedDevices}"
                                                      SelectedItem="{Binding SelectedSavedDevice}"
                                                      Style="{StaticResource GlassDataGridStyle}"
                                                      MinHeight="100">
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Padding" Value="12,8"/>
                                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
                                                    </Style>
                                                </DataGrid.ColumnHeaderStyle>
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="#E2E8F0"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="#2200D4FF"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DataGrid.RowStyle>
                                                <DataGrid.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Padding" Value="12,0"/>
                                                    </Style>
                                                </DataGrid.CellStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Width="44">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Width="28" Height="28" CornerRadius="8" Background="#1A00D4FF">
                                                                    <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="14" Foreground="{StaticResource ElectricBlue}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="عنوان IP"   Binding="{Binding IpAddress}" Width="1.5*"/>
                                                    <DataGridTextColumn Header="المستخدم"   Binding="{Binding Username}"  Width="1.5*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </TabItem>
                                </TabControl>

                            </Grid>
                        </ScrollViewer>

                        <!-- Neon Progress Bar -->
                        <ProgressBar Grid.Row="2" Height="4" IsIndeterminate="True"
                                     Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisConverter}}"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{StaticResource ElectricBlue}">
                            <ProgressBar.Effect>
                                <DropShadowEffect Color="#00D4FF" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                            </ProgressBar.Effect>
                        </ProgressBar>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
