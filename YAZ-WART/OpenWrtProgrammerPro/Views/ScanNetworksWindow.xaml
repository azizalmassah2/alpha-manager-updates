<Window x:Class="OpenWrtProgrammerPro.Views.ScanNetworksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الشبكات اللاسلكية المكتشفة" 
        Height="500" Width="800"
        Background="#f6f8fa" Foreground="#24292f"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="بحث عن شبكة SSID:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#57606a"/>
            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                      Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" 
                      Height="32" Padding="5" VerticalContentAlignment="Center" FontSize="14"/>
        </Grid>

        <!-- Networks Grid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                  Background="#ffffff" BorderBrush="#d0d7de" RowBackground="#ffffff" AlternatingRowBackground="#f6f8fa"
                  Foreground="#24292f" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#e1e4e8"
                  HeadersVisibility="Column" MouseDoubleClick="DataGrid_MouseDoubleClick">
            
            <DataGrid.Resources>
                <!-- Column Header Style -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#f6f8fa"/>
                    <Setter Property="Foreground" Value="#24292f"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderBrush" Value="#d0d7de"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
                
                <!-- Cell Style -->
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#0969da"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="SSID" Binding="{Binding Ssid}" Width="2*" />
                <DataGridTextColumn Header="قوة الإشارة" Binding="{Binding SignalPercentText}" Width="*" SortMemberPath="SignalStrength"/>
                <DataGridTextColumn Header="القناة" Binding="{Binding Channel}" Width="0.8*"/>
                <DataGridTextColumn Header="التردد (GHz)" Binding="{Binding Frequency}" Width="*" />
                <DataGridTextColumn Header="التشفير" Binding="{Binding EncryptionType}" Width="1.5*"/>
                <DataGridTextColumn Header="BSSID" Binding="{Binding Bssid}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="انقر نقراً مزدوجاً على شبكة لاختيارها، أو حددها واضغط على زر موافق." 
                        Foreground="#57606a" VerticalAlignment="Center" FontSize="12"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="موافق" Click="Select_Click" 
                        Background="#00b4d8" Foreground="White" Width="100" Height="35" Margin="0,0,10,0"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <Button Content="إلغاء" Click="Cancel_Click" 
                        Background="#f6f8fa" Foreground="#24292f" BorderBrush="#d0d7de" BorderThickness="1" Width="100" Height="35"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
