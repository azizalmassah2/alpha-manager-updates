<Window x:Class="OpenWrtProgrammerPro.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:OpenWrtProgrammerPro.Helpers"
        Title="إعدادات الشبكة وملفات التعريف" 
        Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#f6f8fa" Foreground="#24292f"
        FlowDirection="RightToLeft"
        DataContextChanged="Window_DataContextChanged">

    <Window.Resources>
        <!-- Card border styling -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#d0d7de"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- Base Label Style -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#24292f"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0077b6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/> <!-- Right Column: Base Settings -->
                <ColumnDefinition Width="1*"/>   <!-- Left Column: Upstream Profiles -->
            </Grid.ColumnDefinitions>

            <!-- ================= RIGHT COLUMN: BASE NETWORK SETTINGS ================= -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="إعدادات الشبكة الأساسية (تُعدل مرة واحدة)" Style="{StaticResource SectionHeader}"/>

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,10,0">
                                <Label Content="بادئة الشبكة (Network Prefix):"/>
                                <TextBox Text="{Binding NetworkPrefix, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <Label Content="أقل رقم مودم مسموح به (Start):"/>
                                <TextBox Text="{Binding StartingModemNumber, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,10,0">
                                <Label Content="عنوان البوابة (Gateway IP):"/>
                                <TextBox Text="{Binding BaseGateway, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <Label Content="قناع الشبكة (Subnet Mask):"/>
                                <TextBox Text="{Binding BaseSubnet, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,10,0">
                                <Label Content="بادئة اسم المضيف (Prefix):"/>
                                <TextBox Text="{Binding HostnamePrefix, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <Label Content="حالة تشفير الواي فاي:"/>
                                <CheckBox Content="تفعيل تشفير الـ WiFi" IsChecked="{Binding IsWifiEncrypted}" Foreground="#24292f" Margin="0,8,0,0"/>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,10,0">
                                <Label Content="اسم شبكة 2.4GHz الأساسي:"/>
                                <TextBox Text="{Binding BaseSsid24G, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <Label Content="اسم شبكة 5GHz الأساسي:"/>
                                <TextBox Text="{Binding BaseSsid5G, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Margin="0,0,0,10">
                            <Label Content="كلمة مرور الواي فاي الأساسية:"/>
                            <TextBox Text="{Binding WifiPassword, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsWifiEncrypted}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <Separator Background="#d0d7de" Margin="0,10,0,10"/>
                        <TextBlock Text="إعدادات كلمة المرور النهائية" Style="{StaticResource SectionHeader}"/>

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <CheckBox Content="تغيير كلمة المرور بعد البرمجة" IsChecked="{Binding ChangePasswordAfterProgramming}" Foreground="#24292f" Margin="0,5,0,0" VerticalAlignment="Center"/>
                            <CheckBox Content="جرب كلمة مرور الشبكة أولاً" IsChecked="{Binding TryNetworkPasswordFirst}" Foreground="#24292f" Margin="0,5,0,0" VerticalAlignment="Center"/>
                        </UniformGrid>

                        <GroupBox Header="بيانات الدخول الحالية للمودم" BorderBrush="#d0d7de" Foreground="#24292f" Margin="0,0,0,10" Padding="8">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,5,0">
                                    <Label Content="اسم المستخدم الحالي:"/>
                                    <TextBox Text="{Binding ConnectUsername, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="5,0,0,0">
                                    <Label Content="كلمة المرور الحالية:"/>
                                    <PasswordBox helpers:PasswordHelper.Attach="True" helpers:PasswordHelper.Password="{Binding ConnectPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                        </GroupBox>

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,5,0">
                                <Label Content="كلمة المرور الموحدة للشبكة:"/>
                                <PasswordBox helpers:PasswordHelper.Attach="True" helpers:PasswordHelper.Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="5,0,0,0">
                                <Label Content="تأكيد كلمة المرور الموحدة:"/>
                                <PasswordBox helpers:PasswordHelper.Attach="True" helpers:PasswordHelper.Password="{Binding ConfirmNewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ================= LEFT COLUMN: UPSTREAM NETWORK PROFILES ================= -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ملفات تعريف الشبكات البعيدة (Upstream)" Style="{StaticResource SectionHeader}"/>

                    <!-- List of saved networks -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding SavedNetworks}" SelectedItem="{Binding SelectedSavedNetwork}" DisplayMemberPath="ProfileName"
                             Background="#ffffff" BorderBrush="#d0d7de" Foreground="#24292f" Margin="0,0,0,10"/>

                    <!-- Details and controls for network profile -->
                    <StackPanel Grid.Row="2" Margin="0,5,0,0">
                        <UniformGrid Columns="2" Margin="0,0,0,5">
                            <StackPanel Margin="0,0,5,0">
                                <Label Content="اسم الملف:" FontSize="11"/>
                                <TextBox Text="{Binding ProfileNameInput, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="28" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="5,0,0,0">
                                <Label Content="اسم الشبكة SSID:" FontSize="11"/>
                                <TextBox Text="{Binding RemoteSsidInput, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="28" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,5,0">
                                <Label Content="كلمة المرور:" FontSize="11"/>
                                <TextBox Text="{Binding RemotePasswordInput, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="28" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="5,0,0,0">
                                <Label Content="ملاحظات:" FontSize="11"/>
                                <TextBox Text="{Binding NotesInput, UpdateSourceTrigger=PropertyChanged}" Background="#ffffff" Foreground="#24292f" BorderBrush="#d0d7de" Height="28" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="3">
                            <Button Content="➕ حفظ / تعديل" Command="{Binding SaveProfileCommand}" Background="#06d6a0" Foreground="White" FontWeight="Bold" Height="30" Margin="0,0,3,0" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                            <Button Content="🗑️ حذف" Command="{Binding DeleteProfileCommand}" Background="#ef476f" Foreground="White" FontWeight="Bold" Height="30" Margin="3,0,3,0" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                            <Button Content="🆕 جديد" Command="{Binding NewProfileCommand}" Background="#f6f8fa" Foreground="#24292f" BorderBrush="#d0d7de" BorderThickness="1" Height="30" Margin="3,0,0,0" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Save / Cancel Buttons at the bottom -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="💾 حفظ الإعدادات" Command="{Binding SaveSettingsCommand}" Background="#00b4d8" Foreground="White" FontWeight="Bold" Width="140" Height="35" Margin="0,0,10,0" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Background="#f6f8fa" Foreground="#24292f" BorderBrush="#d0d7de" BorderThickness="1" Width="100" Height="35" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
