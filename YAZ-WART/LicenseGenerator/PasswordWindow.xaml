<Window x:Class="LicenseGenerator.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="أمان مولد التراخيص" 
        Height="300" Width="480"
        Background="#f6f8fa" Foreground="#24292f"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#d0d7de" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="نظام أمان مولد التراخيص (المطور)" FontSize="16" FontWeight="Bold" Foreground="#cf222e"/>
                <TextBlock Text="يرجى إدخال كلمة المرور الرئيسية لفك تشفير المفتاح الخاص RSA." FontSize="11" Foreground="#57606a" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Input -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Label Content="كلمة المرور الرئيسية (Master Password):" FontWeight="Bold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtPassword" Height="32" Padding="5" VerticalContentAlignment="Center" BorderBrush="#d0d7de"/>

            <StackPanel Margin="0,15,0,0">
                <TextBlock Text="بصمة جهاز المطور الحالية:" FontSize="10" Foreground="#57606a"/>
                <TextBlock x:Name="TxtHwid" FontSize="10" FontWeight="Bold" Foreground="#24292f" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="🔐 تحقق ودخول" Click="Verify_Click" IsDefault="True" Background="#0969da" Foreground="White" FontWeight="Bold" Height="35" Margin="0,0,10,0" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
            </Button>
            
            <Button Grid.Column="1" Content="إلغاء وإغلاق" Click="Cancel_Click" IsCancel="True" Background="#f6f8fa" Foreground="#24292f" BorderBrush="#d0d7de" BorderThickness="1" Height="35" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
