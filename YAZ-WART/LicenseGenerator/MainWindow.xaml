<Window x:Class="LicenseGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="منصة المطور - توليد تراخيص لوكس كارد" 
        Height="620" Width="850"
        Background="#f6f8fa" Foreground="#24292f"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#d0d7de" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="منظومة توليد التراخيص وتتبع العملاء" FontSize="20" FontWeight="Bold" Foreground="#cf222e"/>
                    <TextBlock Text="أداة سرية خاصة بالمالك فقط لإنشاء تراخيص RSA-4096 مشفرة للمستخدمين." FontSize="11" Foreground="#57606a" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#e1e4e8" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock Text="وضع مفتاح المطور نشط 🔒" FontSize="11" FontWeight="Bold" Foreground="#24292f"/>
                </Border>
            </Grid>
        </Border>

        <!-- Form body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Client Info & IDs -->
            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="بيانات العميل والترخيص" FontSize="14" FontWeight="Bold" Foreground="#0077b6" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="📂 استيراد طلب (.txt)" Click="ImportRequest_Click" Background="#ffffff" Foreground="#0969da" BorderBrush="#d0d7de" BorderThickness="1" Padding="8,3" Height="28" FontSize="11" FontWeight="Bold" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </Grid>

                <Label Content="اسم العميل (Customer Name):" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtCustomerName" Height="32" Padding="5" VerticalContentAlignment="Center" Background="#ffffff" BorderBrush="#d0d7de" Margin="0,0,0,15"/>

                <Label Content="بصمة جهاز العميل (Hardware ID):" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtHardwareId" Height="32" Padding="5" VerticalContentAlignment="Center" Background="#ffffff" BorderBrush="#d0d7de" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>

                <UniformGrid Columns="2" Margin="0,0,0,15">
                    <StackPanel Margin="0,0,10,0">
                        <Label Content="رقم الترخيص (License ID):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtLicenseId" Height="32" Padding="5" VerticalContentAlignment="Center" Background="#ffffff" BorderBrush="#d0d7de"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="نوع الترخيص:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CbLicenseType" Height="32" VerticalContentAlignment="Center" SelectionChanged="CbLicenseType_SelectionChanged" Background="#ffffff" BorderBrush="#d0d7de">
                            <ComboBoxItem Content="تجريبي (Trial)"/>
                            <ComboBoxItem Content="شهري (Monthly)"/>
                            <ComboBoxItem Content="سنوي (Yearly)"/>
                            <ComboBoxItem Content="مدى الحياة (Lifetime)"/>
                            <ComboBoxItem Content="مخصص (Custom)"/>
                        </ComboBox>
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,10,0">
                        <Label Content="إصدار الترخيص (Version):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtVersion" Text="1" Height="32" Padding="5" VerticalContentAlignment="Center" Background="#ffffff" BorderBrush="#d0d7de"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="إصدار المفتاح (Key Version):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtKeyVersion" Text="1" Height="32" Padding="5" VerticalContentAlignment="Center" Background="#ffffff" BorderBrush="#d0d7de"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>

            <!-- Column 2: Parameters & Expiry -->
            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                <TextBlock Text="شروط الصلاحية والخصائص" FontSize="14" FontWeight="Bold" Foreground="#0077b6" Margin="0,0,0,15"/>

                <UniformGrid Columns="2" Margin="0,0,0,15">
                    <StackPanel Margin="0,0,10,0">
                        <Label Content="تاريخ انتهاء الصلاحية:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DpExpiryDate" Height="32" VerticalContentAlignment="Center" Background="#ffffff" BorderBrush="#d0d7de"/>
                    </StackPanel>
                    <StackPanel>
                        <Label Content="فترة السماح (أيام):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtGracePeriod" Text="7" Height="32" Padding="5" VerticalContentAlignment="Center" Background="#ffffff" BorderBrush="#d0d7de"/>
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,0,0,15">
                    <StackPanel Margin="0,0,10,0">
                        <Label Content="أيام العمل أوفلاين (Offline Days):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtOfflineDays" Text="30" Height="32" Padding="5" VerticalContentAlignment="Center" Background="#ffffff" BorderBrush="#d0d7de"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,5">
                        <CheckBox x:Name="ChkRevoked" Content="الترخيص ملغى (Revoked)" Foreground="#cf222e" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </UniformGrid>

                <Label Content="ملاحظات الترخيص:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtNotes" Height="50" Padding="5" VerticalContentAlignment="Top" TextWrapping="Wrap" Background="#ffffff" BorderBrush="#d0d7de" Margin="0,0,0,15"/>

                <GroupBox Header="الميزات المتاحة بالترخيص (Features)" BorderBrush="#d0d7de" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkFeatureBatch" Content="البرمجة الجماعية" Margin="0,0,20,0" FontWeight="Bold"/>
                        <CheckBox x:Name="ChkFeatureLogs" Content="السجلات المتقدمة" Margin="0,0,20,0" FontWeight="Bold"/>
                        <CheckBox x:Name="ChkFeatureMulti" Content="متعدد الأجهزة" FontWeight="Bold"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <!-- Actions -->
        <Border Grid.Row="2" BorderBrush="#d0d7de" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,15,0,0">
            <Button Content="💾 إنشاء وتوقيع ملف الترخيص (Generate license.dat)" Click="Generate_Click" Background="#cf222e" Foreground="White" FontWeight="Bold" FontSize="16" Height="45" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Border>
    </Grid>
</Window>
